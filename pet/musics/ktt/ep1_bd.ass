Dialogue: 0,0:00:06.08,0:00:09.22,DVC,Dụ,0,0,0,,Dụ Văn Châu: Quân huy của công viên tưởng niệm khu G chính xác là sản phẩm thử.
Dialogue: 0,0:00:10.89,0:00:13.15,DVC,Dụ,0,0,0,,Ừm, đúng, thiết kế có chủ đích đó.
Dialogue: 0,0:00:15.74,0:00:17.29,DVC,Dụ,0,0,0,,Đây là đề xuất của riêng tôi,
Dialogue: 0,0:00:17.29,0:00:18.91,DVC,Dụ,0,0,0,,chứ không phải quy định của Liên minh,
Dialogue: 0,0:00:19.36,0:00:21.12,DVC,Dụ,0,0,0,,không nhất định phải thi hành theo.
Dialogue: 0,0:00:21.96,0:00:26.56,DVC,Dụ,0,0,0,,Tôi muốn dùng trạng thái chưa hoàn thiện này để thể hiện rằng đội ngũ này luôn được mài dũa và tinh luyện,
Dialogue: 0,0:00:26.56,0:00:28.56,DVC,Dụ,0,0,0,,sẽ có người kế thừa.
Dialogue: 0,0:00:29.53,0:00:32.60,DVC,Dụ,0,0,0,,Có thể, nhưng cũng cần phải suy xét đến nguyện vọng của người dân địa phương.
Dialogue: 0,0:00:33.38,0:00:34.30,DVC,Dụ,0,0,0,,Thượng tướng Vương.
Dialogue: 0,0:00:35.38,0:00:36.15,DVC,Dụ,0,0,0,,Thật trùng hợp.
Dialogue: 0,0:00:36.15,0:00:37.83,DVC,Dụ,0,0,0,,Không để ý tôi ngồi ở chỗ này chứ?
Dialogue: 0,0:00:37.83,0:00:39.23,VKH,Vương,0,0,0,,Vương Kiệt Hi: Tất nhiên rồi, mời ngồi.
Dialogue: 0,0:00:41.55,0:00:45.22,DVC,Dụ,0,0,0,,Ừ, đúng, tiến độ xây dựng của khu C\Nvẫn được báo cáo hàng tháng.
Dialogue: 0,0:00:46.08,0:00:49.94,DVC,Dụ,0,0,0,,Số liệu khác thường của tiểu đoàn 47 cũng đã được theo dõi rồi, đang chờ phản hồi.
Dialogue: 0,0:00:50.07,0:00:52.19,DVC,Dụ,0,0,0,,Gửi báo cáo tái thiết\Nhậu chiến cho tôi đi.
Dialogue: 0,0:00:52.19,0:00:53.78,DVC,Dụ,0,0,0,,Bây giờ tôi dành chút\Nthời gian rảnh xem thử.
Dialogue: 0,0:00:54.34,0:00:56.38,DVC,Dụ,0,0,0,,Ừ, lát nữa tôi sẽ liên lạc sau.
Dialogue: 0,0:00:57.25,0:00:59.68,VKH,Vương,0,0,0,,Tổng cố vấn Dụ đúng là\Ntrăm công ngàn việc nhỉ?
Dialogue: 0,0:00:59.68,0:01:00.78,DVC,Dụ,0,0,0,,Ha ha ha.
Dialogue: 0,0:01:01.14,0:01:03.69,DVC,Dụ,0,0,0,,Thì số phận vất vả vậy thôi,
Dialogue: 0,0:01:03.69,0:01:04.86,DVC,Dụ,0,0,0,,không còn cách nào khác.
Dialogue: 0,0:01:15.18,0:01:17.55,VKH,Vương OS,0,0,0,,[Giấy báo ủy nhiệm se duyên...]
Dialogue: 0,0:01:17.92,0:01:20.40,VKH,Vương OS,0,0,0,,[Đến nhanh như vậy à...]
Dialogue: 0,0:01:20.40,0:01:22.62,Default,Hệ thống,0,0,0,,Ngài Vương Kiệt Hi tôn kính,
Dialogue: 0,0:01:23.03,0:01:27.93,Default,Hệ thống,0,0,0,,dựa trên nhu cầu tìm dẫn đường trị liệu hội chứng dần mất đi năm giác quan của ngài,
Dialogue: 0,0:01:28.02,0:01:31.50,Default,Hệ thống,0,0,0,,hiện tại quyền hạn kết hợp\Nlính gác cấp S đã được mở
Dialogue: 0,0:01:31.50,0:01:34.38,Default,Hệ thống,0,0,0,,và tiến hành phối hợp se duyên.
Dialogue: 0,0:01:34.43,0:01:36.24,Default,Hệ thống,0,0,0,,Đối tượng kết duyên: Dụ Văn Châu
Dialogue: 0,0:01:36.24,0:01:37.88,Default,Hệ thống,0,0,0,,Trân trọng thông báo.
Dialogue: 0,0:01:38.71,0:01:40.60,Default,Hệ thống,0,0,0,,Ủy ban ra quyết định: Liên minh Vinh Quang
Dialogue: 0,0:01:40.78,0:01:45.78,Default,Hệ thống,0,0,0,,Tháng 3, năm đầu tiên của Liên minh
Dialogue: 0,0:01:45.96,0:01:46.90,VKH,Vương OS,0,0,0,,[Này...]
Dialogue: 0,0:01:48.36,0:01:49.70,VKH,Vương OS,0,0,0,,[Cậu ấy cũng nhận được rồi sao?]
Dialogue: 0,0:01:53.12,0:01:54.72,VKH,Vương OS,0,0,0,,[Thế mà nét mặt lại không thay đổi gì hết.]
Dialogue: 0,0:01:58.68,0:02:02.18,DVC,Dụ,0,0,0,,Vừa nãy bận quá, vẫn chưa\Nhỏi thăm anh gần đây thế nào?
Dialogue: 0,0:02:03.48,0:02:04.34,VKH,Vương,0,0,0,,Khỏe lắm.
Dialogue: 0,0:02:05.42,0:02:07.76,VKH,Vương,0,0,0,,Nhàn rỗi ở nhà không phải\Nlo cơm ăn áo mặc.
Dialogue: 0,0:02:08.38,0:02:12.40,VKH,Vương,0,0,0,,Ầy, đằng này Liên minh chẳng ngoảnh lại đã sắp xếp cả đối tượng cho tôi luôn rồi.
Dialogue: 0,0:02:12.40,0:02:13.82,VKH,Vương,0,0,0,,Có thể không tốt được sao?
Dialogue: 0,0:02:14.44,0:02:16.66,DVC,Dụ,0,0,0,,Anh biết là không phải tôi\Nmuốn hỏi cái này mà.
Dialogue: 0,0:02:16.68,0:02:19.00,DVC,Dụ,0,0,0,,Tôi... tôi muốn hỏi...
Dialogue: 0,0:02:19.13,0:02:20.98,VKH,Vương,0,0,0,,Hỏi về tình trạng sức khỏe của tôi sao?
Dialogue: 0,0:02:22.38,0:02:24.70,VKH,Vương,0,0,0,,Điều này hẳn cậu nên\Nrõ ràng nhất phải không?
Dialogue: 0,0:02:25.60,0:02:28.26,VKH,Vương,0,0,0,,Trên văn kiện phê duyệt\Ntước quyền nghị sự của tôi,
Dialogue: 0,0:02:28.26,0:02:30.22,VKH,Vương,0,0,0,,còn có chữ kí của ngài đó.
Dialogue: 0,0:02:30.50,0:02:33.14,VKH,Vương,0,0,0,,Cũng không phải đấy là vì\Nchèn ép Vi Thảo chúng tôi chứ?
Dialogue: 0,0:02:33.14,0:02:34.52,DVC,Dụ,0,0,0,,Ha ha ha.
Dialogue: 0,0:02:34.52,0:02:36.77,DVC,Dụ,0,0,0,,Thượng tướng Vương có\Nlòng tin với tôi như vậy à,
Dialogue: 0,0:02:37.08,0:02:39.70,DVC,Dụ,0,0,0,,nói không chừng tôi chính là\Nvì đánh bại Vi Thảo đấy?
Dialogue: 0,0:02:39.96,0:02:42.75,DVC,Dụ,0,0,0,,Kể ra thì tôi cũng rất bất ngờ,
Dialogue: 0,0:02:42.75,0:02:45.00,DVC,Dụ,0,0,0,,thế mà cuối cùng tôi lại\Ncạnh tranh thăng chức.
Dialogue: 0,0:02:47.44,0:02:52.45,DVC,Dụ,0,0,0,,Thời chiến, vì tranh công mà Vi Thảo\Nvà Lam Vũ không nhường lấy một tấc đất,
Dialogue: 0,0:02:52.90,0:02:54.88,DVC,Dụ,0,0,0,,không ngờ rằng khi\Nmùi thuốc súng tan đi,
Dialogue: 0,0:02:54.88,0:02:58.00,DVC,Dụ,0,0,0,,tôi lại nhận được chiếc\Nhuân chương lớn là ngài.
Dialogue: 0,0:02:58.58,0:03:00.25,VKH,Vương,0,0,0,,Nếu như cậu không bằng lòng,
Dialogue: 0,0:03:00.72,0:03:02.48,VKH,Vương,0,0,0,,tôi có thể xin đổi.
Dialogue: 0,0:03:02.88,0:03:04.23,DVC,Dụ,0,0,0,,Không cần đâu.
Dialogue: 0,0:03:04.38,0:03:07.48,DVC,Dụ,0,0,0,,Chấp hành mệnh lệnh là\Nnghĩa vụ của quân nhân mà.
Dialogue: 0,0:03:08.17,0:03:10.18,DVC,Dụ,0,0,0,,Thượng tướng Vương không\Ncảm thấy bị thiệt thòi,
Dialogue: 0,0:03:10.18,0:03:11.60,DVC,Dụ,0,0,0,,làm sao tôi lại kén cá chọn canh được?
Dialogue: 0,0:03:15.30,0:03:17.16,VKH,Vương,0,0,0,,Tôi nên nói thế nào đây?
Dialogue: 0,0:03:18.06,0:03:20.78,VKH,Vương,0,0,0,,Cảm ơn tổng tham mưu Dụ\Nchăm sóc trước khi hấp hối?
Dialogue: 0,0:03:20.78,0:03:22.16,DVC,Dụ,0,0,0,,Đừng có nói nhảm.
Dialogue: 0,0:03:22.16,0:03:23.68,DVC,Dụ,0,0,0,,Sẽ không có chuyện đó đâu.
Dialogue: 0,0:03:23.98,0:03:27.56,DVC,Dụ,0,0,0,,Tôi vẫn đang mong chờ anh khỏe lên sau đó hủy bỏ mối quan hệ kết đôi này,
Dialogue: 0,0:03:27.82,0:03:30.10,DVC,Dụ,0,0,0,,để cho tôi trước khi tuổi già đến,
Dialogue: 0,0:03:30.38,0:03:31.24,DVC,Dụ,0,0,0,,tìm được một đối tượng phù hợp,
Dialogue: 0,0:03:31.24,0:03:32.58,DVC,Dụ,0,0,0,,tâm sự về tình yêu tuổi xế chiều,
Dialogue: 0,0:03:32.62,0:03:34.18,DVC,Dụ,0,0,0,,vậy mới xem là cuộc sống đáng giá.
Dialogue: 0,0:03:34.93,0:03:37.40,VKH,Vương,0,0,0,,Giải trừ quan hệ kết hợp\Nphức tạp biết bao,
Dialogue: 0,0:03:37.40,0:03:38.63,VKH,Vương,0,0,0,,tôi chết rồi cậu liền có thể...
Dialogue: 0,0:03:38.63,0:03:40.74,DVC,Dụ,0,0,0,,Thượng tướng Vương hãy cẩn trọng lời nói và hành động của anh.
Dialogue: 0,0:03:43.55,0:03:46.47,VKH,Vương,0,0,0,,Tuy rằng không biết các cấp cao\Nđã suy nghĩ thế nào,
Dialogue: 0,0:03:46.47,0:03:48.48,VKH,Vương,0,0,0,,nhưng mà vẫn là cần phải cảm ơn cậu.
Dialogue: 0,0:03:49.26,0:03:51.25,VKH,Vương,0,0,0,,Đối với tôi mà nói, là cậu,
Dialogue: 0,0:03:52.11,0:03:54.14,VKH,Vương,0,0,0,,tốt hơn nhiều so với việc\Nbị phân cho người khác.
Dialogue: 0,0:03:54.14,0:03:55.78,DVC,Dụ,0,0,0,,Dù sao cũng được chỉ định rồi,
Dialogue: 0,0:03:56.08,0:03:57.38,DVC,Dụ,0,0,0,,tôi cảm thấy rằng anh cũng...
Dialogue: 0,0:03:57.48,0:04:00.26,VKH,Vương,0,0,0,,Thôi không cần phải\Nkhen qua khen lại đâu.
Dialogue: 0,0:04:00.26,0:04:03.16,VKH,Vương,0,0,0,,Tôi sẽ làm theo lời khuyên\Ncủa Hội đồng Y khoa...
Dialogue: 0,0:04:04.28,0:04:06.26,VKH,Vương,0,0,0,,Ừm....
Dialogue: 0,0:04:06.26,0:04:07.42,VKH,Vương,0,0,0,,Chỉ cần cậu đồng ý...
Dialogue: 0,0:04:08.80,0:04:10.24,VKH,Vương,0,0,0,,Lúc làm chuyện gì kia...
Dialogue: 0,0:04:11.30,0:04:12.60,VKH,Vương,0,0,0,,Cậu cũng không cần\Nphải khách sáo đâu.
Dialogue: 0,0:04:13.43,0:04:14.80,DVC,Dụ,0,0,0,,Khách sáo gì chứ?
Dialogue: 0,0:04:15.38,0:04:18.23,DVC,Dụ,0,0,0,,Đôi chân dài của thượng tướng\NVương tiếng tăm lẫy lừng,
Dialogue: 0,0:04:18.23,0:04:20.78,DVC,Dụ,0,0,0,,nhỡ đâu bây giờ nhìn vào\Ntrông tôi điềm tĩnh,
Dialogue: 0,0:04:20.78,0:04:23.12,DVC,Dụ,0,0,0,,thực tế trong lòng\Nvỡ òa hạnh phúc thì sao?
Dialogue: 0,0:04:24.04,0:04:25.05,VKH,Vương,0,0,0,,Ngài thôi đi được rồi đó.
Dialogue: 0,0:04:27.88,0:04:30.85,DVC,Vương,0,0,0,,Lát nữa tôi ăn xong rồi còn\Nphải quay lại Bộ Chỉ huy.
Dialogue: 0,0:04:31.36,0:04:32.98,DVC,Vương,0,0,0,,Còn anh? Chiều nay có làm gì không?
Dialogue: 0,0:04:33.60,0:04:36.16,VKH,Vương,0,0,0,,Tôi thì không có việc gì làm,
Dialogue: 0,0:04:36.16,0:04:38.90,VKH,Vương,0,0,0,,Chỉ... về nhà ngủ.
Dialogue: 0,0:04:38.90,0:04:41.42,VKH,Vương,0,0,0,,Đợi cậu bận việc xong rồi\Nthì hẳn gặp lại đi.
Dialogue: 0,0:04:42.14,0:04:43.73,VKH,Vương,0,0,0,,Bàn bạc một chút về...
Dialogue: 0,0:04:44.35,0:04:46.16,DVC,Dụ,0,0,0,,Hôn nhân đại sự của chúng ta.
Dialogue: 0,0:04:46.16,0:04:48.82,DVC,Dụ,0,0,0,,Yên tâm, sẽ không bạc đãi anh đâu.
Dialogue: 0,0:04:49.04,0:04:52.22,DVC,Dụ,0,0,0,,Việc buổi chiều sẽ không làm\Nlỡ quá nhiều thời gian,
Dialogue: 0,0:04:52.22,0:04:53.33,DVC,Dụ,0,0,0,,chắc là khoảng 3-5 tiếng.
Dialogue: 0,0:04:53.59,0:04:55.95,DVC,Dụ,0,0,0,,Sau khi kết thúc, tôi sẽ\Nchuyển đến chỗ anh?
Dialogue: 0,0:04:56.50,0:04:59.09,DVC,Dụ,0,0,0,,Hay là anh muốn đến chỗ tôi?
Dialogue: 0,0:04:59.09,0:05:00.20,VKH,Vương,0,0,0,,Để tôi qua đó cho.
Dialogue: 0,0:05:00.80,0:05:02.74,VKH,Vương,0,0,0,,Tôi chỉ xin có 1 phòng ngủ thôi.
Dialogue: 0,0:05:02.74,0:05:04.42,VKH,Vương,0,0,0,,Hai người không ở được đâu.
Dialogue: 0,0:05:04.43,0:05:07.90,DVC,Dụ,0,0,0,,Thượng tướng Vương quá là\Ntiết kiệm kinh phí cho Liên minh rồi.
Dialogue: 0,0:05:09.18,0:05:12.56,DVC,Dụ,0,0,0,,Vậy khi nào tôi xong việc\Nsẽ qua giúp anh chuyển đồ.
Dialogue: 0,0:05:13.00,0:05:14.56,VKH,Vương,0,0,0,,Không cần phiền phức vậy đâu.
Dialogue: 0,0:05:14.56,0:05:16.32,VKH,Vương,0,0,0,,Tôi không có bao nhiêu đồ cả,
Dialogue: 0,0:05:16.78,0:05:18.19,VKH,Vương,0,0,0,,ngoài bản thân tôi ra,
Dialogue: 0,0:05:18.19,0:05:21.78,VKH,Vương,0,0,0,,thì chỉ còn một con cá vây xanh lúc trước mua ở chợ chim hoa trời.
Dialogue: 0,0:05:22.88,0:05:24.43,VKH,Vương,0,0,0,,Cậu đưa địa chỉ cho tôi đi,
Dialogue: 0,0:05:24.43,0:05:26.34,VKH,Vương,0,0,0,,tôi tự tới đó là được rồi.
Dialogue: 0,0:05:47.86,0:05:50.25,VKH,Vương,0,0,0,,Tôi đến trước cửa rồi, làm sao để vào?
Dialogue: 0,0:05:52.03,0:05:54.30,DVC,Dụ,0,0,0,,Ghi lại thông tin của anh\Nrồi trực tiếp đi lên.
Dialogue: 0,0:05:54.60,0:05:58.15,VKH,Vương OS,0,0,0,,[Tay nắm quyền hạn\Ntruy xuất thông tin tối cao,]
Dialogue: 0,0:05:58.15,0:06:00.22,VKH,Vương OS,0,0,0,,[thế mà giờ lại dùng để\Nghi ở chỗ gác cổng.]
Dialogue: 0,0:06:00.84,0:06:02.12,VKH,Vương OS,0,0,0,,[Thật là lãng phí.]
Dialogue: 0,0:06:11.24,0:06:13.81,VKH,Vương,0,0,0,,Mày ráng chịu thiệt thòi ở\Ntrong cái bát này một lát,
Dialogue: 0,0:06:13.81,0:06:16.18,VKH,Vương,0,0,0,,ngày mai sẽ đổi cho mày cái bể cá lớn.
Dialogue: 0,0:06:20.66,0:06:24.88,VKH,Vương,0,0,0,,Sao lại có nhiều phòng như vậy chứ,\Nđúng là người có điều kiện.
Dialogue: 0,0:06:26.20,0:06:28.26,VKH,Vương,0,0,0,,Cũng không hỏi tôi là ở\Nchỗ nào thì được...
Dialogue: 0,0:06:29.76,0:06:31.30,VKH,Vương,0,0,0,,Hay là ở phòng này đi...
Dialogue: 0,0:06:39.52,0:06:41.36,VKH,Vương,0,0,0,,Cái giường này thật thoải mái.
Dialogue: 0,0:07:05.40,0:07:06.08,VKH,Vương,0,0,0,,Ai?
Dialogue: 0,0:07:10.10,0:07:10.84,VKH,Vương,0,0,0,,Dụ Văn Châu?
Dialogue: 0,0:07:12.34,0:07:14.28,VKH,Vương,0,0,0,,Nếu đang ở thời chiến,
Dialogue: 0,0:07:14.68,0:07:18.30,VKH,Vương,0,0,0,,giờ cậu đã sớm bay xuyên qua ba lớp tường nhà cậu vào thẳng phòng bếp rồi.
Dialogue: 0,0:07:18.53,0:07:20.42,DVC,Dụ,0,0,0,,Nếu đang ở thời chiến,
Dialogue: 0,0:07:20.42,0:07:23.44,DVC,Dụ,0,0,0,,hiện tại anh đã rơi vào\Ncạm bẫy tinh thần của tôi rồi.
Dialogue: 0,0:07:24.20,0:07:25.36,DVC,Dụ,0,0,0,,Đừng đoán nữa.
Dialogue: 0,0:07:25.60,0:07:28.15,DVC,Dụ,0,0,0,,Tôi đã mở kết giới ở ngay\Nrìa phạm vi cảm nhận của anh
Dialogue: 0,0:07:28.39,0:07:30.01,DVC,Dụ,0,0,0,,dung hợp từng chút một,
Dialogue: 0,0:07:30.24,0:07:31.60,DVC,Dụ,0,0,0,,nước ấm ủ ếch*.
Dialogue: 0,0:07:31.60,0:07:32.98,DVC,Dụ,0,0,0,,Đương nhiên anh không phát hiện ra tôi rồi.
Dialogue: 0,0:07:34.83,0:07:35.72,VKH,Vương,0,0,0,,Oa.
Dialogue: 0,0:07:39.62,0:07:40.96,VKH,Vương,0,0,0,,Tôi đang ở đâu đây?
Dialogue: 0,0:07:40.96,0:07:42.58,DVC,Dụ,0,0,0,,Ở trên giường của tôi,
Dialogue: 0,0:07:43.36,0:07:44.80,DVC,Dụ,0,0,0,,anh chọn chuẩn ghê.
Dialogue: 0,0:07:44.80,0:07:48.22,DVC,Dụ,0,0,0,,Trong bốn phòng ngủ lại tìm ra\Nchính xác phòng tôi thường hay ở.
Dialogue: 0,0:07:48.46,0:07:50.05,DVC,Dụ,0,0,0,,Muốn tôi dọn phòng khác cho anh,
Dialogue: 0,0:07:50.05,0:07:51.73,DVC,Dụ,0,0,0,,hay là anh ở đây,
Dialogue: 0,0:07:51.73,0:07:52.92,DVC,Dụ,0,0,0,,còn tôi cuốn xéo?
Dialogue: 0,0:07:56.38,0:08:00.42,VKH,Vương,0,0,0,,Tôi nghĩ rằng sau khi kết đôi rồi thì chúng ta nên ở chung một giường.
Dialogue: 0,0:08:01.62,0:08:05.48,VKH,Vương,0,0,0,,Tôi đoán là cậu sẽ nhận được báo cáo chẩn đoán của tôi từ Hội đồng Y khoa,
Dialogue: 0,0:08:05.48,0:08:09.48,VKH,Vương,0,0,0,,mặt sau có ghi chi tiết\Nliên quan đến quy trình trị liệu.
Dialogue: 0,0:08:10.06,0:08:11.28,VKH,Vương,0,0,0,,Mỗi tuần lên giường mấy lần?
Dialogue: 0,0:08:12.36,0:08:14.08,VKH,Vương,0,0,0,,Mỗi lần cần làm đến mức nào?
Dialogue: 0,0:08:14.46,0:08:16.84,VKH,Vương,0,0,0,,Khi có sốt kết hợp thì xử lý ra sao?
Dialogue: 0,0:08:17.76,0:08:20.24,VKH,Vương,0,0,0,,Vào kỳ phát bệnh nên điều\Nchỉnh thế nào, này nọ.
Dialogue: 0,0:08:20.24,0:08:22.01,DVC,Dụ,0,0,0,,Đúng là có chuyện này thật.
Dialogue: 0,0:08:22.01,0:08:23.60,DVC,Dụ,0,0,0,,Thậm chí khi tôi vừa lên đường về nhà,
Dialogue: 0,0:08:24.38,0:08:27.70,DVC,Dụ,0,0,0,,còn nhận được bản chú thích\Ndo Phương Sĩ Khiêm gửi,
Dialogue: 0,0:08:27.70,0:08:32.50,DVC,Dụ,0,0,0,,chi tiết đến mức thiếu điều\Nviết rõ ra nên vào từ góc nào luôn.
Dialogue: 0,0:08:33.46,0:08:36.03,DVC,Dụ,0,0,0,,Nhưng mà nếu anh cảm thấy\Nnhư vậy quá bệnh hình thức,
Dialogue: 0,0:08:36.04,0:08:37.50,DVC,Dụ,0,0,0,,tôi cũng có thể...
Dialogue: 0,0:08:37.65,0:08:40.70,VKH,Vương,0,0,0,,Thể hiện tình cảm\Nchân thành hơn một chút?
Dialogue: 0,0:08:41.80,0:08:42.48,VKH,Vương,0,0,0,,Không cần đâu.
Dialogue: 0,0:08:43.10,0:08:45.82,VKH,Vương,0,0,0,,Như vậy ngược lại sẽ khiến\Ntôi cảm thấy kỳ quái,
Dialogue: 0,0:08:45.82,0:08:47.48,VKH,Vương,0,0,0,,cậu diễn cũng rất mệt.
Dialogue: 0,0:08:48.13,0:08:48.73,DVC,Dụ,0,0,0,,Được thôi.
Dialogue: 0,0:08:48.73,0:08:51.25,DVC,Dụ,0,0,0,,Vậy mời anh đứng dậy\Nkhỏi giường của tôi,
Dialogue: 0,0:08:51.25,0:08:52.83,DVC,Dụ,0,0,0,,ba căn phòng còn lại anh cứ tùy ý ở.
Dialogue: 0,0:08:54.36,0:08:56.45,DVC,Dụ,0,0,0,,Bởi vì từ ban công\Nphòng này nhìn ra ngoài
Dialogue: 0,0:08:56.64,0:09:01.64,DVC,Dụ,0,0,0,,sẽ thấy hướng Lam Vũ.
Dialogue: 0,0:09:15.88,0:09:17.55,PSK,Phương,0,0,0,,Phương Sĩ Khiêm: Từ số liệu cho thấy,
Dialogue: 0,0:09:17.55,0:09:19.22,PSK,Phương,0,0,0,,hiện tại vẫn xem như là ổn định.
Dialogue: 0,0:09:20.00,0:09:21.88,PSK,Phương,0,0,0,,Nghe nói kết quả ghép đôi\Ncủa cậu đã ra rồi?
Dialogue: 0,0:09:22.15,0:09:23.80,PSK,Phương,0,0,0,,Lên giường với Dụ Văn Châu rồi hả?
Dialogue: 0,0:09:23.80,0:09:25.84,VKH,Vương,0,0,0,,Chúng tôi lên giường rất nhiều lần rồi,
Dialogue: 0,0:09:26.16,0:09:27.56,VKH,Vương,0,0,0,,ý anh là lần nào?
Dialogue: 0,0:09:28.43,0:09:29.46,PSK,Phương,0,0,0,,*cười khẩy*
Dialogue: 0,0:09:29.46,0:09:33.32,Default,NTP,0,0,0,,Hệ thống: "Tình trạng hiện tại: Chưa điều trị với sự can thiệp của dẫn đường”
Dialogue: 0,0:09:33.32,0:09:37.66,Default,NTP,0,0,0,,“Hẹn tái khám 15/3 (Thứ 5)”
Dialogue: 0,0:09:38.94,0:09:40.22,VKH,Vương,0,0,0,,Sao anh biết bọn tôi không...
Dialogue: 0,0:09:40.22,0:09:43.43,PSK,Phương,0,0,0,,Tôi không có thời gian nghe cậu lấy cái kết hợp lâm thời ở thời chiến ra lấp liếm.
Dialogue: 0,0:09:43.43,0:09:45.44,PSK,Phương,0,0,0,,Dựa vào cuốn vở ghi chú của Dụ Văn Châu,
Dialogue: 0,0:09:45.44,0:09:48.02,PSK,Phương,0,0,0,,muộn nhất là vào ngày mốt cậu sẽ phải chính thức kết hợp với cậu ta.
Dialogue: 0,0:09:48.04,0:09:50.35,PSK,Phương,0,0,0,,Ban đầu tôi còn nghĩ hai\Ncậu sẽ diễn tập một chút,
Dialogue: 0,0:09:50.35,0:09:51.92,PSK,Phương,0,0,0,,xem ra lại không?
Dialogue: 0,0:09:51.96,0:09:53.52,PSK,Phương,0,0,0,,Cậu đang cố kéo dài sao?
Dialogue: 0,0:09:53.52,0:09:54.51,VKH,Vương,0,0,0,,Cậu ấy không nhắc đến.
Dialogue: 0,0:09:54.51,0:09:55.72,VKH,Vương,0,0,0,,Tôi cũng không hỏi.
Dialogue: 0,0:09:56.80,0:09:57.73,VKH,Vương,0,0,0,,Có vẻ như cậu ấy
Dialogue: 0,0:09:57.95,0:10:01.48,VKH,Vương,0,0,0,,đang tận tâm thực hiện hết\Nchức trách Tổng tham mưu với tôi,
Dialogue: 0,0:10:01.48,0:10:02.83,VKH,Vương,0,0,0,,vậy tôi còn bận tâm gì nữa?
Dialogue: 0,0:10:02.83,0:10:05.28,VKH,Vương,0,0,0,,Sớm muộn gì cũng sẽ được sắp xếp rõ ràng.
Dialogue: 0,0:10:05.83,0:10:06.85,PSK,Phương,0,0,0,,Ừ.
Dialogue: 0,0:10:09.88,0:10:11.94,PSK,Phương,0,0,0,,Kết hợp, đẩy mau lên.
Dialogue: 0,0:10:13.73,0:10:15.30,DVC,Dụ,0,0,0,,(Hồi âm) 1
Dialogue: 0,0:10:15.30,0:10:16.64,VKH,Vương,0,0,0,,Có lệ ghê,
Dialogue: 0,0:10:18.62,0:10:20.10,VKH,Vương,0,0,0,,lại nói tiếp...
Dialogue: 0,0:10:20.87,0:10:24.78,VKH,Vương,0,0,0,,thật ra khi tôi nhìn thấy\Nmail chỉ định kết hợp...
Dialogue: 0,0:10:24.78,0:10:26.78,VKH,Vương,0,0,0,,tôi cứ nghĩ rằng sẽ\Nnhìn thấy tên anh cơ.
Dialogue: 0,0:10:28.76,0:10:30.94,PSK,Phương,0,0,0,,Xứng đôi với cậu không phải\Nlà một việc dễ dàng.
Dialogue: 0,0:10:31.14,0:10:34.25,PSK,Phương,0,0,0,,Không kể đến các dẫn đường cấp thấp có mức độ xứng đôi vô cùng thấp,
Dialogue: 0,0:10:34.47,0:10:38.28,PSK,Phương,0,0,0,,Ngay cả Dụ Văn Châu hay là tôi\Ncũng đều không vượt quá 50%.
Dialogue: 0,0:10:38.94,0:10:40.55,PSK,Phương,0,0,0,,Nhưng Sở Y tế\Nđã cân nhắc toàn diện,
Dialogue: 0,0:10:40.55,0:10:43.70,PSK,Phương,0,0,0,,thấy dẫu sao Dụ Văn Châu cũng thuộc hàng đầu trong diện khai thông tinh thần,
Dialogue: 0,0:10:43.70,0:10:45.47,PSK,Phương,0,0,0,,so với tôi thì phù hợp hơn một chút.
Dialogue: 0,0:10:45.47,0:10:47.28,VKH,Vương,0,0,0,,Không phải tôi đang thấy tiếc.
Dialogue: 0,0:10:47.28,0:10:49.70,PSK,Phương,0,0,0,,Tôi còn muốn mở một chai\Nsâm panh ăn mừng đây này!
Dialogue: 0,0:10:50.54,0:10:52.75,VKH,Vương,0,0,0,,Bắt tôi cởi quần chổng cho anh thật
Dialogue: 0,0:10:52.75,0:10:55.20,VKH,Vương,0,0,0,,chắc tôi tự bế ngay luôn quá.
Dialogue: 0,0:10:55.38,0:10:58.44,PSK,Phương,0,0,0,,Ồ? Thế cởi quần quay cho\NDụ Văn Châu đỡ hơn nhiều sao?
Dialogue: 0,0:10:59.40,0:11:00.83,PSK,Phương,0,0,0,,Đồ vô ơn.
Dialogue: 0,0:11:01.08,0:11:02.91,PSK,Phương,0,0,0,,Vi Thảo nuôi cậu nhiều năm như vậy.
Dialogue: 0,0:11:02.91,0:11:04.95,PSK,Phương,0,0,0,,Thế mà cậu lại muốn lên giường của Lam Vũ.
Dialogue: 0,0:11:04.95,0:11:07.88,VKH,Vương,0,0,0,,Hahahahahaha
Dialogue: 0,0:11:10.14,0:11:12.50,VKH,Vương,0,0,0,,Không có, anh đừng có mà nói nhảm.
Dialogue: 0,0:11:13.54,0:11:15.39,VKH,Vương,0,0,0,,Tôi sinh ra là người của Vi Thảo,
Dialogue: 0,0:11:15.39,0:11:17.16,VKH,Vương,0,0,0,,chết là ma của Vi Thảo.
Dialogue: 0,0:11:19.22,0:11:22.09,VKH,Vương,0,0,0,,Chỉ là tôi có một chút cảm động thôi,
Dialogue: 0,0:11:22.09,0:11:26.26,VKH,Vương,0,0,0,,suy cho cùng tôi cảm thấy vốn dĩ không ai trong các anh muốn "làm" tôi hết.
Dialogue: 0,0:11:26.26,0:11:27.40,PSK,Phương,0,0,0,,Không phải vậy đâu.
Dialogue: 0,0:11:27.86,0:11:31.16,PSK,Phương,0,0,0,,Dù kết đôi ở cấp bậc này của\Nchúng ta đều do mệnh lệnh,
Dialogue: 0,0:11:31.16,0:11:33.96,PSK,Phương,0,0,0,,nhưng trước đấy vẫn phải\Nkhảo sát ý nguyện của mọi người.
Dialogue: 0,0:11:33.96,0:11:36.31,PSK,Phương,0,0,0,,Cũng không phải chưa từng có người đơn phương thà chết không theo
Dialogue: 0,0:11:36.31,0:11:38.31,PSK,Phương,0,0,0,,gây ồn ào đến mức quân đội\NLiên minh phải mở phân xử.
Dialogue: 0,0:11:38.65,0:11:42.44,PSK,Phương,0,0,0,,Chỉ là mười bản khảo sát ca của cậu đều nhận được kết quả phản hồi "Đồng ý kết hợp",
Dialogue: 0,0:11:42.48,0:11:45.38,PSK,Phương,0,0,0,,và tất cả đều đến từ những người\Ndẫn đường đứng đầu Liên minh.
Dialogue: 0,0:11:46.06,0:11:47.34,PSK,Phương,0,0,0,,Đối với mọi người,
Dialogue: 0,0:11:47.34,0:11:50.18,PSK,Phương,0,0,0,,có thể cứu được cậu quan trọng\Nhơn bất cứ chuyện gì khác.
Dialogue: 0,0:11:50.84,0:11:53.28,PSK,Phương,0,0,0,,Vì vậy, Vương Kiệt Hi à,
Dialogue: 0,0:11:53.52,0:11:58.52,PSK,Phương,0,0,0,,chính cậu không được chịu thua!
Dialogue: 0,0:12:00.30,0:12:01.16,VKH,Vương,0,0,0,,Tôi...
Dialogue: 0,0:12:03.32,0:12:04.60,VKH,Vương,0,0,0,,Tôi sẽ phối hợp...
Dialogue: 0,0:12:06.52,0:12:08.76,VKH,Vương,0,0,0,,Tôi cũng không biết\Nphải làm gì khác nữa.
Dialogue: 0,0:12:10.78,0:12:12.45,PSK,Phương,0,0,0,,Trước đây tôi cũng\Ncó nói với cậu rồi,
Dialogue: 0,0:12:12.57,0:12:15.06,PSK,Phương,0,0,0,,chứng mất năm giác quan\Ncủa cậu không giống loại
Dialogue: 0,0:12:15.06,0:12:18.22,PSK,Phương,0,0,0,,chỉ bị tổn thương một giác quan như Diệp Tu và Hoàng Thiếu Thiên.
Dialogue: 0,0:12:18.22,0:12:19.83,PSK,Phương,0,0,0,,Nhìn chung thì Sở Y tế cho rằng
Dialogue: 0,0:12:19.83,0:12:23.15,PSK,Phương,0,0,0,,nguyên nhân cơ bản của việc dần dần mất hoàn toàn năm giác quan chủ yếu là…
Dialogue: 0,0:12:23.36,0:12:24.60,VKH,Vương,0,0,0,,Do yếu tố tâm lí...
Dialogue: 0,0:12:24.60,0:12:25.98,VKH,Vương,0,0,0,,Tôi nhớ mà.
Dialogue: 0,0:12:25.98,0:12:27.33,PSK,Phương,0,0,0,,Cho nên?
Dialogue: 0,0:12:27.41,0:12:31.28,VKH,Vương,0,0,0,,Nhưng mà tôi thật sự không biết\Ntôi có vấn đề gì cả.
Dialogue: 0,0:12:31.28,0:12:34.15,VKH,Vương,0,0,0,,Sau khi anh nói tôi đã tự xem xét\Nlại mình trong rất nhiều ngày.
Dialogue: 0,0:12:35.12,0:12:38.22,VKH,Vương,0,0,0,,Tôi thật sự cảm thấy tâm lí\Ncủa tôi rất khỏe mạnh.
Dialogue: 0,0:12:39.30,0:12:41.75,PSK,Phương,0,0,0,,Khi tôi và Trương Tân Kiệt\Nhội chẩn đã từng bàn bạc qua...
Dialogue: 0,0:12:41.75,0:12:42.65,PSK,Phương,0,0,0,,Chúng tôi cho rằng
Dialogue: 0,0:12:42.75,0:12:46.52,PSK,Phương,0,0,0,,có lẽ cậu đang gặp vấn đề\Nvới tâm thái kỳ hậu chiến.
Dialogue: 0,0:12:46.52,0:12:47.87,PSK,Phương,0,0,0,,Nói thẳng ra thì
Dialogue: 0,0:12:47.87,0:12:49.70,PSK,Phương,0,0,0,,cậu thiếu ý chí sinh tồn.
Dialogue: 0,0:12:50.82,0:12:54.77,VKH,Vương,0,0,0,,Tôi chắc chắn rằng 3 tháng trước người ngày ngày báo cáo với ban lãnh đạo
Dialogue: 0,0:12:54.77,0:12:57.04,VKH,Vương,0,0,0,,rằng tỷ lệ sống sót của tôi\Nkhông quá 10% là anh.
Dialogue: 0,0:12:58.12,0:13:00.64,VKH,Vương,0,0,0,,Nhưng cuối cùng tôi lại sống.
Dialogue: 0,0:13:02.10,0:13:04.02,VKH,Vương,0,0,0,,Vậy vẫn còn chưa đủ\Ndục vọng cầu sinh sao?
Dialogue: 0,0:13:07.48,0:13:08.88,PSK,Phương,0,0,0,,Thượng tướng Vương Kiệt Hi.
Dialogue: 0,0:13:08.88,0:13:10.44,PSK,Phương,0,0,0,,Đây là hai chuyện khác nhau.
Dialogue: 0,0:13:11.46,0:13:13.22,PSK,Phương,0,0,0,,Nếu không thì cậu trả lời\Nmột câu hỏi của tôi đi.
Dialogue: 0,0:13:13.22,0:13:16.22,PSK,Phương,0,0,0,,Cậu cảm thấy tại sao\Nbản thân lại cần phải sống?
Dialogue: 0,0:13:18.22,0:13:20.94,VKH,Vương,0,0,0,,Tôi... đã sống qua cả mười\Nmấy năm chiến loạn rồi
Dialogue: 0,0:13:21.74,0:13:25.70,VKH,Vương,0,0,0,,lý nào chẳng dễ gì mới có\Nđược hòa bình lại muốn chết?
Dialogue: 0,0:13:26.50,0:13:28.02,PSK,Phương,0,0,0,,Vậy đổi lại cách hỏi khác.
Dialogue: 0,0:13:28.02,0:13:30.60,PSK,Phương,0,0,0,,Gần đây mỗi ngày cậu làm gì?
Dialogue: 0,0:13:30.60,0:13:32.91,VKH,Vương,0,0,0,,Ban ngày sẽ đọc sách hoặc là\Nngẩn người không làm gì cả.
Dialogue: 0,0:13:32.91,0:13:34.98,VKH,Vương,0,0,0,,Tập thể dục, ăn uống thật ngon.
Dialogue: 0,0:13:35.30,0:13:37.07,VKH,Vương,0,0,0,,Thỉnh thoảng ra ngoài đi dạo.
Dialogue: 0,0:13:37.07,0:13:38.93,VKH,Vương,0,0,0,,Buổi trưa ngủ 1 tiếng.
Dialogue: 0,0:13:38.93,0:13:40.84,VKH,Vương,0,0,0,,Buổi tối ngủ 7 tiếng.
Dialogue: 0,0:13:41.04,0:13:42.33,PSK,Phương,0,0,0,,Cậu cảm thấy vui chứ?
Dialogue: 0,0:13:42.33,0:13:43.94,PSK,Phương,0,0,0,,Thích một cuộc sống như vậy không?
Dialogue: 0,0:13:44.52,0:13:45.81,VKH,Vương,0,0,0,,Cũng được đi.
Dialogue: 0,0:13:46.20,0:13:48.21,PSK,Phương,0,0,0,,Cậu vẫn ở căn hộ\Nmột người trước kia sao?
Dialogue: 0,0:13:48.21,0:13:49.60,VKH,Vương,0,0,0,,Trước đây thì là vậy,
Dialogue: 0,0:13:49.88,0:13:51.24,VKH,Vương,0,0,0,,chẳng phải là đã kết đôi rồi sao?
Dialogue: 0,0:13:51.45,0:13:54.40,VKH,Vương,0,0,0,,Tôi đã đổi sang ở chỗ của Dụ Văn Châu rồi.
Dialogue: 0,0:13:54.40,0:13:56.46,PSK,Phương,0,0,0,,Cậu có mua sắm thêm đồ\Ncho bản thân không?
Dialogue: 0,0:13:56.46,0:13:59.70,PSK,Phương,0,0,0,,Có đặc biệt cảm thấy hứng\Nthú với bất kỳ thứ gì không?
Dialogue: 0,0:13:59.85,0:14:01.22,VKH,Vương,0,0,0,,Tôi...
Dialogue: 0,0:14:01.22,0:14:04.84,VKH,Vương,0,0,0,,Có hôm đi chợ mua\Nmột con cá vây xanh.
Dialogue: 0,0:14:04.84,0:14:06.31,VKH,Vương,0,0,0,,Bôn ba quen rồi.
Dialogue: 0,0:14:06.31,0:14:08.23,VKH,Vương,0,0,0,,Tôi cũng cần có thời gian để thích ứng chứ.
Dialogue: 0,0:14:09.42,0:14:11.25,VKH,Vương,0,0,0,,Được rồi tôi biết rồi,
Dialogue: 0,0:14:11.40,0:14:13.26,VKH,Vương,0,0,0,,sau này sẽ cẩn tuân\Nlời dặn của bác sĩ,
Dialogue: 0,0:14:13.32,0:14:14.95,VKH,Vương,0,0,0,,đi tìm ý nghĩa của cuộc sống.
Dialogue: 0,0:14:16.36,0:14:19.02,DVC,Dụ,0,0,0,,Khi nào anh về, cùng ăn tối không?
Dialogue: 0,0:14:19.66,0:14:23.42,VKH,Vương,0,0,0,,Đấy, cái người tận tâm tận lực\Nnày lại bắt đầu rồi đấy.
Dialogue: 0,0:14:25.20,0:14:28.93,PSK,Phương,0,0,0,,Có lại bận trăm công ngàn việc, trước khi lên giường cũng muốn làm một bữa tối dưới ánh nến.
Dialogue: 0,0:14:28.93,0:14:29.71,PSK,Phương,0,0,0,,Được đó.
Dialogue: 0,0:14:29.71,0:14:31.30,PSK,Phương,0,0,0,,Quả thật là Dụ Văn Châu.
Dialogue: 0,0:14:33.02,0:14:33.94,PSK,Phương,0,0,0,,Được rồi.
Dialogue: 0,0:14:33.94,0:14:35.47,PSK,Phương,0,0,0,,Cậu biểu hiện tốt chút đi.
Dialogue: 0,0:14:35.47,0:14:37.60,PSK,Phương,0,0,0,,Không thể bị người của\NLam Vũ xem thường được.
Dialogue: 0,0:14:37.60,0:14:38.60,VKH,Vương,0,0,0,,Tôi biết rồi.
Dialogue: 0,0:14:39.06,0:14:39.65,PSK,Phương,0,0,0,,Còn có...
Dialogue: 0,0:14:39.88,0:14:41.42,VKH,Vương,0,0,0,,Tôi biết rồi.
Dialogue: 0,0:14:41.42,0:14:44.68,VKH,Vương,0,0,0,,Nhất định tôi sẽ nỗ lực\Ntìm kiếm ý nghĩa của sự sống.
Dialogue: 0,0:14:44.68,0:14:45.98,VKH,Vương,0,0,0,,Yên tâm đi bác sĩ Phương.
Dialogue: 0,0:14:46.50,0:14:47.42,VKH,Vương,0,0,0,,Gặp lại sau.
Dialogue: 0,0:15:00.02,0:15:02.02,DVC,,0,0,0,,*Nghe điện thoại*
Dialogue: 0,0:15:02.02,0:15:05.20,DVC,Dụ,0,0,0,,... Điều chỉnh mức độ nguy hiểm của khu phóng xạ X23 lên cấp ba.
Dialogue: 0,0:15:05.46,0:15:08.04,DVC,Dụ,0,0,0,,Xin hãy cử đội Hư Không đến\Nđó xem xét tình hình thực tế,
Dialogue: 0,0:15:08.04,0:15:09.48,DVC,Dụ,0,0,0,,phản hồi lại trong vòng năm giờ.
Dialogue: 0,0:15:10.63,0:15:11.59,DVC,Dụ,0,0,0,,... Cái đó
Dialogue: 0,0:15:11.59,0:15:13.00,DVC,Dụ,0,0,0,,tôi đã cho thông qua,
Dialogue: 0,0:15:13.20,0:15:15.34,DVC,Dụ,0,0,0,,buổi sáng đã trình lên\Nchủ tịch Phùng rồi.
Dialogue: 0,0:15:15.34,0:15:16.72,DVC,Dụ,0,0,0,,... Cậu hỏi Diệp Tu?
Dialogue: 0,0:15:16.72,0:15:18.19,DVC,Dụ,0,0,0,,Anh ta có thể có ý kiến gì chứ?
Dialogue: 0,0:15:18.19,0:15:20.94,DVC,Dụ,0,0,0,,Ký rồi báo cáo với anh ta mấy cái này chỉ là hình thức thôi được chứ.
Dialogue: 0,0:15:22.28,0:15:24.22,DVC,Dụ,0,0,0,,Tôi đã trao quyền hạn này lại cho Hãn Văn rồi,
Dialogue: 0,0:15:24.22,0:15:25.10,DVC,Dụ,0,0,0,,không cần hỏi tôi,
Dialogue: 0,0:15:26.12,0:15:27.40,DVC,Dụ,0,0,0,,cũng không cần hỏi Thiếu Thiên.
Dialogue: 0,0:15:27.52,0:15:29.20,DVC,Dụ,0,0,0,,Ừ, chỉ cần cậu ấy đồng ý.
Dialogue: 0,0:15:32.26,0:15:33.69,DVC,Dụ,0,0,0,,Kiệt Hi anh về rồi.
Dialogue: 0,0:15:33.69,0:15:34.78,VKH,Vương,0,0,0,,Cậu gọi tôi là gì?
Dialogue: 0,0:15:35.06,0:15:37.02,DVC,Dụ,0,0,0,,Kiệt Hi đó.
Dialogue: 0,0:15:37.02,0:15:38.60,DVC,Dụ,0,0,0,,Nếu không thì phải gọi là gì đây?
Dialogue: 0,0:15:38.60,0:15:39.33,DVC,Dụ,0,0,0,,Thượng tướng Vương?
Dialogue: 0,0:15:39.78,0:15:40.83,DVC,Dụ,0,0,0,,Đội trưởng Vương?
Dialogue: 0,0:15:41.30,0:15:42.93,DVC,Dụ,0,0,0,,Vương Kiệt Hi?
Dialogue: 0,0:15:43.50,0:15:45.11,DVC,Dụ,0,0,0,,Mỗi ngày chúng ta đều ở cùng nhau,
Dialogue: 0,0:15:45.11,0:15:46.73,DVC,Dụ,0,0,0,,lại còn ngủ cùng nhau nữa,
Dialogue: 0,0:15:46.73,0:15:48.82,DVC,Dụ,0,0,0,,như vậy cũng quá là xa cách đi.
Dialogue: 0,0:15:49.68,0:15:50.98,VKH,Vương,0,0,0,,Tùy ý cậu.
Dialogue: 0,0:15:52.40,0:15:54.67,VKH,Vương,0,0,0,,Nhưng chỉ là ngoài mẹ\Nvà bà ngoại của tôi ra,
Dialogue: 0,0:15:54.67,0:15:56.13,VKH,Vương,0,0,0,,chưa từng có ai gọi tôi như vậy.
Dialogue: 0,0:15:57.83,0:15:59.28,DVC,Dụ,0,0,0,,Giúp tôi lấy ít hành lá qua đây đi.
Dialogue: 0,0:16:00.86,0:16:04.38,DVC,Dụ,0,0,0,,Vậy tôi cũng có thể gọi anh\Nlà đàn anh hay tiền bối,
Dialogue: 0,0:16:04.68,0:16:06.81,DVC,Dụ,0,0,0,,nếu như anh thích chơi kiểu đó.
Dialogue: 0,0:16:06.81,0:16:08.10,VKH,Vương,0,0,0,,Không thể,
Dialogue: 0,0:16:08.10,0:16:09.22,VKH,Vương,0,0,0,,không cần thiết.
Dialogue: 0,0:16:10.18,0:16:11.56,VKH,Vương,0,0,0,,Cậu nấu cái gì đó?
Dialogue: 0,0:16:12.02,0:16:13.25,DVC,Dụ,0,0,0,,Yêm đốc tiên.
Dialogue: 0,0:16:13.25,0:16:15.65,DVC,Dụ,0,0,0,,Sáng nay Tiểu Chu vừa\Nvề Liên minh nghị sự,
Dialogue: 0,0:16:15.65,0:16:17.98,DVC,Dụ,0,0,0,,mang theo măng năm\Nnay với chân giò hun khói,
Dialogue: 0,0:16:17.98,0:16:19.90,DVC,Dụ,0,0,0,,cách làm đều là do cậu ta chỉ cho tôi.
Dialogue: 0,0:16:19.90,0:16:21.07,VKH,Vương,0,0,0,,Bằng miệng?
Dialogue: 0,0:16:21.07,0:16:22.26,DVC,Dụ,0,0,0,,Hahaha
Dialogue: 0,0:16:22.34,0:16:24.98,DVC,Dụ,0,0,0,,Chê cười người ta không thích\Nnói chuyện có ổn không?
Dialogue: 0,0:16:27.68,0:16:28.80,VKH,Vương,0,0,0,,Thật là thơm~
Dialogue: 0,0:16:30.36,0:16:32.72,VKH,Vương,0,0,0,,Người phương Nam các cậu đều\Nđa tài đa nghệ như vậy sao?
Dialogue: 0,0:16:33.54,0:16:34.34,VKH,Vương,0,0,0,,Đừng có nói với tôi là
Dialogue: 0,0:16:34.34,0:16:37.34,VKH,Vương,0,0,0,,Lam Vũ các cậu đem cả nồi niêu\Nxoong chảo ra chiến trường nhé.
Dialogue: 0,0:16:37.34,0:16:38.84,DVC,Dụ,0,0,0,,Đương nhiên không phải vậy.
Dialogue: 0,0:16:39.10,0:16:43.19,DVC,Dụ,0,0,0,,Ai mà không phải dùng lương khô với dịch dinh dưỡng sống qua bấy nhiêu năm chứ.
Dialogue: 0,0:16:43.66,0:16:45.33,DVC,Dụ,0,0,0,,Trong lúc anh hôn mê,
Dialogue: 0,0:16:45.33,0:16:47.34,DVC,Dụ,0,0,0,,tôi mới vừa dọn dẹp nơi này thôi.
Dialogue: 0,0:16:47.76,0:16:49.68,DVC,Dụ,0,0,0,,Lần đầu xuống bếp\Ncũng thảm họa lắm.
Dialogue: 0,0:16:50.55,0:16:53.79,DVC,Dụ,0,0,0,,Nhưng cuối cùng khi ngồi xuống uống chén canh chính mình nấu ra,
Dialogue: 0,0:16:54.28,0:16:55.49,DVC,Dụ,0,0,0,,tôi sực nhận ra
Dialogue: 0,0:16:55.49,0:16:57.85,DVC,Dụ,0,0,0,,chẳng phải những người\Nvào sinh ra tử như chúng ta,
Dialogue: 0,0:16:57.85,0:16:59.05,DVC,Dụ,0,0,0,,liếm máu trên lưỡi đao,
Dialogue: 0,0:16:59.05,0:17:00.94,DVC,Dụ,0,0,0,,đều chỉ vì khoảnh khắc này sao?
Dialogue: 0,0:17:01.88,0:17:05.12,VKH,Vương,0,0,0,,... Ừm... Nghe hay đó...
Dialogue: 0,0:17:06.46,0:17:08.33,VKH,Vương,0,0,0,,Dường như tôi đã\Nđột nhiên hiểu ra
Dialogue: 0,0:17:08.79,0:17:11.18,VKH,Vương,0,0,0,,tại sao Liên minh lại muốn\Ntôi với cậu kết đôi rồi.
Dialogue: 0,0:17:11.53,0:17:14.54,VKH,Vương,0,0,0,,sẽ được trực tiếp quan sát cách\Nyêu thương cuộc sống nhiệt tình.
Dialogue: 0,0:17:14.90,0:17:17.77,DVC,Dụ,0,0,0,,Lời nói và việc làm đều phải\Nmẫu mực, áp lực của tôi rất lớn.
Dialogue: 0,0:17:17.83,0:17:19.38,DVC,Dụ,0,0,0,,Nhưng mà chúng ta\Nđã thỏa thuận rồi,
Dialogue: 0,0:17:19.62,0:17:21.63,DVC,Dụ,0,0,0,,chỉ thỉnh thoảng tôi mới nấu ăn thôi,
Dialogue: 0,0:17:21.63,0:17:22.98,DVC,Dụ,0,0,0,,mùi vị cũng rất bình thường,
Dialogue: 0,0:17:22.98,0:17:25.40,DVC,Dụ,0,0,0,,anh đừng có kỳ vọng quá cao đấy.
Dialogue: 0,0:17:25.72,0:17:26.94,VKH,Vương,0,0,0,,Nào dám.
Dialogue: 0,0:17:27.84,0:17:30.05,VKH,Vương,0,0,0,,Hơn nữa gần đây tôi\Ncũng không có gì làm,
Dialogue: 0,0:17:30.35,0:17:32.72,VKH,Vương,0,0,0,,tôi cũng có thể tự mình thử.
Dialogue: 0,0:17:33.40,0:17:36.38,VKH,Vương,0,0,0,,Có lẽ sau này cậu đừng\Nghét bỏ là tương đối ổn rồi.
Dialogue: 0,0:17:36.70,0:17:39.46,DVC,Dụ,0,0,0,,Tan làm về nhà liền có thể\Năn được những món ăn nóng hổi.
Dialogue: 0,0:17:39.46,0:17:41.17,DVC,Dụ,0,0,0,,Hạnh phúc còn không kịp luôn ấy,
Dialogue: 0,0:17:41.17,0:17:42.82,DVC,Dụ,0,0,0,,làm sao có thể ghét bỏ được chứ?
Dialogue: 0,0:17:43.94,0:17:45.44,DVC,Dụ,0,0,0,,Lát nữa là ăn canh được rồi.
Dialogue: 0,0:17:45.44,0:17:46.66,DVC,Dụ,0,0,0,,Xới cơm trước đi.
Dialogue: 0,0:17:56.10,0:17:57.23,DVC,Dụ,0,0,0,,À lại nói,
Dialogue: 0,0:17:57.88,0:18:02.88,DVC,Dụ,0,0,0,,lúc trưa tôi nhận được\Ntin nhắn từ Phương Sĩ Khiêm.
Dialogue: 0,0:18:04.60,0:18:07.24,VKH,Vương,0,0,0,,Tôi biết rồi. Tôi ở\Nbên cạnh anh ta mà.
Dialogue: 0,0:18:10.06,0:18:11.48,VKH,Vương,0,0,0,,Vậy nên bữa ăn này của cậu
Dialogue: 0,0:18:12.25,0:18:15.60,VKH,Vương,0,0,0,,có phải là bữa tối cuối cùng kỉ niệm tình bạn trong sáng của chúng ta không?
Dialogue: 0,0:18:15.75,0:18:16.53,DVC,Dụ,0,0,0,,Hả?
Dialogue: 0,0:18:17.13,0:18:19.15,DVC,Dụ,0,0,0,,Không lẽ kết hợp rồi thì\Nkhông thể làm bạn sao?
Dialogue: 0,0:18:19.50,0:18:21.19,VKH,NTP,0,0,0,,Không còn trong sáng nữa rồi.
Dialogue: 0,0:18:21.19,0:18:23.11,DVC,Dụ,0,0,0,,Cũng đâu phải trước\Nđây chưa từng làm.
Dialogue: 0,0:18:23.11,0:18:24.92,VKH,Vương,0,0,0,,Có thể giống nhau được sao.
Dialogue: 0,0:18:25.10,0:18:28.50,VKH,Vương,0,0,0,,Trước đây là vì chiến đấu nên\Nmới tạo liên kết tạm thời.
Dialogue: 0,0:18:29.20,0:18:31.90,VKH,Vương,0,0,0,,Tôi chẳng qua là ôm lấy 120 điểm\Nthái độ chuyên nghiệp làm với cậu...
Dialogue: 0,0:18:32.25,0:18:34.12,DVC,Dụ,0,0,0,,À thì ra là như vậy sao.
Dialogue: 0,0:18:37.58,0:18:41.83,VKH,Vương,0,0,0,,Được rồi... thật ra cũng\Nkhông phải hoàn toàn là...
Dialogue: 0,0:18:43.07,0:18:45.45,VKH,Vương,0,0,0,,Tôi hỏi một chút, buổi tối cậu chuẩn bị...
Dialogue: 0,0:18:46.15,0:18:48.98,VKH,Vương,0,0,0,,Diễn tập hay là thực chiến luôn?
Dialogue: 0,0:18:49.03,0:18:49.57,DVC,Dụ,0,0,0,,Hả?
Dialogue: 0,0:18:50.15,0:18:51.28,DVC,Dụ,0,0,0,,Vẫn chưa nghĩ tới nữa...
Dialogue: 0,0:18:51.92,0:18:53.11,DVC,Dụ,0,0,0,,Không phải với anh,
Dialogue: 0,0:18:53.34,0:18:56.56,DVC,Dụ,0,0,0,,tôi vẫn luôn làm việc tùy theo hoàn cảnh không có chiến thuật nào sao?
Dialogue: 0,0:18:58.80,0:18:59.78,VKH,Vương,0,0,0,,Cậu ăn xong chưa?
Dialogue: 0,0:18:59.78,0:19:00.84,VKH,Vương,0,0,0,,Tôi đi rửa chén.
Dialogue: 0,0:19:10.15,0:19:12.98,DVC,Dụ,0,0,0,,[Là tinh thần thể của Vương Kiệt Hi?]
Dialogue: 0,0:19:15.20,0:19:16.46,DVC,Dụ,0,0,0,,Anh ấy để mi ở ngoài sao?
Dialogue: 0,0:19:19.04,0:19:20.38,DVC,Dụ,0,0,0,,Lâu rồi không gặp.
Dialogue: 0,0:19:20.38,0:19:23.58,DVC,Dụ,0,0,0,,Xem ra mi đã hoàn toàn bình phục rồi.
Dialogue: 0,0:19:25.56,0:19:27.34,VKH,Vương,0,0,0,,Thế mà cậu lại không sợ nó.
Dialogue: 0,0:19:31.52,0:19:32.98,DVC,Dụ,0,0,0,,Thật là tâm linh tương thông nha.
Dialogue: 0,0:19:34.00,0:19:35.08,DVC,Dụ,0,0,0,,Anh nói như vậy
Dialogue: 0,0:19:35.08,0:19:37.00,DVC,Dụ,0,0,0,,móng vuốt của nó lộ ra hết rồi kìa.
Dialogue: 0,0:19:37.52,0:19:40.52,DVC,Dụ,0,0,0,,Hơn nữa sao anh lại không nói
Dialogue: 0,0:19:40.52,0:19:42.24,DVC,Dụ,0,0,0,,nó thế mà không sợ tôi.
Dialogue: 0,0:19:46.63,0:19:49.94,DVC,Dụ,0,0,0,,Dáng đẹp đó, làm tôi\Nmuốn huýt sáo ghê.
Dialogue: 0,0:19:49.94,0:19:51.60,VKH,Vương,0,0,0,,Vậy cậu cứ huýt đi.
Dialogue: 0,0:19:51.88,0:19:53.05,DVC,Dụ,0,0,0,,Đáng tiếc quá,
Dialogue: 0,0:19:53.05,0:19:54.74,DVC,Dụ,0,0,0,,tôi mãi vẫn chưa\Nhọc huýt được.
Dialogue: 0,0:19:55.13,0:19:56.80,VKH,Vương,0,0,0,,Cá voi lớn của cậu đâu?
Dialogue: 0,0:19:57.23,0:19:58.52,DVC,Dụ,0,0,0,,Cũng đến đây rồi.
Dialogue: 0,0:19:59.92,0:20:01.74,DVC,Dụ,0,0,0,,Để cho bọn nó ra ngoài chơi đi.
Dialogue: 0,0:20:01.74,0:20:03.40,DVC,Dụ,0,0,0,,Da mặt tôi mỏng,
Dialogue: 0,0:20:03.99,0:20:07.01,DVC,Dụ,0,0,0,,bị bọn nó nhìn chằm chằm\Nchắc không cứng nổi.
Dialogue: 0,0:20:07.10,0:20:08.66,VKH,Vương,0,0,0,,Da mặt mỏng?
Dialogue: 0,0:20:09.48,0:20:10.56,VKH,Vương,0,0,0,,Cậu á?
Dialogue: 0,0:20:13.74,0:20:15.83,VKH,Vương,0,0,0,,Cậu biết là bất kể\Ncậu "làm" tôi ở đâu,
Dialogue: 0,0:20:16.42,0:20:19.35,VKH,Vương,0,0,0,,thật ra đều sẽ bị tinh thần thể\Nnhìn chằm chằm mà phải không?
Dialogue: 0,0:20:20.76,0:20:22.76,VKH,Vương,0,0,0,,Khi nãy còn thản nhiên nói là
Dialogue: 0,0:20:22.76,0:20:24.41,VKH,Vương,0,0,0,,cũng không phải\Nchưa từng "làm" qua,
Dialogue: 0,0:20:24.41,0:20:26.58,VKH,Vương,0,0,0,,sao mới đó đã bắt đầu rụt rè rồi?
Dialogue: 0,0:20:29.32,0:20:31.14,DVC,Dụ,0,0,0,,Đứng cách xa giường như vậy,
Dialogue: 0,0:20:31.14,0:20:33.36,DVC,Dụ,0,0,0,,chứng tỏ anh đang\Nchống đối chuyện này.
Dialogue: 0,0:20:34.04,0:20:35.50,DVC,Dụ,0,0,0,,Hai tay khoanh trước ngực,
Dialogue: 0,0:20:35.50,0:20:37.78,DVC,Dụ,0,0,0,,chứng tỏ là anh đề phòng tôi.
Dialogue: 0,0:20:39.04,0:20:40.34,DVC,Dụ,0,0,0,,Từ ngôn ngữ cơ thể cho thấy
Dialogue: 0,0:20:40.58,0:20:42.93,DVC,Dụ,0,0,0,,rõ ràng là người vừa\Nlo lắng vừa rụt rè
Dialogue: 0,0:20:43.13,0:20:44.58,DVC,Dụ,0,0,0,,là Kiệt Hi anh mới đúng chứ.
Dialogue: 0,0:20:46.24,0:20:48.73,VKH,Vương,0,0,0,,Nói nhiều giống y như\NHoàng Thiếu Thiên vậy.
Dialogue: 0,0:20:48.73,0:20:51.90,VKH,Vương,0,0,0,,Cậu cũng chẳng khá\Nhơn điểm nào đâu.
Dialogue: 0,0:20:52.33,0:20:54.02,VKH,Vương,0,0,0,,Đi tắm rửa đây.
Dialogue: 0,0:20:54.02,0:20:54.74,VKH,Vương,0,0,0,,Cậu nói đúng.
Dialogue: 0,0:20:56.18,0:20:57.98,VKH,Vương,0,0,0,,Tôi cần phải điều chỉnh lại một chút.
Dialogue: 0,0:20:59.35,0:20:59.93,DVC,Dụ,0,0,0,,Được.
Dialogue: 0,0:21:10.99,0:21:13.38,VKH,Vương,0,0,0,,Haizz
Dialogue: 0,0:21:13.38,0:21:14.06,DVC,Dụ,0,0,0,,Thôi bỏ đi.
Dialogue: 0,0:21:15.32,0:21:18.53,DVC,Dụ,0,0,0,,Có vẻ cố gắng nước chảy\Nthành sông không khả thi lắm.
Dialogue: 0,0:21:19.06,0:21:19.94,DVC,Dụ,0,0,0,,Vậy...
Dialogue: 0,0:21:19.94,0:21:22.15,DVC,Dụ,0,0,0,,Chẳng bằng chúng ta\Nthẳng thắn đối diện vấn đề,
Dialogue: 0,0:21:22.35,0:21:23.16,DVC,Dụ,0,0,0,,thảo luận chút đi.
Dialogue: 0,0:21:24.70,0:21:25.48,VKH,Vương,0,0,0,,Ừm.
Dialogue: 0,0:21:25.70,0:21:26.50,VKH,Vương,0,0,0,,Cậu nói đi.
Dialogue: 0,0:21:29.36,0:21:30.70,DVC,Dụ,0,0,0,,Đây là thứ Sở Y tế Liên minh,
Dialogue: 0,0:21:30.85,0:21:34.45,DVC,Dụ,0,0,0,,hoặc nói tiền bối\NPhương đã giao cho tôi.
Dialogue: 0,0:21:34.48,0:21:34.98,DVC,Dụ,0,0,0,,Là...
Dialogue: 0,0:21:35.93,0:21:37.18,VKH,Vương,0,0,0,,Thuốc dẫn dụ sốt kết hợp,
Dialogue: 0,0:21:37.18,0:21:38.08,VKH,Vương,0,0,0,,tôi biết.
Dialogue: 0,0:21:38.87,0:21:42.62,VKH,Vương,0,0,0,,Đâm phát kim này xuống, coi như\Nkhỏi còn tiết tấu thảo luận nữa.
Dialogue: 0,0:21:43.40,0:21:46.06,DVC,Dụ,0,0,0,,Cuốn sách hướng dẫn điều trị\Nmà tôi nhận được nhắc nhở là
Dialogue: 0,0:21:46.28,0:21:48.74,DVC,Dụ,0,0,0,,khi kết hợp hoàn chỉnh,\Ndẫn đường và lính gác 
Dialogue: 0,0:21:48.74,0:21:50.94,DVC,Dụ,0,0,0,,cần phải hoàn toàn\Ngiao phó bản thân.
Dialogue: 0,0:21:51.58,0:21:55.20,DVC,Dụ,0,0,0,,Nó không chỉ đơn giản như\Nđóng cửa lá chắn tinh thần lại.
Dialogue: 0,0:21:55.48,0:21:58.66,DVC,Dụ,0,0,0,,Muốn đạt đến cảnh thế giới\Ntinh thần hoàn toàn dung hợp,
Dialogue: 0,0:21:58.66,0:22:01.66,DVC,Dụ,0,0,0,,chúng ta cần… Ừm…\NMô phỏng người yêu thực thụ.
Dialogue: 0,0:22:02.04,0:22:07.03,DVC,Dụ,0,0,0,,Toàn thân toàn ý khát vọng và\Nhưởng thụ chuyện làm tình với người kia
Dialogue: 0,0:22:08.24,0:22:11.88,DVC,Dụ,0,0,0,,cuối cùng nỗ lực\Ncùng nhau đạt cực khoái.
Dialogue: 0,0:22:12.28,0:22:13.77,VKH,,0,0,0,,Khụ...
Dialogue: 0,0:22:14.46,0:22:17.71,VKH,Vương,0,0,0,,Thế nên có phải là không nên\Ndùng thuốc dẫn dụ không?
Dialogue: 0,0:22:18.43,0:22:20.63,DVC,Dụ,0,0,0,,Anh nghĩ như nào?
Dialogue: 0,0:22:21.68,0:22:23.28,VKH,Vương,0,0,0,,Tôi sao cũng được.
Dialogue: 0,0:22:23.90,0:22:27.02,VKH,Vương,0,0,0,,Tôi biết cậu không\Ncó ép buộc hay gì cả,
Dialogue: 0,0:22:28.38,0:22:31.72,VKH,Vương,0,0,0,,cũng không cần phải\Nbù đắp gì cho tôi. 
Dialogue: 0,0:22:32.56,0:22:36.32,VKH,Vương,0,0,0,,Nhưng tôi thật lòng hi vọng có thể\Nchọn một cách khiến cậu thấy thoải mái,
Dialogue: 0,0:22:36.66,0:22:38.55,VKH,Vương,0,0,0,,nếu cậu cảm thấy tiêm thuốc dẫn dụ,
Dialogue: 0,0:22:38.55,0:22:40.94,VKH,Vương,0,0,0,,giao tất cả mọi thứ cho\Nbản năng sẽ dễ dàng hơn,
Dialogue: 0,0:22:41.34,0:22:42.66,VKH,Vương,0,0,0,,tôi không có vấn đề gì hết.
Dialogue: 0,0:22:42.66,0:22:43.95,DVC,Dụ,0,0,0,,Tôi không muốn.
Dialogue: 0,0:22:43.95,0:22:45.88,DVC,Dụ,0,0,0,,Tôi không muốn\Nsáng mai khi thức dậy,
Dialogue: 0,0:22:45.97,0:22:48.14,DVC,Dụ,0,0,0,,chỉ có những mảnh ký ức\Nhỗn loạn về đêm nay,
Dialogue: 0,0:22:48.90,0:22:51.12,DVC,Dụ,0,0,0,,lại đối mặt với những\Nthay đổi lớn của mình,
Dialogue: 0,0:22:51.12,0:22:54.77,DVC,Dụ,0,0,0,,khủng hoảng do không biết quá trình sẽ tạo thành bóng ma tiềm ẩn trong lòng.
Dialogue: 0,0:22:54.92,0:22:56.21,VKH,Vương,0,0,0,,Được rồi được rồi.
Dialogue: 0,0:22:56.21,0:22:57.66,VKH,Vương,0,0,0,,Không dùng thì không dùng.
Dialogue: 0,0:22:58.58,0:22:59.98,VKH,Vương,0,0,0,,Cậu còn muốn nói thêm nữa
Dialogue: 0,0:22:59.98,0:23:03.79,VKH,Vương,0,0,0,,thì sẽ lên đến cuộc thảo luận triết học\Ntại sao con người là con người mất.
Dialogue: 0,0:23:04.98,0:23:06.80,VKH,Vương,0,0,0,,Hôm nay chúng ta\Ncứ thử trước đi,
Dialogue: 0,0:23:06.80,0:23:08.24,VKH,Vương,0,0,0,,nếu thật sự không được
Dialogue: 0,0:23:08.24,0:23:09.20,VKH,Vương,0,0,0,,thì ngày mai thử lại.
Dialogue: 0,0:23:10.46,0:23:14.26,DVC,Dụ,0,0,0,,Hơn nữa... theo kiến nghị của Sở Y tế,
Dialogue: 0,0:23:14.26,0:23:16.30,DVC,Dụ,0,0,0,,mỗi tuần chúng ta\Nđều phải "làm" vài lần,
Dialogue: 0,0:23:16.30,0:23:18.42,DVC,Dụ,0,0,0,,không thể nào luôn\Nnhờ vào thuốc được.
Dialogue: 0,0:23:18.60,0:23:20.04,DVC,Dụ,0,0,0,,Lỡ như truyền ra bên ngoài
Dialogue: 0,0:23:20.04,0:23:21.78,DVC,Dụ,0,0,0,,mọi người sẽ nhìn tôi thế nào đây?
Dialogue: 0,0:23:22.84,0:23:24.66,VKH,Vương,0,0,0,,Cậu tính nói với ai?
Dialogue: 0,0:23:24.66,0:23:28.80,VKH,Vương,0,0,0,,Đừng ra ngoài nói bậy, tôi cũng\Nkhông phải người tùy tiện như vậy.
Dialogue: 0,0:23:30.82,0:23:34.30,DVC,Dụ,0,0,0,,Cựu đội phó thân yêu của anh đã gửi cho tôi một bảng khảo sát điều trị,
Dialogue: 0,0:23:34.68,0:23:36.90,DVC,Dụ,0,0,0,,bắt tôi mỗi lần làm xong đều phải trả lời,
Dialogue: 0,0:23:36.90,0:23:39.58,DVC,Dụ,0,0,0,,đủ hai mươi câu hỏi\Nthẹn muốn chết đó.
Dialogue: 0,0:23:40.08,0:23:41.32,DVC,Dụ,0,0,0,,Tôi khổ quá mà.
Dialogue: 0,0:23:41.48,0:23:45.06,DVC,Dụ,0,0,0,,Cái này còn khó hơn bảo tôi ký đồng ý vào bản khảo sát ý nguyện kết hợp nhiều.
Dialogue: 0,0:23:45.84,0:23:47.03,VKH,Vương,0,0,0,,Còn có chuyện như vậy nữa hả?
Dialogue: 0,0:23:47.80,0:23:48.98,VKH,Vương,0,0,0,,Để tôi xem xem.
Dialogue: 0,0:23:50.03,0:23:50.88,DVC,Dụ,0,0,0,,Thôi đi.
Dialogue: 0,0:23:51.30,0:23:53.69,DVC,Dụ,0,0,0,,Một mình tôi yên tĩnh\Ntiếp nhận là được rồi.
Dialogue: 0,0:23:54.10,0:23:55.48,DVC,Dụ,0,0,0,,Huống chi
Dialogue: 0,0:23:55.48,0:23:57.90,DVC,Dụ,0,0,0,,nếu như tôi thật sự khoanh\Nvào lí do không đạt cực khoái
Dialogue: 0,0:23:58.12,0:23:59.94,DVC,Dụ,0,0,0,,là do người tiếp nhận\Nkhông chịu phối hợp,
Dialogue: 0,0:23:59.94,0:24:02.01,DVC,Dụ,0,0,0,,anh lại cảm thấy\Nbản thân quá nhập vai.
Dialogue: 0,0:24:02.01,0:24:05.16,DVC,Dụ,0,0,0,,Chẳng phải con thuyền tình bạn\Nnhỏ bé này sẽ chìm sao?
Dialogue: 0,0:24:06.72,0:24:08.82,VKH,Vương,0,0,0,,Chúng ta còn con\Nthuyền tình bạn nữa hả?
Dialogue: 0,0:24:11.44,0:24:13.14,VKH,Vương,0,0,0,,Thật sự có câu hỏi quá đáng vậy sao?
Dialogue: 0,0:24:16.74,0:24:17.98,DVC,Dụ,0,0,0,,Thả lỏng hơn chưa?
Dialogue: 0,0:24:20.44,0:24:21.37,VKH,Vương,0,0,0,,Hơn nhiều rồi.
Dialogue: 0,0:24:22.51,0:24:25.51,VKH,Vương,0,0,0,,Quả nhiên lảm nhảm\Ntrị bách bệnh mà.
Dialogue: 0,0:24:26.55,0:24:27.90,DVC,Dụ,0,0,0,,Vậy...
Dialogue: 0,0:24:27.90,0:24:29.93,DVC,Dụ,0,0,0,,Chúng ta bắt đầu đi, Kiệt Hi.
Dialogue: 0,0:24:38.02,0:24:39.08,DVC,Dụ,0,0,0,,Có muốn tắt đèn không?
Dialogue: 0,0:24:42.58,0:24:43.44,VKH,NTP,0,0,0,,Không cần đâu.
Dialogue: 0,0:24:44.94,0:24:46.03,VKH,NTP,0,0,0,,Để nhìn cho rõ tôi,
Dialogue: 0,0:24:46.90,0:24:49.28,VKH,NTP,0,0,0,,có thể khiến cho cậu có cảm giác hơn.
Dialogue: 0,0:25:47.56,0:25:50.44,Vietsub,,0,0,0,,{\fad(500,500)}Lưỡi dao đẫm máu phủ đầy bụi{ol;h;sl;fad(500,500)t;Lưỡi dao đẫm máu phủ đầy bụi}
Dialogue: 0,0:25:50.56,0:25:58.76,Vietsub,,0,0,0,,{\fad(500,500)}Trên quảng trường bồ câu trắng bay trong gió nghe thấy ai đang ngợi ca{ol;h;sl;fad(500,500)t;Trên quảng trường bồ câu trắng bay trong gió nghe thấy ai đang ngợi ca}
Dialogue: 0,0:25:59.12,0:26:02.00,Vietsub,,0,0,0,,{\fad(500,500)}Tượng đài cuối cùng{ol;h;sl;fad(500,500)t;Tượng đài cuối cùng}
Dialogue: 0,0:26:02.12,0:26:06.68,Vietsub,,0,0,0,,{\fad(500,500)}Biến mất trong khoảng không,\Ntrang giấy được lật lại{ol;h;sl;fad(500,500)t;Biến mất trong khoảng không, trang giấy được lật lại}
Dialogue: 0,0:26:06.68,0:26:11.80,Vietsub,,0,0,0,,{\fad(500,500)}Ánh nắng chiếu xuống cho cuộc sống yên bình{ol;h;sl;fad(500,500)t;Ánh nắng chiếu xuống cho cuộc sống yên bình}
Dialogue: 0,0:26:13.32,0:26:18.52,Vietsub,,0,0,0,,{\fad(500,500)}Vinh quang và chiến tranh\Nđến cuối cùng cũng chỉ là xiềng xích {ol;h;sl;fad(500,500)t;Ving quang và chiến tranh đến cuối cùng cũng chỉ là xiềng xích }
