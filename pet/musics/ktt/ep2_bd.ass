Dialogue: 0,0:00:04.58,0:00:06.58,Default,,0,0,0,,(Thế giới tinh thần của Vương Kiệt Hi)
Dialogue: 0,0:00:06.58,0:00:07.98,DVC,Dụ,0,0,0,,Anh tỉnh rồi à?
Dialogue: 0,0:00:07.98,0:00:09.93,DVC,Dụ,0,0,0,,Vẫn ổn chứ?
Dialogue: 0,0:00:10.98,0:00:13.16,VKH,Vương,0,0,0,,Ở đây tôi vẫn luôn ổn mà.
Dialogue: 0,0:00:14.52,0:00:17.96,DVC,Dụ,0,0,0,,Trước đây chỉ biết sau khi\Nkết đôi thì thế giới tinh thần
Dialogue: 0,0:00:17.96,0:00:21.59,DVC,Dụ,0,0,0,,của riêng mỗi lính gác và dẫn đường\Nphải ở cùng một phạm vi với nhau,
Dialogue: 0,0:00:21.59,0:00:23.88,DVC,Dụ,0,0,0,,cảnh vật cũng phải dựa theo\Nđặc tính của cả hai mà hợp thành.
Dialogue: 0,0:00:25.03,0:00:27.48,DVC,Dụ,0,0,0,,Không ngờ rằng sau khi chúng ta kết đôi,
Dialogue: 0,0:00:27.56,0:00:30.63,DVC,Dụ,0,0,0,,sẽ có đồng cỏ núi cao \Nvà rừng cây trải dài như vậy.
Dialogue: 0,0:00:30.63,0:00:33.00,DVC,Dụ,0,0,0,,Rất đẹp, rất rộng lớn.
Dialogue: 0,0:00:34.48,0:00:38.73,VKH,Vương,0,0,0,,Nếu là lúc trước khi tôi trọng\N thương thì cái thảo nguyên này
Dialogue: 0,0:00:38.73,0:00:41.52,VKH,Vương,0,0,0,,kết đôi xong, có lẽ nó\Nbiến thành hòn đảo luôn rồi.
Dialogue: 0,0:00:41.82,0:00:44.28,DVC,Dụ,0,0,0,,Đảo thì không ổn đâu, quá khắc nghiệt.
Dialogue: 0,0:00:44.28,0:00:45.48,DVC,Dụ,0,0,0,,Không thích hợp với anh.
Dialogue: 0,0:00:46.44,0:00:47.84,VKH,Vương,0,0,0,,Trước đây cậu từng đến rồi nhỉ,
Dialogue: 0,0:00:49.04,0:00:50.76,VKH,Vương,0,0,0,,tôi có cảm nhận được mùi của cậu.
Dialogue: 0,0:00:51.44,0:00:53.28,DVC,Dụ,0,0,0,,Khi mà anh trọng thương \Nhôn mê sau cuộc chiến?
Dialogue: 0,0:00:54.85,0:00:56.52,DVC,Dụ,0,0,0,,Ừ tôi có đến rồi.
Dialogue: 0,0:00:56.52,0:00:57.78,DVC,Dụ,0,0,0,,Làm ơn đi,
Dialogue: 0,0:00:57.78,0:01:01.08,DVC,Dụ,0,0,0,,khi đó lá chắn tinh thần của anh\Ngần như chẳng tồn tại.
Dialogue: 0,0:01:01.28,0:01:04.10,DVC,Dụ,0,0,0,,Toàn bộ Tổng cục Y tế và các\Ndẫn đường lớn của mỗi đội
Dialogue: 0,0:01:04.10,0:01:05.90,DVC,Dụ,0,0,0,,gần như là lập thành \Nđoàn đến thăm anh.
Dialogue: 0,0:01:05.90,0:01:10.12,DVC,Dụ,0,0,0,,Tất cả đều là cây khô cháy khét \Nvà cỏ đã sớm cháy thành tro.
Dialogue: 0,0:01:10.98,0:01:14.42,DVC,Dụ,0,0,0,,Thật ra lúc đó mọi người\N không còn chút lòng tin nào cả.
Dialogue: 0,0:01:15.50,0:01:16.88,DVC,Dụ,0,0,0,,May là sau đó anh vẫn tỉnh dậy.
Dialogue: 0,0:01:20.24,0:01:21.91,VKH,Vương,0,0,0,,Nơi có gió,
Dialogue: 0,0:01:21.91,0:01:24.12,VKH,Vương,0,0,0,,hạt giống cây cỏ sẽ luôn đến.
Dialogue: 0,0:01:25.20,0:01:27.05,VKH,Vương,0,0,0,,Một cái cây có thể bén rễ,
Dialogue: 0,0:01:27.44,0:01:29.15,VKH,Vương,0,0,0,,thì cuối cùng sẽ có\Nthể thành thảo nguyên.
Dialogue: 0,0:01:30.85,0:01:34.82,VKH,Vương,0,0,0,,Muốn cùng ngồi ở đây một lát không?
Dialogue: 0,0:01:34.82,0:01:37.58,VKH,Vương,0,0,0,,Nơi này tầm mắt nhìn ra \Nvách đá gần biển, thật tốt.
Dialogue: 0,0:01:41.08,0:01:43.14,VKH,Vương,0,0,0,,Lúc đầu tôi còn cảm thấy \Nnó có chút đơn điệu,
Dialogue: 0,0:01:44.22,0:01:45.68,VKH,Vương,0,0,0,,hiện tại còn có thể nhìn thấy biển,
Dialogue: 0,0:01:46.66,0:01:48.28,VKH,Vương,0,0,0,,thật sự là càng thêm hoàn hảo.
Dialogue: 0,0:01:50.22,0:01:52.22,VKH,Vương,0,0,0,,Cho dù sau này có bị giam cầm ở đây,
Dialogue: 0,0:01:53.48,0:01:55.14,VKH,Vương,0,0,0,,cũng sẽ không cảm thấy\N trống vắng đâu nhỉ.
Dialogue: 0,0:01:57.48,0:02:00.55,DVC,Dụ,0,0,0,,Tôi đã ký rất nhiều quyết định đồng ý,
Dialogue: 0,0:02:00.55,0:02:03.15,DVC,Dụ,0,0,0,,về những bệnh mất đi năm giác quan.
Dialogue: 0,0:02:03.18,0:02:05.58,DVC,Dụ,0,0,0,,Lính gác bị giam cầm ở thế giới\Ntinh thần của chính mình,
Dialogue: 0,0:02:05.58,0:02:08.42,DVC,Dụ,0,0,0,,họ từ bỏ việc xin giữ lại\Nthể xác để sống.
Dialogue: 0,0:02:10.36,0:02:12.08,DVC,Dụ,0,0,0,,Tôi thật sự không mong \Nrằng có một ngày...
Dialogue: 0,0:02:13.13,0:02:14.56,VKH,Vương,0,0,0,,Được rồi,
Dialogue: 0,0:02:14.56,0:02:17.08,VKH,Vương,0,0,0,,biết là các cậu đều không muốn\N nghe tôi nói chuyện xui xẻo rồi.
Dialogue: 0,0:02:18.62,0:02:22.20,VKH,Vương,0,0,0,,Nhắc mới nhớ, hạch tâm\Ntinh thần lực của cậu là gì?
Dialogue: 0,0:02:24.32,0:02:25.96,DVC,Dụ,0,0,0,,Chủ đề riêng tư như vậy,
Dialogue: 0,0:02:25.96,0:02:27.92,DVC,Dụ,0,0,0,,sao lại chọn thời điểm này để nói chứ?
Dialogue: 0,0:02:29.22,0:02:32.60,VKH,Vương,0,0,0,,Lúc chiến đấu là vì sợ khi\N tác chiến có thể bị tù binh biết,
Dialogue: 0,0:02:32.60,0:02:34.25,VKH,Vương,0,0,0,,khiến cho đám ngoại tộc \Nnắm được điểm yếu.
Dialogue: 0,0:02:38.48,0:02:40.42,VKH,Vương,0,0,0,,Bây giờ thì có gì phải che giấu nữa đâu?
Dialogue: 0,0:02:42.92,0:02:44.77,VKH,Vương,0,0,0,,Tôi chỉ đơn thuần tò mò thôi,
Dialogue: 0,0:02:44.77,0:02:46.96,VKH,Vương,0,0,0,,cũng không nhất định phải biết đâu.
Dialogue: 0,0:02:47.26,0:02:49.74,DVC,Dụ,0,0,0,,Vậy... Anh thử đoán xem?
Dialogue: 0,0:02:51.63,0:02:55.75,VKH,Vương,0,0,0,,Ừm... biển cả... biển cả...
Dialogue: 0,0:02:57.30,0:02:59.13,VKH,Vương,0,0,0,,Bao dung?
Dialogue: 0,0:02:59.45,0:03:02.02,DVC,Dụ,0,0,0,,Mọi người đều đoán như vậy,
Dialogue: 0,0:03:02.02,0:03:03.16,DVC,Dụ,0,0,0,,không gì mới mẻ hết.
Dialogue: 0,0:03:04.02,0:03:07.48,DVC,Dụ,0,0,0,,Hơn nữa thật ra anh có thể\N cảm nhận được là không phải mà.
Dialogue: 0,0:03:10.56,0:03:14.58,VKH,Vương,0,0,0,,Lúc đầu tôi cũng cho rằng hạch tâm tinh thần lực của cậu khá ấm áp,
Dialogue: 0,0:03:15.30,0:03:17.96,VKH,Vương,0,0,0,,nhưng khi cảm nhận được rồi\Nthì hoàn toàn ngược lại.
Dialogue: 0,0:03:20.26,0:03:21.48,VKH,Vương,0,0,0,,Không thể đoán được.
Dialogue: 0,0:03:21.48,0:03:22.78,VKH,Vương,0,0,0,,Cậu cứ nói thẳng đi.
Dialogue: 0,0:03:23.08,0:03:24.52,DVC,Dụ,0,0,0,,Thủy triều lên xuống,
Dialogue: 0,0:03:24.52,0:03:25.84,DVC,Dụ,0,0,0,,qua lại tuần hoàn,
Dialogue: 0,0:03:25.84,0:03:27.36,DVC,Dụ,0,0,0,,mãi không ngừng nghỉ.
Dialogue: 0,0:03:28.48,0:03:32.78,DVC,Dụ,0,0,0,,Hạch tâm tinh thần lực\Ncủa tôi là nguyên tắc.
Dialogue: 0,0:03:35.74,0:03:37.08,VKH,Vương,0,0,0,,Rất bá đạo đấy.
Dialogue: 0,0:03:38.70,0:03:41.80,VKH,Vương,0,0,0,,Nhưng đúng là rất phù hợp với cậu.
Dialogue: 0,0:03:43.20,0:03:44.28,DVC,Dụ,0,0,0,,Còn anh?
Dialogue: 0,0:03:44.28,0:03:46.58,DVC,Dụ,0,0,0,,Ngoài kia ai cũng đoán là biến đổi,
Dialogue: 0,0:03:46.58,0:03:47.88,DVC,Dụ,0,0,0,,rõ ràng không phải rồi.
Dialogue: 0,0:03:57.26,0:03:59.40,VKH,Vương,0,0,0,,Tôi tưởng tôi đã từng nói rồi chứ.
Dialogue: 0,0:03:59.84,0:04:02.78,VKH,Vương,0,0,0,,Cả người vào cửa địa ngục \Ncòn có thể quay về,
Dialogue: 0,0:04:02.78,0:04:05.84,VKH,Vương,0,0,0,,là vì nguồn gốc cốt lõi \Ncủa tôi là sinh mệnh đó.
Dialogue: 0,0:04:07.88,0:04:09.40,VKH,Vương,0,0,0,,Vì vậy cậu đừng có lo lắng quá.
Dialogue: 0,0:04:10.60,0:04:12.62,VKH,Vương,0,0,0,,Tôi không có dễ chết đến vậy đâu.
Dialogue: 0,0:04:17.10,0:04:20.60,VKH,Vương,0,0,0,,Nhìn kìa, tinh thần thể\Ncủa cậu đi chơi về rồi.
Dialogue: 0,0:04:21.80,0:04:23.54,VKH,Vương,0,0,0,,Đúng là nó lớn thật đấy.
Dialogue: 0,0:04:25.18,0:04:29.34,VKH,Vương,0,0,0,,Cho dù là trong trận chiến cũng rất ít khi thấy được bản thể của nó.
Dialogue: 0,0:04:36.04,0:04:37.44,VKH,Vương,0,0,0,,Cậu làm gì vậy?
Dialogue: 0,0:04:39.42,0:04:41.86,VKH,Vương,0,0,0,,Hơn nữa sao con cá voi của cậu lại\Nđột nhiên phun nước vậy.
Dialogue: 0,0:04:42.50,0:04:44.02,DVC,Dụ,0,0,0,,Tôi cũng không biết nữa.
Dialogue: 0,0:04:44.02,0:04:47.34,DVC,Dụ,0,0,0,,Có thể đó là bản năng sau khi kết đôi.
Dialogue: 0,0:04:50.12,0:04:52.84,VKH,Vương,0,0,0,,Chúa lải nhải, ngay cả tôi cũng...
Dialogue: 0,0:04:55.10,0:04:56.98,VKH,Vương,0,0,0,,Đi đi, đi ra thôi.
Dialogue: 0,0:04:58.66,0:05:00.19,VKH,Vương,0,0,0,,Ngoài tranh cảnh này còn cả
Dialogue: 0,0:05:00.19,0:05:02.19,VKH,Vương,0,0,0,,một mớ hỗn độn cần được dọn đấy.
Dialogue: 0,0:05:05.88,0:05:07.88,Default,,0,0,0,,(Trong phòng ngủ)
Dialogue: 0,0:05:07.88,0:05:11.10,DVC,Dụ,0,0,0,,À nói tới, Kiệt Hi anh mới vừa...
Dialogue: 0,0:05:11.10,0:05:12.26,VKH,Vương,0,0,0,,Đừng nói gì hết.
Dialogue: 0,0:05:14.48,0:05:17.05,DVC,Dụ,0,0,0,,Tôi không nghĩ rằng khi\Ntrên giường anh có thể như vậy đó.
Dialogue: 0,0:05:17.05,0:05:18.13,VKH,Vương,0,0,0,,Dừng!!
Dialogue: 0,0:05:18.13,0:05:20.16,DVC,Dụ,0,0,0,,... Ngày đầu tiên anh đã nói \Nvới tôi đừng khách sáo mà.
Dialogue: 0,0:05:21.68,0:05:23.05,VKH,Vương,0,0,0,,...Cậu không khách sáo,
Dialogue: 0,0:05:23.05,0:05:24.61,VKH,Vương,0,0,0,,tôi cảm nhận được rồi.
Dialogue: 0,0:05:24.88,0:05:28.18,DVC,Dụ,0,0,0,,*cười khẩy*
Dialogue: 0,0:05:29.74,0:05:31.39,DVC,Dụ,0,0,0,,Đã làm rối loạn như vậy rồi,
Dialogue: 0,0:05:31.39,0:05:33.55,DVC,Dụ,0,0,0,,chỉ có thể thay ga giường thôi.
Dialogue: 0,0:05:33.55,0:05:35.90,DVC,Dụ,0,0,0,,Anh... còn sức để ngồi dậy không?
Dialogue: 0,0:05:38.94,0:05:40.55,VKH,Vương,0,0,0,,Nói cho cậu nghe vài lời hay,
Dialogue: 0,0:05:40.55,0:05:42.08,VKH,Vương,0,0,0,,cậu còn cho là thật à?
Dialogue: 0,0:05:42.53,0:05:43.84,DVC,Dụ,0,0,0,,À.
Dialogue: 0,0:05:43.84,0:05:47.49,DVC,Dụ,0,0,0,,Vậy nên khi anh vừa khóc \Nvừa nói bản thân không chịu nổi,
Dialogue: 0,0:05:47.49,0:05:48.78,DVC,Dụ,0,0,0,,muốn chết rồi,
Dialogue: 0,0:05:49.22,0:05:51.04,DVC,Dụ,0,0,0,,quả nhiên chỉ là lừa tôi\Nlúc trên giường thôi sao.
Dialogue: 0,0:05:55.02,0:05:56.36,VKH,Vương,0,0,0,,Đổi ga giường của cậu đi.
Dialogue: 0,0:05:56.36,0:05:57.62,VKH,Vương,0,0,0,,Tôi về phòng đây.
Dialogue: 0,0:05:58.79,0:06:00.34,DVC,Dụ,0,0,0,,Lỗ tai đỏ hết rồi kìa.
Dialogue: 0,0:06:00.68,0:06:02.08,DVC,Dụ,0,0,0,,Anh cũng thật là đáng yêu quá rồi.
Dialogue: 0,0:06:08.58,0:06:10.58,Default,,0,0,0,,(Phòng khám của Phương Sĩ Khiêm)
Dialogue: 0,0:06:10.58,0:06:12.40,PSK,Phương,0,0,0,,Tình hình nằm trong phạm vi dự kiến.
Dialogue: 0,0:06:13.86,0:06:15.74,PSK,Phương,0,0,0,,Dùng việc kết đôi để \Ncan thiệp vào điều trị.
Dialogue: 0,0:06:15.74,0:06:17.87,PSK,Phương,0,0,0,,Thực chất là dẫn dụ \Ncác kích thích bên ngoài.
Dialogue: 0,0:06:17.87,0:06:19.94,PSK,Phương,0,0,0,,Dù là về mặt thể chất hay là tâm lí
Dialogue: 0,0:06:20.00,0:06:22.68,PSK,Phương,0,0,0,,đều có ý nghĩa là xáo trộn lần nữa.
Dialogue: 0,0:06:22.68,0:06:24.80,PSK,Phương,0,0,0,,Có trường hợp có hiệu quả rất tốt,
Dialogue: 0,0:06:24.80,0:06:27.08,PSK,Phương,0,0,0,,cũng có tình huống\Nkhông có gì thay đổi cả.
Dialogue: 0,0:06:27.54,0:06:28.92,PSK,Phương,0,0,0,,Nhưng hiện nay xem ra,
Dialogue: 0,0:06:28.92,0:06:32.16,PSK,Phương,0,0,0,,số liệu cơ thể của cậu đã xuất hiện những dao động có cường độ khác nhau.
Dialogue: 0,0:06:32.16,0:06:34.36,PSK,Phương,0,0,0,,ít nhất nói rõ rằng điều này có hiệu quả.
Dialogue: 0,0:06:34.41,0:06:35.55,VKH,Vương,0,0,0,,Ờ.
Dialogue: 0,0:06:36.72,0:06:38.87,PSK,Phương,0,0,0,,Độ xứng đôi của hai cậu\Nvẫn còn quá thấp,
Dialogue: 0,0:06:38.87,0:06:41.40,PSK,Phương,0,0,0,,vậy nên muốn có hiệu quả \Nnhanh chóng là không thể.
Dialogue: 0,0:06:43.44,0:06:45.44,PSK,Phương,0,0,0,,Vẫn phải kiên trì lâu dài nữa.
Dialogue: 0,0:06:45.44,0:06:47.82,PSK,Phương,0,0,0,,E rằng việc cậu phát bệnh \Nlà không thể tránh khỏi.
Dialogue: 0,0:06:48.28,0:06:52.30,PSK,Phương,0,0,0,,Nhưng sau này đến một lúc nào đó, bệnh tình sẽ ngừng chuyển biến xấu,
Dialogue: 0,0:06:52.30,0:06:53.38,PSK,Phương,0,0,0,,rồi chuyển biến tốt lên.
Dialogue: 0,0:06:53.38,0:06:55.38,PSK,Phương,0,0,0,,Cậu đừng quá lo lắng.
Dialogue: 0,0:06:55.77,0:06:57.50,VKH,Vương,0,0,0,,Tôi không lo lắng.
Dialogue: 0,0:06:57.50,0:07:00.38,VKH,Vương,0,0,0,,Tôi đã chuẩn bị tâm lí đầy đủ rồi.
Dialogue: 0,0:07:00.38,0:07:01.65,VKH,Vương,0,0,0,,Trái lại tôi cảm thấy
Dialogue: 0,0:07:01.65,0:07:04.73,VKH,Vương,0,0,0,,anh và Dụ Văn Châu đừng\Nquá lo lắng mới đúng.
Dialogue: 0,0:07:06.45,0:07:07.38,PSK,Phương,0,0,0,,Được rồi.
Dialogue: 0,0:07:09.18,0:07:10.22,PSK,Phương,0,0,0,,Cậu cảm thấy thế nào?
Dialogue: 0,0:07:11.24,0:07:12.44,VKH,Vương,0,0,0,,Cái gì mà cảm thấy thế nào?
Dialogue: 0,0:07:12.44,0:07:14.00,PSK,Phương,0,0,0,,Cảm giác sau khi kết đôi đó.
Dialogue: 0,0:07:14.18,0:07:15.80,PSK,Phương,0,0,0,,Tâm trạng có biến đổi gì không?
Dialogue: 0,0:07:17.06,0:07:19.58,VKH,Vương,0,0,0,,Tôi còn cho rằng anh muốn hỏi chúng tôi lên giường như thế nào.
Dialogue: 0,0:07:19.58,0:07:21.30,PSK,Phương,0,0,0,,À cái đó thì...
Dialogue: 0,0:07:21.30,0:07:23.23,PSK,Phương,0,0,0,,Dụ Văn Châu điền vào bảng câu hỏi rồi.
Dialogue: 0,0:07:23.23,0:07:25.60,PSK,Phương,0,0,0,,Loại câu hỏi này muốn\Nphát ra từ miệng của cậu,
Dialogue: 0,0:07:25.60,0:07:26.92,PSK,Phương,0,0,0,,nhất định là khó hơn lên trời.
Dialogue: 0,0:07:26.92,0:07:28.39,PSK,Phương,0,0,0,,Từ khi bắt đầu tôi đã không trông chờ gì rồi.
Dialogue: 0,0:07:28.39,0:07:29.64,VKH,Vương,0,0,0,,Rất thẳng thắn.
Dialogue: 0,0:07:30.47,0:07:33.84,VKH,Vương,0,0,0,,Sau khi cùng đạt cực khoái, thế giới tinh thần đã hòa hợp với nhau.
Dialogue: 0,0:07:33.84,0:07:35.45,VKH,Vương,0,0,0,,Quá trình rất thuận lợi.
Dialogue: 0,0:07:35.45,0:07:36.35,PSK,Phương,0,0,0,,Cậu...
Dialogue: 0,0:07:36.35,0:07:39.20,VKH,Vương,0,0,0,,Tôi sợ anh nghi ngờ lời kể \Nđơn phương từ Dụ Văn Châu
Dialogue: 0,0:07:39.20,0:07:41.20,VKH,Vương,0,0,0,,sẽ có sai lệch nhưng lại không dám hỏi.
Dialogue: 0,0:07:41.20,0:07:43.06,VKH,Vương,0,0,0,,Vì vậy tôi giúp anh xác nhận một chút.
Dialogue: 0,0:07:43.06,0:07:44.68,VKH,Vương,0,0,0,,Anh đừng có nghĩ nhiều.
Dialogue: 0,0:07:47.28,0:07:49.20,PSK,Phương,0,0,0,,Khá lắm, khá lắm.
Dialogue: 0,0:07:49.20,0:07:51.33,PSK,Phương,0,0,0,,Cậu thật sự có bản lĩnh đấy.
Dialogue: 0,0:07:51.33,0:07:52.62,PSK,Phương,0,0,0,,Mặt không đỏ, tim không loạn.
Dialogue: 0,0:07:52.62,0:07:55.30,PSK,Phương,0,0,0,,Phải nói quả nhiên là gần mực thì đen.
Dialogue: 0,0:07:56.68,0:07:58.03,VKH,Vương,0,0,0,,Nếu là về tâm trạng,
Dialogue: 0,0:07:58.03,0:08:00.89,VKH,Vương,0,0,0,,anh là muốn hóng hớt\N hay là muốn thẩm vấn?
Dialogue: 0,0:08:00.93,0:08:02.40,PSK,Phương,0,0,0,,Đều muốn cả?
Dialogue: 0,0:08:02.40,0:08:05.27,VKH,Vương,0,0,0,,Kết đôi hẳn là đều như vậy.
Dialogue: 0,0:08:06.59,0:08:08.46,VKH,Vương,0,0,0,,Tôi không cảm thấy \Nsự thay đổi nào quá lớn,
Dialogue: 0,0:08:10.06,0:08:12.35,VKH,Vương,0,0,0,,Thấy cái ngôi giữa của Dụ Văn Châu \Nthuận mắt hơn chút rồi,
Dialogue: 0,0:08:13.30,0:08:15.36,VKH,Vương,0,0,0,,có gọi là thay đổi không?
Dialogue: 0,0:08:15.36,0:08:19.20,PSK,Phương,0,0,0,,Cậu không cảm thấy bản thân \Ncó một chút rung động nào sao?
Dialogue: 0,0:08:19.78,0:08:22.38,PSK,Phương,0,0,0,,Có cảm giác an toàn với cậu ấy?\N Và cảm giác ỷ lại?
Dialogue: 0,0:08:23.46,0:08:26.25,PSK,Phương,0,0,0,,Hoặc là tâm lí kì lạ của cậu\N nảy sinh ý thức trách nhiệm?
Dialogue: 0,0:08:26.71,0:08:28.60,VKH,Vương,0,0,0,,Ừm...
Dialogue: 0,0:08:30.76,0:08:34.08,VKH,Vương,0,0,0,,Lính gác và dẫn đường khác\N sau khi kết đôi sẽ như vậy hả?
Dialogue: 0,0:08:35.22,0:08:36.40,PSK,Phương,0,0,0,,Làm sao tôi biết được chứ?
Dialogue: 0,0:08:36.40,0:08:38.38,PSK,Phương,0,0,0,,Tôi vẫn còn là tiểu tinh linh tự do.
Dialogue: 0,0:08:39.64,0:08:42.62,PSK,Phương,0,0,0,,Nhưng mà theo số liệu \Nkhảo sát thì là như vậy.
Dialogue: 0,0:08:43.74,0:08:46.40,VKH,Vương,0,0,0,,Trước mắt, dường như tôi\Nkhông có cảm giác gì,
Dialogue: 0,0:08:46.48,0:08:49.12,VKH,Vương,0,0,0,,nhưng nói không chừng từ từ sẽ có.
Dialogue: 0,0:08:50.30,0:08:52.30,VKH,Vương,0,0,0,,Đợi đến khi tôi cảm nhận\Nđược sự thay đổi,
Dialogue: 0,0:08:52.30,0:08:54.64,VKH,Vương,0,0,0,,có thể sẽ báo cáo cho anh.
Dialogue: 0,0:08:56.45,0:08:58.19,PSK,Phương,0,0,0,,Sao nhanh như vậy\Ncậu đã muốn đi rồi?
Dialogue: 0,0:08:59.21,0:09:00.15,VKH,Vương,0,0,0,,Sao nữa?
Dialogue: 0,0:09:00.16,0:09:02.83,VKH,Vương,0,0,0,,Lúc bình thường anh toàn chê \Ntôi lãng phí thời gian của anh.
Dialogue: 0,0:09:02.83,0:09:04.67,VKH,Vương,0,0,0,,Hôm nay tôi cút đi sớm một chút,
Dialogue: 0,0:09:04.67,0:09:06.53,VKH,Vương,0,0,0,,anh lại bày ra dáng vẻ không muốn.
Dialogue: 0,0:09:07.79,0:09:11.08,VKH,Vương,0,0,0,,Anh đây là ngại không đủ tích cực chăm sóc bệnh nhân à, bác sĩ Phương?
Dialogue: 0,0:09:11.16,0:09:12.28,PSK,Phương,0,0,0,,Nhanh cút đi.
Dialogue: 0,0:09:12.28,0:09:14.14,PSK,Phương,0,0,0,,Vốn dĩ muốn mời cậu ăn một bữa,
Dialogue: 0,0:09:14.14,0:09:18.72,PSK,Phương,0,0,0,,suy cho cùng cũng không biết cậu có thể cử động miệng và lưỡi ăn bao nhiêu bữa nữa.
Dialogue: 0,0:09:19.54,0:09:20.46,VKH,Vương,0,0,0,,Thật không may,
Dialogue: 0,0:09:20.46,0:09:22.20,VKH,Vương,0,0,0,,hôm nay tôi không rảnh.
Dialogue: 0,0:09:22.20,0:09:24.45,VKH,Vương,0,0,0,,Tôi muốn nhanh đi chợ mua cá.
Dialogue: 0,0:09:24.45,0:09:26.97,VKH,Vương,0,0,0,,Lần trước Dụ Văn Châu \Nnấu món cá vô cùng ngon.
Dialogue: 0,0:09:26.97,0:09:29.13,VKH,Vương,0,0,0,,Cậu ấy đã đưa cho tôi\N công thức và gia vị.
Dialogue: 0,0:09:29.13,0:09:31.14,VKH,Vương,0,0,0,,Tôi muốn thử tự mình làm.
Dialogue: 0,0:09:35.50,0:09:36.42,VKH,Vương,0,0,0,,Anh muốn đến không?
Dialogue: 0,0:09:38.04,0:09:40.90,VKH,Vương,0,0,0,,Đoán chừng Dụ Văn Châu \Ncũng sẽ không để ý.
Dialogue: 0,0:09:40.90,0:09:43.69,VKH,Vương,0,0,0,,Hay là anh với tôi cùng nhau về ăn đi.
Dialogue: 0,0:09:45.68,0:09:47.82,PSK,Phương,0,0,0,,Không... không cần đâu.
Dialogue: 0,0:09:47.82,0:09:49.20,PSK,Phương,0,0,0,,Cút đi cút đi.
Dialogue: 0,0:09:49.20,0:09:51.40,PSK,Phương,0,0,0,,Tôi tăng ca chăm sóc cho bệnh nhân
Dialogue: 0,0:09:58.60,0:10:01.92,Default,GT,0,0,0,,Nguyên tác: Nguyệt Bán Viên, \N Sản xuất bởi Hugyiyi Studio
Dialogue: 0,0:10:03.36,0:10:08.28,Default,GT,0,0,0,,Kịch truyền thanh 《Breaking Dawn》\N Dụ Vương đồng nhân 《Toàn Chức Cao Thủ》
Dialogue: 0,0:10:10.80,0:10:13.78,Vi Thảo,Cao,0,0,0,,Cao Anh Kiệt: Tiền bối Phương, \Nđội trưởng anh ấy...
Dialogue: 0,0:10:13.78,0:10:18.54,Vi Thảo,Cao,0,0,0,,khi nào anh ấy mới có thể tỉnh lại?
Dialogue: 0,0:10:41.00,0:10:43.60,Vi Thảo,Cao,0,0,0,,Biểu hiện đột nhiên tái phát bệnh của đội trưởng là như vậy sao?
Dialogue: 0,0:10:43.60,0:10:45.08,Vi Thảo,Cao,0,0,0,,Không có gì khác thường hết?
Dialogue: 0,0:10:45.08,0:10:47.54,Vi Thảo,Cao,0,0,0,,Cứ để cho anh ấy nằm \Nnhư vậy không sao chứ?
Dialogue: 0,0:10:47.54,0:10:49.22,Vi Thảo,Cao,0,0,0,,Cần có biện pháp nào khác không?
Dialogue: 0,0:10:49.22,0:10:50.66,Vi Thảo,Hứa,0,0,0,,Hứa Bân: Đoán chừng là\N phải xem xét thêm.
Dialogue: 0,0:10:50.66,0:10:52.38,Vi Thảo,Hứa,0,0,0,,Xem có thể tỉnh dậy \Ntrong thời gian ngắn không.
Dialogue: 0,0:10:52.38,0:10:54.30,Vi Thảo,Hứa,0,0,0,,Vẫn luôn mất tri giác,
Dialogue: 0,0:10:55.08,0:10:58.06,Vi Thảo,Hứa,0,0,0,,có lẽ là phải tiêm dịch dinh dưỡng rồi.
Dialogue: 0,0:10:58.06,0:10:59.19,PSK,Phương,0,0,0,,Phương Sĩ Khiêm: Không cần đâu...
Dialogue: 0,0:10:59.19,0:11:00.56,PSK,Phương,0,0,0,,Cậu ấy đã tỉnh rồi...
Dialogue: 0,0:11:06.34,0:11:06.95,Vi Thảo,Cao,0,0,0,,Cao: Đội rưởng!
Dialogue: 0,0:11:06.95,0:11:08.55,Vi Thảo,Hứa,0,0,0,,Hứa: Đội trưởng, cảm thấy thế nào rồi?
Dialogue: 0,0:11:12.68,0:11:13.84,VKH,Vương,0,0,0,,Tôi ổn rồi.
Dialogue: 0,0:11:13.84,0:11:15.14,VKH,Vương,0,0,0,,Mọi người yên tâm đi.
Dialogue: 0,0:11:19.64,0:11:20.50,PSK,Phương,0,0,0,,Phương: Nói đi!
Dialogue: 0,0:11:22.30,0:11:23.66,VKH,Vương,0,0,0,,Tôi không sao.
Dialogue: 0,0:11:25.54,0:11:27.86,PSK,Phương,0,0,0,,Cậu cảm thấy bản thân\N phát bệnh vào lúc nào?
Dialogue: 0,0:11:29.08,0:11:31.20,VKH,Vương,0,0,0,,Có lẽ là vào 2 giờ 15 phút chiều.
Dialogue: 0,0:11:32.38,0:11:34.32,PSK,Phương,0,0,0,,Xác nhận chứ?
Dialogue: 0,0:11:34.32,0:11:35.69,VKH,Vương,0,0,0,,Xác nhận cơ bản thôi.
Dialogue: 0,0:11:35.69,0:11:38.12,VKH,Vương,0,0,0,,Tôi lúc 2 giờ chiều ngủ dậy,
Dialogue: 0,0:11:38.12,0:11:39.84,VKH,Vương,0,0,0,,chuẩn bị làm một ít cookie,
Dialogue: 0,0:11:40.22,0:11:41.18,VKH,Vương,0,0,0,,tra công thức xong,
Dialogue: 0,0:11:41.18,0:11:42.23,VKH,Vương,0,0,0,,vừa đập 2 quả trứng
Dialogue: 0,0:11:42.23,0:11:43.52,VKH,Vương,0,0,0,,thì trước mắt bỗng đen kịt.
Dialogue: 0,0:11:44.18,0:11:47.02,VKH,Vương,0,0,0,,Đoán chừng quá trình này \Nchỉ diễn ra trong 15 phút.
Dialogue: 0,0:11:48.66,0:11:50.39,VKH,Vương,0,0,0,,Khi có lại ý thức
Dialogue: 0,0:11:50.39,0:11:53.22,VKH,Vương,0,0,0,,thì đã ở vách đá trong \N thế giới tinh thần ngắm biển rồi.
Dialogue: 0,0:11:55.20,0:11:56.35,PSK,Phương,0,0,0,,Cũng xấp xỉ.
Dialogue: 0,0:11:56.35,0:11:58.25,VKH,Vương,0,0,0,,Cái gì xấp xỉ??
Dialogue: 0,0:11:58.25,0:12:00.95,PSK,Phương,0,0,0,,Với thời gian nhận tin \Nliên lạc của chúng tôi.
Dialogue: 0,0:12:00.95,0:12:02.85,PSK,Phương,0,0,0,,Phương: Cơ thể cậu có chỗ nào có chịu không?
Dialogue: 0,0:12:00.95,0:12:02.85,VKH,Vương,0,0,0,,[À...là cậu ấy]
Dialogue: 0,0:12:03.03,0:12:06.11,PSK,Phương,0,0,0,,Thời gian cảm thể* trong thế giới\Ntinh thần là bao lâu?
Dialogue: 0,0:12:03.03,0:12:06.11,Chú thích,GT,0,0,0,,*cảm giác thể chất
Dialogue: 0,0:12:06.11,0:12:08.20,PSK,Phương,0,0,0,,Trong thế giới đó cậu có\Ncảm nhận được thực tế
Dialogue: 0,0:12:06.11,0:12:08.20,VKH,Phương,0,0,0,,[Cậu ấy không đến à...]
Dialogue: 0,0:12:08.25,0:12:11.58,PSK,Phương,0,0,0,,hay là người nào khác không?
Dialogue: 0,0:12:11.58,0:12:12.47,PSK,Phương,0,0,0,,Được rồi.
Dialogue: 0,0:12:12.47,0:12:14.09,PSK,Phương,0,0,0,,Trước mắt cậu ấy\Nkhông có vấn đề gì lớn.
Dialogue: 0,0:12:14.09,0:12:15.98,PSK,Phương,0,0,0,,Đội phó Hứa, trước hết \Ncác cậu trở về đi.
Dialogue: 0,0:12:15.98,0:12:18.13,Vi Thảo,Cao,0,0,0,,Cao: Đội trưởng... thật sự không sao chứ?\NHứa: Được thôi.
Dialogue: 0,0:12:18.14,0:12:20.58,Vi Thảo,Hứa,0,0,0,,Hứa: Phương thần, vậy tôi và Anh Kiệt \Ntrở về quân khu đây.
Dialogue: 0,0:12:20.74,0:12:23.05,Vi Thảo,Hứa,0,0,0,,Đội trưởng, anh phải chú ý thân thể nha.
Dialogue: 0,0:12:23.05,0:12:24.38,VKH,Vương,0,0,0,,Tôi không sao.
Dialogue: 0,0:12:24.38,0:12:26.00,VKH,Vương,0,0,0,,Các cậu đừng lo quá,
Dialogue: 0,0:12:26.00,0:12:27.92,VKH,Vương,0,0,0,,nói với mọi người cũng đừng nên lo lắng.
Dialogue: 0,0:12:27.92,0:12:28.58,Vi Thảo,Cao,0,0,0,,Cao: Vâng.
Dialogue: 0,0:12:34.92,0:12:35.42,VKH,Vương,0,0,0,,Nói đi.
Dialogue: 0,0:12:38.30,0:12:39.44,VKH,Vương,0,0,0,,Rất nghiêm trọng hả?
Dialogue: 0,0:12:40.78,0:12:42.53,PSK,Phương,0,0,0,,Phương: Khó nói.
Dialogue: 0,0:12:43.63,0:12:46.08,PSK,Phương,0,0,0,,Từ tình huống phát bệnh\Nmà cậu kể lại cho thấy,
Dialogue: 0,0:12:46.08,0:12:48.33,PSK,Phương,0,0,0,,đây thuộc trường hợp khá hiếm gặp.
Dialogue: 0,0:12:49.31,0:12:52.90,PSK,Phương,0,0,0,,Đa số trường hợp việc mất đi năm giác quan đều cần có một quá trình để phát triển,
Dialogue: 0,0:12:52.90,0:12:56.81,PSK,Phương,0,0,0,,sẽ có một hoặc nhiều giác\Nquan từng bước suy kiệt,
Dialogue: 0,0:12:56.81,0:12:59.16,PSK,Phương,0,0,0,,sau đó mới từ từ hoàn toàn mất đi.
Dialogue: 0,0:12:59.86,0:13:03.48,PSK,Phương,0,0,0,,Giống như thính giác của Hoàng Thiếu Thiên \Ncũng từ lãng tai cho đến có nhiều tạp âm,
Dialogue: 0,0:13:03.60,0:13:05.84,PSK,Phương,0,0,0,,sau đó dần dần không \Ncòn nghe thấy gì nữa.
Dialogue: 0,0:13:05.84,0:13:07.90,PSK,Phương,0,0,0,,Cho đến khi từ giác quan \Nnhạy bén của linh gác,
Dialogue: 0,0:13:07.90,0:13:09.93,PSK,Phương,0,0,0,,giảm đến mức thấp hơn cả người thường.
Dialogue: 0,0:13:10.96,0:13:12.63,PSK,Phương,0,0,0,,Nhưng tình huống của cậu,
Dialogue: 0,0:13:12.63,0:13:14.78,PSK,Phương,0,0,0,,giống như là...
Dialogue: 0,0:13:14.78,0:13:16.53,VKH,Vương,0,0,0,,Anh mất trí rồi à.
Dialogue: 0,0:13:16.94,0:13:18.49,VKH,Vương,0,0,0,,Không phải như vậy rất tốt sao?
Dialogue: 0,0:13:18.49,0:13:20.00,VKH,Vương,0,0,0,,Đừng dày vò người khác,
Dialogue: 0,0:13:20.00,0:13:22.56,VKH,Vương,0,0,0,,tôi không muốn trải nghiệm\Nviệc dần không nhìn thấy
Dialogue: 0,0:13:22.64,0:13:24.36,VKH,Vương,0,0,0,,hoặc là quá trình không thể đi lại.
Dialogue: 0,0:13:24.48,0:13:25.63,PSK,Phương,0,0,0,,Nhưng mà có quá trình
Dialogue: 0,0:13:25.63,0:13:27.90,PSK,Phương,0,0,0,,ít nhất có thể có không gian\N cho việc điều chỉnh trị liệu.
Dialogue: 0,0:13:28.60,0:13:29.88,PSK,Phương,0,0,0,,Tình huống vừa rồi của cậu,
Dialogue: 0,0:13:29.88,0:13:31.41,PSK,Phương,0,0,0,,tôi đã tiến hành giám sát cơ bản.
Dialogue: 0,0:13:31.41,0:13:33.75,PSK,Phương,0,0,0,,Dấu hiệu sinh tồn \Nhoàn toàn bình thường,
Dialogue: 0,0:13:33.75,0:13:36.72,PSK,Phương,0,0,0,,nhưng không cảm \Nnhận được tinh thần lực.
Dialogue: 0,0:13:36.72,0:13:37.65,PSK,Phương,0,0,0,,Tưởng chừng như là...
Dialogue: 0,0:13:37.65,0:13:39.20,VKH,Vương,0,0,0,,Như một người bình thường?
Dialogue: 0,0:13:40.93,0:13:42.90,VKH,Vương,0,0,0,,Tôi ở trong thế giới\Ntinh thần của chính mình,
Dialogue: 0,0:13:42.90,0:13:45.41,VKH,Vương,0,0,0,,cũng có cảm giác như vậy.
Dialogue: 0,0:13:45.41,0:13:47.28,VKH,Vương,0,0,0,,Không thể cảm nhận\Nđược tinh thần lực,
Dialogue: 0,0:13:48.01,0:13:51.04,VKH,Vương,0,0,0,,cũng không cảm nhận được\N kết nối của mình với bên ngoài.
Dialogue: 0,0:13:51.37,0:13:53.44,VKH,Vương,0,0,0,,Nó giống như đổi sang\Nthế giới khác vậy.
Dialogue: 0,0:13:53.46,0:13:55.64,VKH,Vương,0,0,0,,Giác quan hoàn toàn đóng chặt lại.
Dialogue: 0,0:13:58.90,0:14:00.63,PSK,Phương,0,0,0,,Thật ra từ ngoài nhìn vào,
Dialogue: 0,0:14:01.16,0:14:03.96,PSK,Phương,0,0,0,,cậu lại càng giống như một con robot chưa được ấn nút khởi động.
Dialogue: 0,0:14:05.02,0:14:09.40,VKH,Vương,0,0,0,,Ừm, vậy là tôi tự khép \Nmình trong nửa giờ à?
Dialogue: 0,0:14:10.54,0:14:11.28,PSK,Phương,0,0,0,,Gần như vậy.
Dialogue: 0,0:14:12.48,0:14:15.33,PSK,Phương,0,0,0,,Nhưng sau này có lẽ tần suất \Nphát sinh của trạng thái này
Dialogue: 0,0:14:15.33,0:14:16.98,PSK,Phương,0,0,0,,và thời gian duy trì đều sẽ tăng lên.
Dialogue: 0,0:14:17.40,0:14:19.53,PSK,Phương,0,0,0,,Nếu như điều trị can thiệp \Nkhông có hiệu quả,
Dialogue: 0,0:14:19.53,0:14:21.93,PSK,Phương,0,0,0,,có thể là lần sau khi\Ncậu bị mất ý thức
Dialogue: 0,0:14:21.93,0:14:23.25,PSK,Phương,0,0,0,,sẽ không thể tỉnh lại được nữa.
Dialogue: 0,0:14:26.37,0:14:28.80,VKH,Vương,0,0,0,,Anh đây là đang củng cố\N tinh thần cho tôi?
Dialogue: 0,0:14:30.53,0:14:32.48,VKH,Vương,0,0,0,,Tôi rất là lạc quan yêu đời.
Dialogue: 0,0:14:32.48,0:14:34.40,VKH,Vương,0,0,0,,Người nào rồi cũng sẽ chết mà,
Dialogue: 0,0:14:34.40,0:14:38.34,VKH,Vương,0,0,0,,cho dù là lính gác và dẫn đường\N có tinh thần lực cũng vậy thôi.
Dialogue: 0,0:14:39.28,0:14:41.15,VKH,Vương,0,0,0,,Tôi cảm thấy cả đời này của tôi,
Dialogue: 0,0:14:41.15,0:14:43.46,VKH,Vương,0,0,0,,những việc mà tôi muốn \Nlàm đều đã làm được rồi.
Dialogue: 0,0:14:43.46,0:14:45.26,VKH,Vương,0,0,0,,Thậm chí đã làm rất nhiều lần.
Dialogue: 0,0:14:45.26,0:14:47.38,VKH,Vương,0,0,0,,Từng cho rằng sẽ không thấy \Nđược thời kỳ hòa bình,
Dialogue: 0,0:14:47.38,0:14:48.90,VKH,Vương,0,0,0,,cũng đã thấy được rồi.
Dialogue: 0,0:14:49.64,0:14:52.03,VKH,Vương,0,0,0,,Mặc dù căn bệnh này khiến \Nngười khác cảm thấy xui xẻo
Dialogue: 0,0:14:52.22,0:14:56.12,VKH,Vương,0,0,0,,nhưng may mà hiện tại ngay \Ncả quá trình đau khổ cũng ít đi rồi.
Dialogue: 0,0:14:56.50,0:14:58.12,VKH,Vương,0,0,0,,Khi khép mình lại,
Dialogue: 0,0:14:58.12,0:15:00.61,VKH,Vương,0,0,0,,tôi chỉ ở trong thế giới\N tinh thần của bản thân.
Dialogue: 0,0:15:00.61,0:15:04.36,VKH,Vương,0,0,0,,Khi bảo tôi ra ngoài thì tiếp tục\N trải qua cuộc sống thường ngày.
Dialogue: 0,0:15:04.54,0:15:06.35,VKH,Vương,0,0,0,,Một ngày xem như là một ngày,
Dialogue: 0,0:15:06.35,0:15:08.15,VKH,Vương,0,0,0,,cũng không có gì không tốt cả.
Dialogue: 0,0:15:08.15,0:15:10.03,VKH,Vương,0,0,0,,Thật đó.
Dialogue: 0,0:15:10.03,0:15:12.11,PSK,Phương,0,0,0,,Này... không phải đã đồng ý...
Dialogue: 0,0:15:12.11,0:15:13.28,VKH,Vương,0,0,0,,Dụ Văn Châu đâu?
Dialogue: 0,0:15:13.28,0:15:15.18,VKH,Vương,0,0,0,,Không phải nói là đến thăm tôi hả?
Dialogue: 0,0:15:15.28,0:15:16.78,PSK,Phương,0,0,0,,Cậu ta đang họp.
Dialogue: 0,0:15:16.78,0:15:17.86,PSK,Phương,0,0,0,,Cậu muốn đợi cậu ta không?
Dialogue: 0,0:15:19.72,0:15:20.74,VKH,Vương,0,0,0,,Đương nhiên không rồi.
Dialogue: 0,0:15:21.34,0:15:22.68,VKH,Vương,0,0,0,,Cậu ấy cũng không nói là muốn đến.
Dialogue: 0,0:15:22.80,0:15:24.44,VKH,Vương,0,0,0,,Sao lại phải đợi?
Dialogue: 0,0:15:24.78,0:15:26.01,VKH,Vương,0,0,0,,Bây giờ tôi ổn rồi.
Dialogue: 0,0:15:26.01,0:15:28.16,VKH,Vương,0,0,0,,Nhất định cậu ấy sẽ cảm nhận được.
Dialogue: 0,0:15:28.28,0:15:29.04,PSK,Phương,0,0,0,,Ừm.
Dialogue: 0,0:15:30.90,0:15:33.06,PSK,Phương,0,0,0,,Vừa nãy khi cậu ở trong thế giới tinh thần,
Dialogue: 0,0:15:33.06,0:15:36.12,PSK,Phương,0,0,0,,phần thuộc về Dụ Văn Châu\N có thay đổi gì không?
Dialogue: 0,0:15:37.56,0:15:40.22,VKH,Vương,0,0,0,,Có, phản ứng của \Ncảnh vật trong đó yếu đi.
Dialogue: 0,0:15:41.24,0:15:46.88,PSK,Phương,0,0,0,,Vì khi cậu phát bệnh tương đương \Nvới việc tạm thời mất kết nối.
Dialogue: 0,0:15:47.66,0:15:49.54,PSK,Phương,0,0,0,,... Không có dấu hiệu\Nbiến mất là tốt rồi.
Dialogue: 0,0:15:49.54,0:15:52.30,PSK,Phương,0,0,0,,Sau này... sau này quan sát lại đi.
Dialogue: 0,0:15:52.96,0:15:54.88,VKH,Vương,0,0,0,,Được rồi, đừng lo lắng nữa.
Dialogue: 0,0:15:55.92,0:15:57.74,PSK,Phương,0,0,0,,Sao lại có thể không lo lắng được!
Dialogue: 0,0:15:57.74,0:15:59.21,PSK,Phương,0,0,0,,Nếu như tôi là người sắp chết,
Dialogue: 0,0:15:59.21,0:16:00.35,PSK,Phương,0,0,0,,cậu có lo lắng hay không?
Dialogue: 0,0:16:00.35,0:16:01.58,VKH,Vương,0,0,0,,Tôi...
Dialogue: 0,0:16:04.84,0:16:06.03,VKH,Vương,0,0,0,,Được rồi, được rồi.
Dialogue: 0,0:16:06.03,0:16:07.50,VKH,Vương,0,0,0,,Có bộ quần áo nào không cho tôi mượn?
Dialogue: 0,0:16:08.52,0:16:09.83,VKH,Vương,0,0,0,,Còn nữa, sau này,
Dialogue: 0,0:16:09.83,0:16:12.61,VKH,Vương,0,0,0,,nếu như sau này các anh \Nkhiêng tôi ra ngoài như vậy,
Dialogue: 0,0:16:12.61,0:16:15.97,VKH,Vương,0,0,0,,làm ơn mặc cho tôi cái áo khoác \Nở phòng ngủ thứ 2 bên trái.
Dialogue: 0,0:16:15.97,0:16:17.59,VKH,Vương,0,0,0,,Đừng có để lộ đồ ngủ của tôi.
Dialogue: 0,0:16:17.59,0:16:20.46,VKH,Vương,0,0,0,,Cảm ơn nhiều.
Dialogue: 0,0:16:35.00,0:16:37.00,Default,,0,0,0,,(Trường bắn)
Dialogue: 0,0:16:37.00,0:16:40.90,Default,hệ thống,0,0,0,,Kết thúc bắn, cấp bậc: S0
Dialogue: 0,0:16:41.40,0:16:44.64,Default,hệ thống,0,0,0,,Tỉ số: 985
Dialogue: 0,0:16:44.64,0:16:46.78,Default,hệ thống,0,0,0,,Mời ghi nhận kỷ lục.
Dialogue: 0,0:16:48.14,0:16:49.60,VKH,Vương,0,0,0,,Sao cậu lại đến sân huấn luyện?
Dialogue: 0,0:16:49.75,0:16:51.28,DVC,Dụ,0,0,0,,Đến thăm anh.
Dialogue: 0,0:16:51.28,0:16:52.90,DVC,Dụ,0,0,0,,Vừa mới liên lạc với bệnh viện,
Dialogue: 0,0:16:52.90,0:16:54.58,DVC,Dụ,0,0,0,,Họ nói anh đã đi rồi.
Dialogue: 0,0:16:57.68,0:16:59.73,VKH,Vương,0,0,0,,Tôi vẫn ổn, đừng lo.
Dialogue: 0,0:17:02.50,0:17:05.60,VKH,Vương,0,0,0,,Nhưng mà tôi thật sự \Nđã nói câu này nhiều rồi.
Dialogue: 0,0:17:05.60,0:17:06.92,VKH,Vương,0,0,0,,Sau này cậu tự mình \Ncảm nhận một chút,
Dialogue: 0,0:17:06.92,0:17:09.32,VKH,Vương,0,0,0,,về phần cậu tôi có thể \Nlược bớt không cần nói nữa.
Dialogue: 0,0:17:10.80,0:17:13.05,DVC,Dụ,0,0,0,,Tôi biết tình trạng của anh ổn rồi.
Dialogue: 0,0:17:13.05,0:17:16.90,DVC,Dụ,0,0,0,,Chuyển động đạt 985, điểm cấp bậc S0.
Dialogue: 0,0:17:17.18,0:17:20.60,DVC,Dụ,0,0,0,,Nhìn thế nào cũng thấy anh đang trong trạng thái đỉnh cao nhỉ đội trưởng Vương.
Dialogue: 0,0:17:23.22,0:17:24.56,VKH,Vương,0,0,0,,Lần cuối nghe cậu gọi tôi như vậy
Dialogue: 0,0:17:24.56,0:17:27.48,VKH,Vương,0,0,0,,có lẽ là lúc làm nhiệm vụ liên hợp nhỉ.
Dialogue: 0,0:17:28.84,0:17:31.06,VKH,Vương,0,0,0,,Cảm giác như đã lâu lắm rồi.
Dialogue: 0,0:17:32.80,0:17:34.56,DVC,Dụ,0,0,0,,Bây giờ đã là cấp bậc quân hàm,
Dialogue: 0,0:17:34.56,0:17:36.42,DVC,Dụ,0,0,0,,những lần lên giọng\Ntrách mắng đã quá nhiều rồi,
Dialogue: 0,0:17:36.42,0:17:39.78,DVC,Dụ,0,0,0,,có chút nhớ về khi còn\Nphân công chiến đấu tương xứng.
Dialogue: 0,0:17:42.40,0:17:44.43,VKH,Vương,0,0,0,,Phải đó, đội trưởng Dụ.
Dialogue: 0,0:17:44.68,0:17:49.02,DVC,Dụ,0,0,0,,Kỷ lục cao nhất của anh là bao nhiêu?
Dialogue: 0,0:17:49.02,0:17:51.80,VKH,Vương,0,0,0,,Tôi tưởng rằng dữ liệu cơ bản \Nvề những lính gác của chúng tôi
Dialogue: 0,0:17:51.80,0:17:54.10,VKH,Vương,0,0,0,,đều được Chỉ huy Dụ \Nghi nhớ trong đầu chứ.
Dialogue: 0,0:17:55.20,0:17:57.68,DVC,Dụ,0,0,0,,Tôi chỉ có thể ghi nhớ được \Nđiểm cao nhất của toàn Liên minh.
Dialogue: 0,0:17:59.70,0:18:02.84,VKH,Vương,0,0,0,,Vậy mục tiêu chuyển động \Ncao nhất là ai vậy?
Dialogue: 0,0:18:02.84,0:18:04.93,VKH,Vương,0,0,0,,Diệp Tu hoặc là Chu Trạch Khải?
Dialogue: 0,0:18:05.70,0:18:09.75,DVC,Dụ,0,0,0,,Chắc là Diệp thần, 998.
Dialogue: 0,0:18:09.75,0:18:12.76,DVC,Dụ,0,0,0,,Bắn tỉa hạng nặng tầm xa của tiểu Chu cần phải mạnh thêm chút nữa.
Dialogue: 0,0:18:12.80,0:18:16.22,VKH,Vương,0,0,0,,Ừm, điều này ít nhiều gì cũng có liên quan đến phong cách cá nhân.
Dialogue: 0,0:18:16.56,0:18:20.04,VKH,Vương,0,0,0,,Mục tiêu chuyển động cao nhất của tôi chắc cũng tầm hơn 990 điểm.
Dialogue: 0,0:18:21.24,0:18:23.44,VKH,Vương,0,0,0,,Bắn tỉa hạng nặng \Ncần phải giảm xuống chút.
Dialogue: 0,0:18:23.52,0:18:26.18,DVC,Dụ,0,0,0,,Kiệt Hi rất phù hợp với vận động chiến.
Dialogue: 0,0:18:26.28,0:18:28.62,DVC,Dụ,0,0,0,,Nếu như Liên minh khai phá\Nhạng mục thi đấu thể thao này,
Dialogue: 0,0:18:28.62,0:18:31.78,DVC,Dụ,0,0,0,,hãy để cho mọi người \Nvừa lộn mèo vừa ném đĩa.
Dialogue: 0,0:18:32.14,0:18:34.48,DVC,Dụ,0,0,0,,Như vậy nhất định anh\Nsẽ là người dẫn đầu.
Dialogue: 0,0:18:34.48,0:18:37.18,VKH,Vương,0,0,0,,Mặc dù nghe thì giống\N như cậu đang khen tôi,
Dialogue: 0,0:18:37.18,0:18:39.52,VKH,Vương,0,0,0,,nhưng dường như tôi không vui nổi.
Dialogue: 0,0:18:41.74,0:18:43.98,VKH,Vương,0,0,0,,Tới thì cũng đã tới rồi, \Nlàm ván không?
Dialogue: 0,0:18:45.24,0:18:48.18,DVC,Dụ,0,0,0,,Không chơi thì hơn, \Nđừng ức hiếp người "tay tàn".
Dialogue: 0,0:18:48.18,0:18:51.18,DVC,Dụ,0,0,0,,Vốn dĩ S0 là hạng mục dành\N cho những lính gác hàng đầu,
Dialogue: 0,0:18:51.18,0:18:53.86,DVC,Dụ,0,0,0,,tôi mà bắn chắc toàn \Nbắn trượt mục tiêu thôi.
Dialogue: 0,0:18:54.50,0:18:55.28,VKH,Vương,0,0,0,,Không đâu.
Dialogue: 0,0:18:57.38,0:19:00.18,VKH,Vương,0,0,0,,Không phải chúng ta\Nđã... kết đôi rồi sao?
Dialogue: 0,0:19:01.36,0:19:04.32,VKH,Vương,0,0,0,,Tôi với cậu cùng thực hiện, cậu thử đi.
Dialogue: 0,0:19:08.32,0:19:09.75,DVC,Dụ,0,0,0,,Thành thật mà nói,
Dialogue: 0,0:19:09.75,0:19:12.03,DVC,Dụ,0,0,0,,khoảng cách của S0 \Nvà tốc độ chuyển động của nó
Dialogue: 0,0:19:12.03,0:19:14.02,DVC,Dụ,0,0,0,,khiến tôi không nhìn thấy mục tiêu ở đâu.
Dialogue: 0,0:19:14.02,0:19:17.44,VKH,Vương,0,0,0,,Suy cho cùng thì mức độ nhạy về năm giác quan của lính gác và dẫn đường khác nhau.
Dialogue: 0,0:19:18.74,0:19:21.82,VKH,Vương,0,0,0,,Vậy nên cậu đừng nhìn, để tôi nhìn.
Dialogue: 0,0:19:22.26,0:19:26.00,VKH,Vương,0,0,0,,Cậu kết nối với cảm nhận\N của tôi là được rồi.
Dialogue: 0,0:19:42.66,0:19:44.12,Default,hệ thống,0,0,0,,Kết thúc bắn.
Dialogue: 0,0:19:44.12,0:19:45.50,Default,hệ thống,0,0,0,,Cấp bậc S0, kỷ lục 979 điểm.
Dialogue: 0,0:19:50.18,0:19:52.23,Default,hệ thống,0,0,0,,Mời ghi nhận kỷ lục.
Dialogue: 0,0:19:52.40,0:19:55.52,VKH,Vương,0,0,0,,979, rất giỏi rồi.
Dialogue: 0,0:19:55.52,0:19:57.54,VKH,Vương,0,0,0,,Đến đây, cho cậu ghi lại đó.
Dialogue: 0,0:19:58.70,0:20:00.79,VKH,Vương,0,0,0,,Cho dù là lính gác cấp bậc đội trưởng,
Dialogue: 0,0:20:00.79,0:20:03.36,VKH,Vương,0,0,0,,cũng không thể lần nào \Nbắn cũng ra số điểm này đâu.
Dialogue: 0,0:20:04.16,0:20:06.85,VKH,Vương,0,0,0,,Cậu có thể đi khoe khoang \Nvới Hoàng Thiếu Thiên được rồi đó.
Dialogue: 0,0:20:06.85,0:20:09.54,DVC,Dụ,0,0,0,,Hahaha, không phải rõ ràng\N đây là gian lận sao?
Dialogue: 0,0:20:09.94,0:20:11.38,VKH,Vương,0,0,0,,Sao có thể?
Dialogue: 0,0:20:11.38,0:20:14.18,VKH,Vương,0,0,0,,Bình thường khi Liên minh\N sát hạch đánh giá cấp bậc,
Dialogue: 0,0:20:14.18,0:20:16.68,VKH,Vương,0,0,0,,cũng không có nói qua có căn cứ theo chia nhóm kết đôi hay không.
Dialogue: 0,0:20:16.76,0:20:20.57,VKH,Vương,0,0,0,,Những bạn nhỏ dùng tinh thần lực giúp đỡ lẫn nhau đều được ngầm cho phép,
Dialogue: 0,0:20:20.57,0:20:22.54,VKH,Vương,0,0,0,,vậy tại sao chúng ta\Nlại không được?
Dialogue: 0,0:20:22.98,0:20:24.23,DVC,Dụ,0,0,0,,Anh thì lớn hơn ai?
Dialogue: 0,0:20:24.23,0:20:26.85,DVC,Dụ,0,0,0,,Mà gọi người khác là bạn nhỏ hả?
Dialogue: 0,0:20:29.24,0:20:33.28,DVC,Dụ,0,0,0,,Trở thành đội trưởng\N liền làm ra vẻ lão luyện.
Dialogue: 0,0:20:33.28,0:20:35.05,DVC,Dụ,0,0,0,,Như vậy không được đâu.
Dialogue: 0,0:20:35.75,0:20:37.50,VKH,Vương,0,0,0,,Dù sao thì cũng lớn hơn cậu.
Dialogue: 0,0:20:43.66,0:20:45.48,DVC,Dụ,0,0,0,,Thật ra tôi muốn nói,
Dialogue: 0,0:20:45.48,0:20:48.00,DVC,Dụ,0,0,0,,tôi có thể cảm nhận được anh,
Dialogue: 0,0:20:48.00,0:20:49.78,DVC,Dụ,0,0,0,,vậy nên cho dù ở đâu,
Dialogue: 0,0:20:49.78,0:20:51.70,DVC,Dụ,0,0,0,,xảy ra chuyện gì,
Dialogue: 0,0:20:51.70,0:20:53.22,DVC,Dụ,0,0,0,,đều sẽ không có vấn đề gì hết.
Dialogue: 0,0:20:53.22,0:20:54.72,DVC,Dụ,0,0,0,,Tình trạng của anh\Nđã đỡ hơn nhiều rồi.
Dialogue: 0,0:20:54.72,0:20:56.64,DVC,Dụ,0,0,0,,Bản thân anh cũng đừng quá lo.
Dialogue: 0,0:20:57.58,0:20:59.68,VKH,Vương,0,0,0,,Ừm, tôi biết rồi.
Dialogue: 0,0:21:02.64,0:21:05.00,DVC,Dụ,0,0,0,,Vậy thì đi thôi, về nhà.
