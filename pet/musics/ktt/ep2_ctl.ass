Dialogue: 0,0:00:08.12,0:00:11.68,Vi Thảo,Phương,0,0,0,,Phương Sĩ Khiêm: Cậu đã nghe nói gì chưa? \NHôm qua máy bay của Hoàng Thiếu Thiên trở về rồi,
Dialogue: 0,0:00:11.92,0:00:14.06,Vi Thảo,Phương,0,0,0,,thậm chí còn chưa cất cánh nữa.
Dialogue: 0,0:00:14.06,0:00:15.08,VKH,Vương,0,0,0,,Vương: Tại sao?
Dialogue: 0,0:00:15.20,0:00:18.04,Vi Thảo,Phương,0,0,0,,Không có hỏi, chắc là vấn đề về hành khách.
Dialogue: 0,0:00:18.20,0:00:21.80,Vi Thảo,Phương,0,0,0,,Nghe nói là tháp chỉ huy \Nhỗn loạn, chịu không nổi luôn.
Dialogue: 0,0:00:30.86,0:00:31.56,VKH,Vương,0,0,0,,Ừm?
Dialogue: 0,0:00:31.68,0:00:35.00,Vi Thảo,Phương,0,0,0,,Đừng, đó là hai phi công của \Nhãng hàng không phương Tây,
Dialogue: 0,0:00:35.16,0:00:36.40,Vi Thảo,Phương,0,0,0,,Bọn họ rất là ghét cậu.
Dialogue: 0,0:00:36.60,0:00:40.20,VKH,Vương,0,0,0,,Là vì tôi lái giỏi hay là vì tôi là Gay?
Dialogue: 0,0:00:40.84,0:00:46.20,Vi Thảo,Phương,0,0,0,,Họ ghét cay ghét đắng Gay, cậu lại còn đùa \Nnhư vậy vẫn chưa đủ thấy chán ghét bọn họ sao?
Dialogue: 0,0:00:46.88,0:00:51.28,VKH,Vương,0,0,0,,Tôi mời bọn họ uống rượu, sẽ \Nkhiến họ càng thêm chán ghét chứ?
Dialogue: 0,0:00:51.72,0:00:57.24,VKH,Vương,0,0,0,,Thêm một ly bia nữa, làm 1 ly Depth charg*.
Dialogue: 0,0:00:51.72,0:00:57.24,Chú thích,Vương,0,0,0,,*Là một loại cocktail có nguồn gốc từ Hoa Kỳ.
Dialogue: 0,0:00:57.44,0:00:59.72,Vi Thảo,Phương,0,0,0,,Cậu có nhàm chán quá không vậy?
Dialogue: 0,0:01:02.40,0:01:06.84,Vi Thảo,Phương,0,0,0,,Này, cậu thật sự muốn mời thì cũng đừng\N lãng phí trên người mấy tên rác rưởi đó chứ.
Dialogue: 0,0:01:07.04,0:01:12.08,Vi Thảo,Phương,0,0,0,,Nếu không thì... đem tiền cho bạch nguyệt quang đi.
Dialogue: 0,0:01:12.48,0:01:13.64,VKH,Vương,0,0,0,,Cái gì?
Dialogue: 0,0:01:15.24,0:01:17.24,VKH,Vương,0,0,0,,Xin lỗi, không cần bia nữa.
Dialogue: 0,0:01:20.43,0:01:28.24,Vi Thảo,Phương,0,0,0,,Cậu dám mời rượu kẻ thù mà không \Ndám mời nam thần một ly à? Hahaha.
Dialogue: 0,0:01:28.36,0:01:29.60,VKH,Vương,0,0,0,,Nhàm chán.
Dialogue: 0,0:01:31.16,0:01:34.48,vai phụ,phi công A,0,0,0,,Phi công nam: Aiyo, đây không phải là cơ trưởng \NVương của Hàng không Vinh Quang sao?
Dialogue: 0,0:01:34.60,0:01:35.36,VKH,Vương,0,0,0,,Chào.
Dialogue: 0,0:01:36.48,0:01:40.28,vai phụ,phi công B,0,0,0,,B: Cơ trưởng Vương sao lại ở đây \Nuống rượu mà không có ai đi cùng hết vậy?
Dialogue: 0,0:01:40.40,0:01:42.28,vai phụ,phi công A,0,0,0,,A: Cậu hỏi câu này,
Dialogue: 0,0:01:42.48,0:01:45.76,vai phụ,phi công A,0,0,0,,còn không phải là vì bị hoãn cất cánh, \Nở trong buồng lái chán quá sao.
Dialogue: 0,0:01:45.92,0:01:50.96,vai phụ,phi công A,0,0,0,,Với gương mặt của cơ trưởng\N Vương như này... cả mông nữa...
Dialogue: 0,0:01:51.40,0:01:53.36,vai phụ,phi công A,0,0,0,,Ít bay trên không tốt hơn nhiều.
Dialogue: 0,0:01:53.36,0:01:54.36,Vi Thảo,Phương,0,0,0,,Các cậu có ý gì hả?
Dialogue: 0,0:01:54.44,0:01:55.76,VKH,Vương,0,0,0,,Sĩ Khiêm.
Dialogue: 0,0:01:56.24,0:01:58.96,DVC,Dụ,0,0,0,,Dụ: Xin lỗi, với kĩ thuật của cơ trưởng Vương,
Dialogue: 0,0:01:59.12,0:02:02.96,DVC,Dụ,0,0,0,,không phải không ngồi trong buồng lái máy bay \Nmới là tổn thất của ngành hàng không sao?
Dialogue: 0,0:02:03.44,0:02:04.68,vai phụ,phi công A,0,0,0,,A: Cậu là ai?
Dialogue: 0,0:02:04.84,0:02:07.16,vai phụ,phi công B,0,0,0,,B: ...Cậu ta là kiểm soát viên hôm nay đó.
Dialogue: 0,0:02:07.32,0:02:10.24,DVC,Dụ,0,0,0,,Hai vị cơ trưởng, hôm nay khi hạ cánh \Ncảm ơn sự hợp tác của hai vị,
Dialogue: 0,0:02:10.32,0:02:11.96,DVC,Dụ,0,0,0,,Chào mừng đến với thành phố B.
Dialogue: 0,0:02:12.24,0:02:15.00,vai phụ,phi công A,0,0,0,,A: Chậc... Bỏ đi, đi thôi nào.
Dialogue: 0,0:02:17.76,0:02:20.12,DVC,Dụ,0,0,0,,Cơ trưởng Vương, là tôi tự ý lo chuyện bao đồng.
Dialogue: 0,0:02:20.28,0:02:23.24,DVC,Dụ,0,0,0,,Chắc chắn là tự anh có thể \Nxử lý tốt hơn, tôi quá phận rồi.
Dialogue: 0,0:02:23.48,0:02:24.88,VKH,Vương,0,0,0,,Cậu biết tôi?
Dialogue: 0,0:02:25.00,0:02:28.16,DVC,Dụ,0,0,0,,Cơ trưởng Vương Kiệt Hi của Hàng không \NVinh Quang, đương nhiên là tôi biết rồi.
Dialogue: 0,0:02:28.36,0:02:31.92,DVC,Dụ,0,0,0,,Không phải cơ trưởng trẻ tuổi nào\N như anh cũng đều có thể bay đến Nepal,
Dialogue: 0,0:02:32.28,0:02:34.72,DVC,Dụ,0,0,0,,một sân bay ác quỷ được bao quanh bởi núi,
Dialogue: 0,0:02:34.80,0:02:38.52,DVC,Dụ,0,0,0,,chỉ có phi công có kỹ thuật cực kỳ tốt và\N kinh nghiệm phong phú mới có tư cách hạ cánh.
Dialogue: 0,0:02:38.88,0:02:40.48,DVC,Dụ,0,0,0,,Anh vừa nhận đường bay này,
Dialogue: 0,0:02:40.64,0:02:44.09,DVC,Dụ,0,0,0,,tôi đoán có lẽ anh là phi công\N trẻ nhất trong nước được nhận.
Dialogue: 0,0:02:44.44,0:02:46.88,VKH,Vương,0,0,0,,À, thì ra là vì vậy.
Dialogue: 0,0:02:47.64,0:02:48.88,DVC,Dụ,0,0,0,,Sao thế?
Dialogue: 0,0:02:50.40,0:02:51.92,VKH,Vương,0,0,0,,Không sao cả.
Dialogue: 0,0:02:52.32,0:02:54.48,VKH,Vương,0,0,0,,Chứ không phải là vì tính hướng của tôi?
Dialogue: 0,0:02:54.72,0:02:56.52,DVC,Dụ,0,0,0,,Vừa rồi đi ngang qua nghe bọn họ nói như vậy,
Dialogue: 0,0:02:56.52,0:03:00.08,DVC,Dụ,0,0,0,,cảm thấy họ thật quá đáng liền \Nkhông nhẫn nhịn được, mạo phạm rồi.
Dialogue: 0,0:03:02.12,0:03:06.16,VKH,Vương,0,0,0,,Đâu có, tôi phải nên cảm ơn cậu Dụ đây mới đúng.
Dialogue: 0,0:03:06.52,0:03:07.36,DVC,Dụ,0,0,0,,Ửm?
Dialogue: 0,0:03:07.84,0:03:10.24,DVC,Dụ,0,0,0,,...À tôi quên mất bản thân đang đeo bảng tên,
Dialogue: 0,0:03:10.36,0:03:12.12,DVC,Dụ,0,0,0,,nhưng mà tôi vẫn nên giới thiệu một chút,
Dialogue: 0,0:03:12.24,0:03:14.28,DVC,Dụ,0,0,0,,Dụ Văn Châu, kiểm soát viên của cảng B.
Dialogue: 0,0:03:14.44,0:03:15.48,VKH,Vương,0,0,0,,Rất hân hạnh,
Dialogue: 0,0:03:15.48,0:03:17.92,VKH,Vương,0,0,0,,nhưng mà thật ra tôi biết cậu.
Dialogue: 0,0:03:19.08,0:03:22.16,VKH,Vương,0,0,0,,À... Không phải lúc xem bảng tên khi nãy.
Dialogue: 0,0:03:24.20,0:03:25.68,VKH,Vương,0,0,0,,Tôi nhận ra giọng nói của cậu,
Dialogue: 0,0:03:26.24,0:03:29.00,VKH,Vương,0,0,0,,chúng ta từng nói chuyện rất nhiều lần.
Dialogue: 0,0:03:29.24,0:03:30.72,DVC,Dụ,0,0,0,,Thật không...?
Dialogue: 0,0:03:30.88,0:03:33.40,DVC,Dụ,0,0,0,,Tôi cứ tưởng chỉ có mình tôi nhận ra,
Dialogue: 0,0:03:33.60,0:03:34.96,DVC,Dụ,0,0,0,,không ngờ là anh cũng vậy.
Dialogue: 0,0:03:35.16,0:03:36.44,VKH,Vương,0,0,0,,Cái gì?
Dialogue: 0,0:03:37.56,0:03:39.32,DVC,Dụ,0,0,0,,Không có gì, chính là...
Dialogue: 0,0:03:39.48,0:03:41.84,Lam Vũ,Hoàng,0,0,0,,Hoàng Thiếu Thiên: Dụ Văn Châu \Ntên khốn này cút lại đây mời tôi uống rượu.
Dialogue: 0,0:03:41.92,0:03:43.68,DVC,Dụ,0,0,0,,Thật ngại quá, hôm nay tôi có hẹn,
Dialogue: 0,0:03:43.76,0:03:45.20,DVC,Dụ,0,0,0,,Hôm khác có dịp lại nói chuyện nhé.
Dialogue: 0,0:03:45.40,0:03:47.24,Lam Vũ,Hoàng,0,0,0,,Dụ Văn Châu cậu còn lề mề ở đó làm gì?
Dialogue: 0,0:03:47.40,0:03:50.96,DVC,Dụ,0,0,0,,Ờm... cơ trưởng Vương, thật ra tôi muốn nói,
Dialogue: 0,0:03:51.08,0:03:52.20,DVC,Dụ,0,0,0,,tôi nhớ được giọng nói của anh,
Dialogue: 0,0:03:52.20,0:03:54.08,DVC,Dụ,0,0,0,,hơn nữa ba năm trước ở cảng B một thời gian,
Dialogue: 0,0:03:54.16,0:03:55.80,DVC,Dụ,0,0,0,,khi đó thường xuyên gặp chuyến bay của anh.
Dialogue: 0,0:03:55.92,0:03:58.36,DVC,Dụ,0,0,0,,Gần đây tôi vừa được điều về, sau này \Nvẫn còn dịp, xin anh tiếp tục chỉ bảo.
Dialogue: 0,0:03:58.40,0:03:59.36,Lam Vũ,Hoàng,0,0,0,,Dụ Văn Châu!!
Dialogue: 0,0:03:59.44,0:04:01.24,DVC,Dụ,0,0,0,,Được rồi được rồi, tôi đến đây.
Dialogue: 0,0:04:01.56,0:04:03.72,DVC,Dụ,0,0,0,,Sau này lại nói tiếp, hai vị buổi tối vui vẻ.
Dialogue: 0,0:04:11.24,0:04:12.88,Vi Thảo,Phương,0,0,0,,Phương: Ơ...
Dialogue: 0,0:04:14.72,0:04:15.44,VKH,Vương,0,0,0,,Vương: Ửm?
Dialogue: 0,0:04:15.56,0:04:20.64,Vi Thảo,Phương,0,0,0,,Tôi không nhìn nhầm chứ? \NBạch nguyệt quang chủ động bắt chuyện với cậu?
Dialogue: 0,0:04:20.80,0:04:21.92,Vi Thảo,Phương,0,0,0,,Đây là kịch bản gì đây?
Dialogue: 0,0:04:22.04,0:04:24.52,Vi Thảo,Phương,0,0,0,,Đây là do cậu tự ảo tưởng ra \Nhay là thật sự xảy ra vậy?
Dialogue: 0,0:04:24.52,0:04:28.36,Vi Thảo,Phương,0,0,0,,Lượng thông tin quá lớn khiến tôi muốn sụp đổ rồi.
Dialogue: 0,0:04:28.52,0:04:29.72,VKH,Vương,0,0,0,,Ừm....
Dialogue: 0,0:04:30.04,0:04:32.44,Vi Thảo,Phương,0,0,0,,Mà này, cậu ấy nói cậu ấy biết cậu ư?
Dialogue: 0,0:04:32.52,0:04:35.48,Vi Thảo,Phương,0,0,0,,Biết cậu cũng giống như cậu biết về cậu ấy!
Dialogue: 0,0:04:35.72,0:04:39.88,Vi Thảo,Phương,0,0,0,,Hơn nữa lại là một tên kì lạ \Nnhận ra người khác qua radio...
Dialogue: 0,0:04:40.00,0:04:42.92,Vi Thảo,Phương,0,0,0,,Thêm nữa là cậu ta biết cậu từ 3 năm trước rồi,
Dialogue: 0,0:04:43.08,0:04:49.36,Vi Thảo,Phương,0,0,0,,tôi không biết nên nói thế nào mới tốt đây, \Nphải châm biếm hay là thán phục hay là...
Dialogue: 0,0:04:49.44,0:04:51.96,Vi Thảo,Phương,0,0,0,,Này, cậu làm gì thế sao không nói gì?
Dialogue: 0,0:04:53.28,0:04:54.28,Vi Thảo,Phương,0,0,0,,Cậu...
Dialogue: 0,0:04:55.68,0:04:58.84,Vi Thảo,Phương,0,0,0,,Được rồi, trông cậu vui vẻ ghê.
Dialogue: 0,0:04:59.00,0:05:03.80,Vi Thảo,Phương,0,0,0,,Còn cười, còn cười nữa muốn khiến \Ntôi buồn nôn chết à Vương Kiệt Hi!
Dialogue: 0,0:05:09.96,0:05:12.04,Default,,0,0,0,,Nguyên tác : Thủy Lưu Hoa Khai
Dialogue: 0,0:05:12.04,0:05:16.32,Default,,0,0,0,, Kịch truyền thanh 《Clear to land》 \N đồng nhân Dụ Vương, Toàn Chức Cao Thủ.
Dialogue: 0,0:05:16.36,0:05:17.64,Default,,0,0,0,,Kỳ 2
Dialogue: 0,0:05:36.40,0:05:38.60,Lam Vũ,Hoàng,0,0,0,,Hoàng: Lão Vương, đây là lịch trình tháng này.
Dialogue: 0,0:05:38.76,0:05:40.64,Lam Vũ,Hoàng,0,0,0,,Ơ? Có huấn luyện chung với ATC nữa ư!
Dialogue: 0,0:05:40.72,0:05:42.04,Lam Vũ,Hoàng,0,0,0,,Lão Vương đi cùng cậu là ai?
Dialogue: 0,0:05:42.20,0:05:45.72,Lam Vũ,Hoàng,0,0,0,,Của tôi là một nhân viên mới hình như vừa \Nqua kiểm tra phân loại, tên là Lư Hãn Văn.
Dialogue: 0,0:05:45.80,0:05:48.76,Lam Vũ,Hoàng,0,0,0,,Đm nói cậu ta học cấp ba tôi còn tin nhưng \Nnghe nói là mới 23 tuổi mà nhảy lớp đại học
Dialogue: 0,0:05:48.88,0:05:50.20,Lam Vũ,Hoàng,0,0,0,,vừa vào tháp chỉ huy hồi mùa xuân rồi.
Dialogue: 0,0:05:50.28,0:05:51.76,Lam Vũ,Hoàng,0,0,0,,Nếu bên cậu là con gái thì tôi đổi với cậu nha,
Dialogue: 0,0:05:51.80,0:05:53.72,Lam Vũ,Hoàng,0,0,0,,dù sao thì cậu cũng đâu có \Nmê đâu đúng không hahaha.
Dialogue: 0,0:05:53.84,0:05:55.72,Lam Vũ,Hoàng,0,0,0,,Cho tôi xem với, cho tôi xem với.
Dialogue: 0,0:05:57.12,0:05:58.56,VKH,Vương,0,0,0,,Vương: Là Dụ Văn Châu.
Dialogue: 0,0:05:59.32,0:05:59.97,Lam Vũ,Hoàng,0,0,0,,Ô...
Dialogue: 0,0:06:00.08,0:06:01.76,VKH,Vương,0,0,0,,Cậu sao vậy?
Dialogue: 0,0:06:01.84,0:06:04.07,Lam Vũ,Hoàng,0,0,0,,Tôi sao là sao? Tôi vẫn ổn mà?
Dialogue: 0,0:06:04.24,0:06:08.05,VKH,Vương,0,0,0,,Đột nhiên cậu không nói gì, tôi chỉ là\N lịch sự quan tâm một chút thôi.
Dialogue: 0,0:06:08.05,0:06:10.40,Lam Vũ,Hoàng,0,0,0,,Không sao cả, chỉ là kiểm soát viên này là bạn tôi.
Dialogue: 0,0:06:10.56,0:06:12.96,VKH,Vương,0,0,0,,Cậu có muốn cùng với \Ncậu ấy không, tôi đổi với cậu.
Dialogue: 0,0:06:13.00,0:06:15.80,Lam Vũ,Hoàng,0,0,0,,Đừng đừng, thôi đi, mặc kệ cậu ấy, \Ndù sao ai đến cũng thế thôi.
Dialogue: 0,0:06:15.96,0:06:18.68,Lam Vũ,Hoàng,0,0,0,,Vậy nhé tôi đi trước đây. Má nó cái\N lịch trình này đủ khiến tôi phát điên rồi.
Dialogue: 0,0:06:18.72,0:06:20.96,Lam Vũ,Hoàng,0,0,0,,Tháng này tôi bay đến mức muốn hộc máu.
Dialogue: 0,0:06:23.92,0:06:29.63,Nữ,tiếp viên,0,0,0,,Tiếp viên: Cơ trưởng, vừa nãy ATC phát thông báo nói \Nlà vừa thay đổi danh sách huấn luyện chung.
Dialogue: 0,0:06:29.63,0:06:31.12,Nữ,tiếp viên,0,0,0,,Mời anh đến xác nhận lại.
Dialogue: 0,0:06:31.40,0:06:33.20,VKH,Vương,0,0,0,,Được rồi, để tôi xem xem.
Dialogue: 0,0:06:34.52,0:06:36.40,Lam Vũ,Trịnh,0,0,0,,Trịnh Hiên: Không cần phải xem\N nữa đâu cơ trưởng Vương,
Dialogue: 0,0:06:36.44,0:06:39.88,Lam Vũ,Trịnh,0,0,0,,trưởng ban Dụ không thể đến,\N hôm nay đổi thành tôi.
Dialogue: 0,0:06:42.64,0:06:47.07,Lam Vũ,Trịnh,0,0,0,,Tôi là Trịnh Hiên, lần này phiền\N mọi người chỉ bảo nhiều hơn.
Dialogue: 0,0:06:47.07,0:06:49.28,Lam Vũ,Trịnh,0,0,0,,À đừng để ý đến tôi,
Dialogue: 0,0:06:49.56,0:06:52.16,Lam Vũ,Trịnh,0,0,0,,cứ xem tôi như là một củ cải \Nđược thắt dây an toàn đi ha.
Dialogue: 0,0:06:52.28,0:06:53.44,Vi Thảo,Hứa,0,0,0,,Hứa Bân: Cậu cũng quá khách sáo rồi.
Dialogue: 0,0:06:53.60,0:06:55.40,Vi Thảo,Hứa,0,0,0,,Tôi là phi công phó, tên Hứa Bân.
Dialogue: 0,0:06:55.40,0:06:56.76,Vi Thảo,Hứa,0,0,0,,Hợp tác vui vẻ.
Dialogue: 0,0:07:02.72,0:07:04.25,Vi Thảo,Phương,0,0,0,,Phương: Ê ê Vương Kiệt Hi!
Dialogue: 0,0:07:04.25,0:07:06.20,Vi Thảo,Phương,0,0,0,,Sao danh sách lái chung với \Nbạch nguyệt quang bị đổi mất rồi?
Dialogue: 0,0:07:06.20,0:07:08.64,VKH,Vương,0,0,0,,Khụ!...Ừm...
Dialogue: 0,0:07:08.80,0:07:11.72,Lam Vũ,Trịnh,0,0,0,,Ờ... xin chào xin chào.
Dialogue: 0,0:07:11.84,0:07:13.24,Vi Thảo,Phương,0,0,0,,Ơ...
Dialogue: 0,0:07:13.36,0:07:15.80,Vi Thảo,Phương,0,0,0,,Xin lỗi, tôi là tiếp viên trưởng Phương Sĩ Khiêm,
Dialogue: 0,0:07:15.92,0:07:17.72,Vi Thảo,Phương,0,0,0,,chắc hẳn cậu là Trịnh Hiên,
Dialogue: 0,0:07:17.84,0:07:19.60,Vi Thảo,Phương,0,0,0,,chuyến bay hôm nay xin nhờ cậu chỉ bảo.
Dialogue: 0,0:07:19.64,0:07:23.76,Vi Thảo,Phương,0,0,0,,Có mang theo ly không? Cậu thích loại \Ncà phê nào? Tôi sẽ mang đến giúp cậu.
Dialogue: 0,0:07:24.24,0:07:26.16,Lam Vũ,Trịnh,0,0,0,,Áp lực lắm luôn...
Dialogue: 0,0:07:27.40,0:07:31.40,Lam Vũ,Trịnh,0,0,0,,Không cần khách sáo đâu, các cậu \Nxem tôi như không tồn tại là được rồi.
Dialogue: 0,0:07:31.68,0:07:35.40,Vi Thảo,Hứa,0,0,0,,Hứa: Kể ra thì vốn dĩ hôm nay trưởng \Nban Dụ của các anh phải đi chung mà,
Dialogue: 0,0:07:35.52,0:07:37.16,Vi Thảo,Hứa,0,0,0,,sao gần đến giờ lại đổi người?
Dialogue: 0,0:07:37.24,0:07:39.96,Lam Vũ,Trịnh,0,0,0,,À... cậu ấy hả...
Dialogue: 0,0:07:41.76,0:07:44.40,Lam Vũ,Trịnh,0,0,0,,Hôm nay có vấn đề về lịch trình \Nnên cậu ấy đột ngột không đến được.
Dialogue: 0,0:07:44.76,0:07:50.12,Lam Vũ,Trịnh,0,0,0,,Bây giờ có lẽ trên tháp chỉ huy chính đang dùng kính viễn vọng xác nhận xem tôi có ngoan ngoãn lên máy bay không.
Dialogue: 0,0:07:51.04,0:07:53.40,Vi Thảo,Hứa,0,0,0,,Tháp chỉ huy có thể nhìn thấy buồng lái luôn hả?
Dialogue: 0,0:07:53.64,0:07:57.72,Lam Vũ,Trịnh,0,0,0,,Đương nhiên rồi, nếu như góc độ \Nvà thời tiết ở máy bay đều tốt,
Dialogue: 0,0:07:57.88,0:07:59.60,Lam Vũ,Trịnh,0,0,0,,là có thể nhìn thấy.
Dialogue: 0,0:07:59.68,0:08:02.64,Lam Vũ,Trịnh,0,0,0,,Chỉ là khi không có việc gì thì chúng tôi\N không thường nhìn chằm chằm vào buồng lái,
Dialogue: 0,0:08:02.72,0:08:04.40,Lam Vũ,Trịnh,0,0,0,,áp lực lắm luôn.
Dialogue: 0,0:08:04.76,0:08:07.00,Vi Thảo,Hứa,0,0,0,,Vì vậy trừ khi màn hình ra-đa
Dialogue: 0,0:08:07.08,0:08:09.32,Vi Thảo,Hứa,0,0,0,,tháp chỉ huy cũng cần xác nhận \Ntình hình sân bay bằng mắt thường.
Dialogue: 0,0:08:09.40,0:08:12.60,Vi Thảo,Hứa,0,0,0,,Có vẻ là vô cùng bận rộn nhỉ, các anh vất vả rồi.
Dialogue: 0,0:08:13.48,0:08:15.72,Lam Vũ,Trịnh,0,0,0,,Vào thời gian cao điểm cũng chịu không nổi luôn.
Dialogue: 0,0:08:16.20,0:08:18.24,Lam Vũ,Trịnh,0,0,0,,Có lúc thời tiết không tốt đường băng bị dầu tràn vào,
Dialogue: 0,0:08:18.32,0:08:22.84,Lam Vũ,Trịnh,0,0,0,,sân bay bên cạnh thì đóng cửa lại còn bị chim tấn công,
Dialogue: 0,0:08:22.92,0:08:24.56,Lam Vũ,Trịnh,0,0,0,,lộn xộn hết cả lên,
Dialogue: 0,0:08:24.60,0:08:27.64,Lam Vũ,Trịnh,0,0,0,,dưới đất có 5 6 chiếc máy bay chen nhau, \Ntrên trời cũng có máy bay xếp hàng,
Dialogue: 0,0:08:27.76,0:08:29.96,Lam Vũ,Trịnh,0,0,0,,áp lực lắm luôn.
Dialogue: 0,0:08:30.96,0:08:35.88,Lam Vũ,Trịnh,0,0,0,,Vì vậy có lúc không còn cách nào khác phải \Nđể các phi công đợi rất lâu, thứ lỗi cho chúng tôi.
Dialogue: 0,0:08:36.48,0:08:40.54,Vi Thảo,Hứa,0,0,0,,Tất nhiên rồi, tình hình sân bay\N hôm nay có vẻ cũng rất đông.
Dialogue: 0,0:08:40.92,0:08:42.64,Vi Thảo,Hứa,0,0,0,,Vẫn chưa có chỉ thị nào được đưa xuống.
Dialogue: 0,0:08:44.12,0:08:48.64,Lam Vũ,Trịnh,0,0,0,,Ừ... Hôm nay vì đường bay \N36R phải đóng cửa bảo dưỡng.
Dialogue: 0,0:08:48.76,0:08:52.28,Lam Vũ,Trịnh,0,0,0,,Do phía Nam gió đông bắc quá mạnh\Nkhiến đường bay tạm thời không thể sử dụng,
Dialogue: 0,0:08:52.40,0:08:55.16,Lam Vũ,Trịnh,0,0,0,,lúc đó chỉ có một đường bay có thể hạ cánh,
Dialogue: 0,0:08:55.28,0:08:56.80,Lam Vũ,Trịnh,0,0,0,,tất cả đều căng thẳng.
Dialogue: 0,0:08:57.68,0:09:00.52,Lam Vũ,Trịnh,0,0,0,,Khi mà tôi đến thì bên trong là một mớ hỗn độn,
Dialogue: 0,0:09:00.64,0:09:03.20,Lam Vũ,Trịnh,0,0,0,,đang xử lí cho hai chiếc máy bay ưu tiên hạ cánh,
Dialogue: 0,0:09:03.32,0:09:06.16,Lam Vũ,Trịnh,0,0,0,,có lẽ là động cơ tắt máy và ra-đa mất hiệu lực.
Dialogue: 0,0:09:06.96,0:09:08.44,Vi Thảo,Hứa,0,0,0,,Thật sao?
Dialogue: 0,0:09:08.76,0:09:12.48,Vi Thảo,Hứa,0,0,0,,Theo kinh nghiệm là kiểm soát viên của anh \Nthì có thể sẽ phải đợi trong bao lâu?
Dialogue: 0,0:09:12.56,0:09:17.68,Lam Vũ,Trịnh,0,0,0,,Cũng khó nói, nhưng hôm nay Văn Châu...\Ntrưởng ban Dụ kiểm soát hiện trường,
Dialogue: 0,0:09:18.04,0:09:21.60,Lam Vũ,Trịnh,0,0,0,,Có lẽ là sẽ không có vấn đề gì, \Ncó thể tranh thủ xuất phát đúng giờ.
Dialogue: 0,0:09:22.16,0:09:24.96,Vi Thảo,Hứa,0,0,0,,Kiểm soát viên nói như vậy cũng yên tâm nhiều rồi,
Dialogue: 0,0:09:25.12,0:09:26.48,Vi Thảo,Hứa,0,0,0,,đúng không cơ trưởng?
Dialogue: 0,0:09:27.44,0:09:28.44,VKH,Vương,0,0,0,,Ừ.
Dialogue: 0,0:09:31.28,0:09:36.92,VKH,Vương,0,0,0,,Đây là GAL733, sắp bay đến Hokkaido, \N5 phút trước thời gian xuất phát.
Dialogue: 0,0:09:38.36,0:09:41.88,DVC,Dụ,0,0,0,,Dụ: Tháp chỉ huy, GAL733, \Nbáo cáo sau khi kết thúc chuẩn bị.
Dialogue: 0,0:09:42.56,0:09:45.92,Lam Vũ,Trịnh,0,0,0,,Hôm nay quá may mắn, gặp được \Ntrưởng ban của chúng tôi dẫn dắt.
Dialogue: 0,0:09:46.48,0:09:49.92,Vi Thảo,Hứa,0,0,0,,Nghe giọng của anh ấy có vẻ \Nđâu có rối loạn như anh nói đâu nhỉ.
Dialogue: 0,0:09:50.16,0:09:52.20,DVC,Dụ,0,0,0,,Sự rối loạn này các cậu \Nkhông tưởng tượng ra được đâu.
Dialogue: 0,0:09:52.32,0:09:54.52,DVC,Dụ,0,0,0,,Nhưng mà xin đừng lo lắng, GAL733.
Dialogue: 0,0:09:54.68,0:09:57.72,Lam Vũ,Trịnh,0,0,0,,Không sao, Dụ Văn Châu chính \Nlà dù lửa cháy đến quần rồi
Dialogue: 0,0:09:57.84,0:10:01.32,Lam Vũ,Trịnh,0,0,0,,cũng có thể hoàn toàn bình tĩnh như\N không có gì đưa mọi người bay lên trời.
Dialogue: 0,0:10:01.32,0:10:04.88,DVC,Dụ,0,0,0,,Hôm nay xin lỗi nhé Trịnh Hiên, nhưng đừng \Ncó chiếm dụng kênh rồi nói xấu tôi.
Dialogue: 0,0:10:05.72,0:10:09.16,VKH,Vương,0,0,0,,Chuẩn bị hoàn tất, GAL733, xin phép cất cánh.
Dialogue: 0,0:10:09.84,0:10:12.92,DVC,Dụ,0,0,0,,GAL733, đến lượt các cậu rồi, xin chờ chỉ thị.
Dialogue: 0,0:10:13.60,0:10:17.24,VKH,Vương,0,0,0,,GAL733, đã rõ, chuẩn bị xuất phát.
Dialogue: 0,0:10:18.12,0:10:22.44,DVC,Dụ,0,0,0,,GAL733, hoàn tất chuẩn bị, \Nxin mời lui về đường băng L05.
Dialogue: 0,0:10:22.64,0:10:26.00,VKH,Vương,0,0,0,,GAL733, lui về đường băng L05.
Dialogue: 0,0:10:29.84,0:10:32.60,DVC,Dụ,0,0,0,,Tháp chỉ huy cảng B, \Nhướng gió 040, tốc độ gió 5 knot.
Dialogue: 0,0:10:32.72,0:10:35.00,DVC,Dụ,0,0,0,,Liên hệ tiếp cận tần số 128.35.
Dialogue: 0,0:10:35.80,0:10:40.36,VKH,Vương,0,0,0,,GAL733, hướng gió 040, tốc độ gió 5 knot.
Dialogue: 0,0:10:40.92,0:10:44.64,VKH,Vương,0,0,0,,Tiếp cận tần số 128.35, đã rõ.
Dialogue: 0,0:10:45.52,0:10:47.76,DVC,Dụ,0,0,0,,GAL733，Clear for take-off──
Dialogue: 0,0:10:47.96,0:10:50.44,DVC,Dụ,0,0,0,,Kiểm soát viên của chúng tôi \Nđã làm phiền anh rồi, good day.
Dialogue: 0,0:10:50.84,0:10:53.32,VKH,Vương,0,0,0,,Cảm ơn, không cần khách sáo.
Dialogue: 0,0:10:53.40,0:10:56.88,VKH,Vương,0,0,0,,GAL773，Clear for take-off...
Dialogue: 0,0:11:11.76,0:11:14.92,Vi Thảo,Phương,0,0,0,,Phương: Được rồi, tôi sai rồi vẫn không được sao.
Dialogue: 0,0:11:17.84,0:11:21.12,Vi Thảo,Phương,0,0,0,,Tôi cũng không biết là sẽ có đồng nghiệp\N của bạch nguyệt quang bên trong mà!
Dialogue: 0,0:11:21.24,0:11:23.76,Vi Thảo,Phương,0,0,0,,Hơn nữa sao tên đó lại không tới chứ?
Dialogue: 0,0:11:23.88,0:11:28.40,Vi Thảo,Phương,0,0,0,,Thật là thất vọng mà, cậu nói \Nthật đi có phải rất buồn không?
Dialogue: 0,0:11:29.24,0:11:30.56,VKH,Vương,0,0,0,,Vương: Không có!
Dialogue: 0,0:11:31.92,0:11:36.28,Vi Thảo,Phương,0,0,0,,Cậu đừng có giả vờ, hôm nay trên \Nmặt cậu viết đầy chữ thất vọng kìa.
Dialogue: 0,0:11:36.40,0:11:38.24,VKH,Vương,0,0,0,,Tôi trời sinh đã như vậy rồi.
Dialogue: 0,0:11:38.36,0:11:42.84,Vi Thảo,Phương,0,0,0,,À... Mà này cậu có hỏi thăm về nam thần\N từ cái người kiểm soát viên tên Trịnh Hiên không?
Dialogue: 0,0:11:43.04,0:11:45.16,Vi Thảo,Phương,0,0,0,,Ửm? Thẳng nam hay là có thể thích cả hai?
Dialogue: 0,0:11:45.28,0:11:47.60,Vi Thảo,Phương,0,0,0,,Sở thích là gì? Ăn tào phớ ngọt hay mặn?
Dialogue: 0,0:11:47.72,0:11:50.20,Vi Thảo,Phương,0,0,0,,Có hút thuốc, uống rượu không? \NTính tình có kỳ quặc không?
Dialogue: 0,0:11:50.20,0:11:51.24,Vi Thảo,Phương,0,0,0,,Nhân phẩm như thế nào...
Dialogue: 0,0:11:51.36,0:11:54.00,VKH,Vương,0,0,0,,Im miệng, lo ăn lẩu của anh đi.
Dialogue: 0,0:11:54.48,0:11:57.76,Vi Thảo,Phương,0,0,0,,Cậu còn muốn tôi im miệng cậu...
Dialogue: 0,0:11:58.04,0:12:01.68,Vi Thảo,Phương,0,0,0,,Ở đây có chỗ ngồi cho bốn người \Nmà cậu giả vờ ra vẻ thanh cao làm gì?
Dialogue: 0,0:12:01.88,0:12:03.72,Vi Thảo,Phương,0,0,0,,Rõ ràng đã lén lút hẹn người ta rồi.
Dialogue: 0,0:12:04.08,0:12:07.08,VKH,Vương,0,0,0,,Là Hứa Bân hẹn đó, tôi chỉ sẵn tiện đi thôi.
Dialogue: 0,0:12:07.60,0:12:09.60,Vi Thảo,Hứa,0,0,0,,Hứa: Cơ trưởng, chúng tôi tới rồi.
Dialogue: 0,0:12:11.68,0:12:16.80,Lam Vũ,Trịnh,0,0,0,,Trịnh: Xin lỗi vì đã tới muộn, vừa rồi ngủ \Nmột giấc nhưng không nghe thấy báo thức.
Dialogue: 0,0:12:17.68,0:12:19.28,VKH,Vương,0,0,0,,Thật ngại quá chúng tôi đã gọi món trước rồi.
Dialogue: 0,0:12:20.08,0:12:23.12,VKH,Vương,0,0,0,,Thực đơn ở đây, muốn ăn gì cứ gọi đừng khách sáo.
Dialogue: 0,0:12:24.24,0:12:27.08,Lam Vũ,Trịnh,0,0,0,,Sao lại có thể không biết xấu hổ\N để cơ trưởng Vương tốn kém như vậy được.
Dialogue: 0,0:12:27.08,0:12:28.92,Lam Vũ,Trịnh,0,0,0,,Tôi tự mình trả là được rồi.
Dialogue: 0,0:12:30.16,0:12:33.48,VKH,Vương,0,0,0,,Ở đây kinh nghiệm làm việc của tôi là \Nnhiều nhất, mời khách là chuyện đương nhiên rồi.
Dialogue: 0,0:12:33.68,0:12:36.76,Lam Vũ,Trịnh,0,0,0,,Aiya anh nói như vậy tôi áp lực lắm luôn...
Dialogue: 0,0:12:38.32,0:12:40.32,Vi Thảo,Phương,0,0,0,,Không sao, tha hồ gọi đi.
Dialogue: 0,0:12:40.44,0:12:43.52,Vi Thảo,Phương,0,0,0,,Đến lúc đó bảo trưởng ban Dụ của cậu \Nmời lại cơ trưởng của chúng tôi là được rồi.
Dialogue: 0,0:12:46.60,0:12:49.96,Lam Vũ,Trịnh,0,0,0,,Cái này thì được chứ, vậy hôm nay \Ntôi không khách sáo đâu.
Dialogue: 0,0:12:50.36,0:12:53.16,Lam Vũ,Trịnh,0,0,0,,Cơ trưởng Vương cứ việc \Nđòi BOSS của chúng tôi trả lại nhé.
Dialogue: 0,0:12:55.76,0:13:00.44,VKH,Vương,0,0,0,,Không cần khách sáo...Ừm...\Nthêm một phần cua lớn nữa nha.
Dialogue: 0,0:13:03.80,0:13:09.04,Lam Vũ,Trịnh,0,0,0,,À nói ra thì tôi cứ tưởng cơ trưởng nhất định\N sẽ cùng ăn với tiếp viên sau khi đáp chuyến bay.
Dialogue: 0,0:13:09.32,0:13:12.96,Vi Thảo,Phương,0,0,0,,Sao cậu lại ra vẻ tiếc nuối như vậy, \Ntôi không phải tiếp viên sao?
Dialogue: 0,0:13:13.84,0:13:17.80,Vi Thảo,Phương,0,0,0,,Chuyến bay đến Nhật không phải lúc nào \Ncũng có, các chị em đều đi dạo phố mua sắm hết rồi.
Dialogue: 0,0:13:18.12,0:13:22.76,Vi Thảo,Phương,0,0,0,,Cậu xui thôi, đổi chuyến bay khác là\Ncó cơ hội đi ăn cùng mỹ nữ rồi.
Dialogue: 0,0:13:23.72,0:13:29.64,Lam Vũ,Trịnh,0,0,0,,Đâu có đâu có, chỉ là cả ngày phải trên \Ntháp chỉ huy nên tôi có chút mong chờ thôi.
Dialogue: 0,0:13:30.28,0:13:32.00,VKH,Vương,0,0,0,,Tháp chỉ huy không có con gái sao?
Dialogue: 0,0:13:32.12,0:13:35.16,Lam Vũ,Trịnh,0,0,0,,Nhóm của chúng tôi không biết\N tại sao lại không có nữa,
Dialogue: 0,0:13:36.32,0:13:40.28,Lam Vũ,Trịnh,0,0,0,,bị dính lời nguyền rồi, tất cả đều \Nlà nhóm hòa thượng ATC.
Dialogue: 0,0:13:41.40,0:13:42.68,Vi Thảo,Phương,0,0,0,,À nói đến cái này thì...
Dialogue: 0,0:13:42.84,0:13:46.44,Vi Thảo,Phương,0,0,0,,BOSS của các cậu, Dụ Văn Châu độc\N thân hay đã có đối tượng rồi?
Dialogue: 0,0:13:47.36,0:13:49.20,Lam Vũ,Trịnh,0,0,0,,Đột nhiên nhắc đến cậu ấy làm gì?
Dialogue: 0,0:13:49.36,0:13:53.36,Vi Thảo,Phương,0,0,0,,Còn không phải là bởi vì trưởng ban Dụ tuổi trẻ \Ntài cao, trông thì lại nghiêm chỉnh rắn rỏi sao,
Dialogue: 0,0:13:53.64,0:13:56.20,Vi Thảo,Phương,0,0,0,,thực ra trong đội bay nhận \Nđược rất nhiều sự quan tâm đó,
Dialogue: 0,0:13:56.32,0:13:58.76,Vi Thảo,Phương,0,0,0,,Mấy chị em trong đội bay mỗi ngày đều\N tám chuyện, tôi nghe phát chán luôn rồi.
Dialogue: 0,0:14:00.96,0:14:04.08,Lam Vũ,Trịnh,0,0,0,,Sao tôi lại không biết kiểm soát \Nviên lại được đón nhận như thế.
Dialogue: 0,0:14:04.76,0:14:07.56,Lam Vũ,Trịnh,0,0,0,,Các tiếp viên cả ngày bay \Ncùng các cơ trưởng còn chưa đủ,
Dialogue: 0,0:14:07.80,0:14:09.96,Lam Vũ,Trịnh,0,0,0,,còn có ý định để tâm đến tháp chỉ huy nữa hả?
Dialogue: 0,0:14:10.48,0:14:11.60,Vi Thảo,Phương,0,0,0,,Tôi chỉ là...
Dialogue: 0,0:14:11.68,0:14:14.12,VKH,Vương,0,0,0,,Thật ngại quá, anh ấy cả ngày \Ntám chuyện khi đi làm quen rồi,
Dialogue: 0,0:14:14.20,0:14:15.64,VKH,Vương,0,0,0,,đi đến đâu cũng muốn nghe ngóng hết.
Dialogue: 0,0:14:15.76,0:14:17.48,Vi Thảo,Phương,0,0,0,,Vương Kiệt Hi! Tôi....
Dialogue: 0,0:14:18.00,0:14:23.96,Vi Thảo,Hứa,0,0,0,,Tôi lại nghe nói trưởng ban Dụ của các cậu trước đây dường như quen với thiên kim của cổ đông lớn hay là cấp cao trong cục gì đó.
Dialogue: 0,0:14:24.08,0:14:25.92,Vi Thảo,Hứa,0,0,0,,Trước đây các tiếp viên ở công ty có nói qua,
Dialogue: 0,0:14:26.16,0:14:28.56,Vi Thảo,Hứa,0,0,0,,họ của cô ấy rất đặc biệt nên tôi vô tình nhớ được.
Dialogue: 0,0:14:29.00,0:14:32.24,Lam Vũ,Trịnh,0,0,0,,À cái đó...
Dialogue: 0,0:14:32.40,0:14:36.00,Lam Vũ,Trịnh,0,0,0,,Nói ra thì cô tiếp viên nào ở đây \Ncó hứng thú với anh Dụ nhà tôi vậy?
Dialogue: 0,0:14:36.60,0:14:38.52,Lam Vũ,Trịnh,0,0,0,,Tôi có thể làm mai giúp cho.
Dialogue: 0,0:14:38.92,0:14:41.12,Lam Vũ,Trịnh,0,0,0,,Có trong đội bay hôm nay không?
Dialogue: 0,0:14:41.56,0:14:43.96,Vi Thảo,Phương,0,0,0,,Không có, tôi chỉ là tùy tiện hỏi chút thôi,
Dialogue: 0,0:14:44.12,0:14:47.76,Vi Thảo,Phương,0,0,0,,muốn giúp chị em trong đội \Nhỏi thăm chút xem có khả thi không ý mà.
Dialogue: 0,0:14:48.40,0:14:52.32,Lam Vũ,Trịnh,0,0,0,,Cái này tôi cũng không rõ lắm, hay là...
Dialogue: 0,0:14:53.24,0:14:56.00,Lam Vũ,Trịnh,0,0,0,,Dù sao thì tháp chỉ huy \Ncũng đâu thể chạy khỏi sân bay,
Dialogue: 0,0:14:56.32,0:15:01.96,Lam Vũ,Trịnh,0,0,0,,Các chị em có hứng thú muốn làm quen với trưởng ban của chúng tôi có thể trực tiếp đến dưới tháp chặn cậu ấy lại, không sao cả.
Dialogue: 0,0:15:02.72,0:15:07.84,Lam Vũ,Trịnh,0,0,0,,Dụ Văn Châu rất là dễ tính, độc thân \Nhay không thì hãy để các cô ấy tự đến hỏi đi.
Dialogue: 0,0:15:08.24,0:15:09.96,Vi Thảo,Phương,0,0,0,,Được rồi, tôi biết rồi.
Dialogue: 0,0:15:10.40,0:15:13.56,VKH,Vương,0,0,0,,Các cậu bớt tám chuyện lại \Nđược chưa, đồ ăn sắp nguội rồi.
Dialogue: 0,0:15:13.64,0:15:16.68,Vi Thảo,Phương,0,0,0,,...Còn cậu nữa? Bóc cua cho tôi.
Dialogue: 0,0:15:25.92,0:15:27.68,VKH,Vương,0,0,0,,Ngủ ngon, mai gặp.
Dialogue: 0,0:15:28.04,0:15:29.04,Lam Vũ,Trịnh,0,0,0,,Mai gặp lại.
Dialogue: 0,0:15:29.12,0:15:30.52,Vi Thảo,Hứa,0,0,0,,Cơ trưởng ngủ ngon.
Dialogue: 0,0:15:33.56,0:15:35.96,Vi Thảo,Phương,0,0,0,,Ê... Cậu nói xem cái tên Trịnh Hiên này,
Dialogue: 0,0:15:36.04,0:15:38.76,Vi Thảo,Phương,0,0,0,,rốt cuộc là thật sự không nhạy bén \Nhay là không biết ý tứ vậy.
Dialogue: 0,0:15:39.28,0:15:43.92,Vi Thảo,Phương,0,0,0,,Sao mà thái độ lại ngang bướng \Nhỏi gì cũng không chịu nói,
Dialogue: 0,0:15:43.96,0:15:49.36,Vi Thảo,Phương,0,0,0,,còn rất điêu luyện nữa, đúng là\N không thể trông mặt mà bắt hình dong.
Dialogue: 0,0:15:52.56,0:15:54.32,Vi Thảo,Phương,0,0,0,,Cậu cười cái gì?
Dialogue: 0,0:15:54.84,0:15:56.12,VKH,Vương,0,0,0,,Cười anh đó.
Dialogue: 0,0:15:56.52,0:15:59.44,VKH,Vương,0,0,0,,Trịnh Hiên trông có vẻ thản nhiên \Nnhưng thật ra rất thông minh,
Dialogue: 0,0:16:00.28,0:16:02.96,VKH,Vương,0,0,0,,khi đó thật sự không nhìn ra cậu ấy giả ngu với anh à?
Dialogue: 0,0:16:03.84,0:16:05.96,Vi Thảo,Phương,0,0,0,,Tôi nhìn ra rồi,
Dialogue: 0,0:16:06.04,0:16:09.40,Vi Thảo,Phương,0,0,0,,tôi chỉ là không hiểu cái tên\N mắt to mắt nhỏ cậu đang cười cái gì.
Dialogue: 0,0:16:10.24,0:16:16.04,VKH,Vương,0,0,0,,Tôi cười là bởi vì... cảm thấy \Ncó lẽ Dụ Văn Châu thật sự rất tốt.
Dialogue: 0,0:16:16.44,0:16:18.04,Vi Thảo,Phương,0,0,0,,Hả?
Dialogue: 0,0:16:18.28,0:16:22.08,VKH,Vương,0,0,0,,Anh nghĩ thử xem, Dụ Văn Châu quay lại cảng B,
Dialogue: 0,0:16:22.24,0:16:24.72,VKH,Vương,0,0,0,,tính cả thời gian chuẩn bị tối đa là hai tháng.
Dialogue: 0,0:16:25.36,0:16:27.48,VKH,Vương,0,0,0,,Tình đồng nghiệp hai tháng ngắn ngủi này,
Dialogue: 0,0:16:27.64,0:16:31.40,VKH,Vương,0,0,0,,đã có thể khiến cấp dưới không kiêng kỵ \Ngì mà nói đùa về cậu ấy trước mặt người khác,
Dialogue: 0,0:16:31.68,0:16:34.60,VKH,Vương,0,0,0,,nhưng cũng không tùy tiện nói \Nvề chuyện riêng tư của cậu ấy,
Dialogue: 0,0:16:34.68,0:16:37.00,VKH,Vương,0,0,0,,cho dù chỉ là tám chuyện chẳng ảnh hưởng gì cả.
Dialogue: 0,0:16:38.04,0:16:41.68,VKH,Vương,0,0,0,,Chứng tỏ khi Dụ Văn Châu là lãnh đạo của họ,
Dialogue: 0,0:16:42.08,0:16:45.48,VKH,Vương,0,0,0,,có thể không tạo ra cảm giác xa cách với cấp \Ndưới nhưng vẫn được mọi người công nhận.
Dialogue: 0,0:16:46.28,0:16:48.68,VKH,Vương,0,0,0,,Chỉ có thể là vì cách cư xử của cậu ấy tốt,
Dialogue: 0,0:16:48.84,0:16:50.92,VKH,Vương,0,0,0,,vậy nên được mọi người thật lòng tôn trọng...
Dialogue: 0,0:16:51.60,0:16:55.76,VKH,Vương,0,0,0,,Ừm, ít nhất có thể biết được \Nlà tính cách của cậu ấy rất tốt.
Dialogue: 0,0:16:57.76,0:17:01.60,Vi Thảo,Phương,0,0,0,,Như vậy mà cũng có thể liên kết được\N với nhau, cậu thật sự là hết thuốc chữa rồi.
Dialogue: 0,0:17:10.80,0:17:13.12,Vi Thảo,Hứa,0,0,0,,Hứa: Hôm nay vẫn quay về tháp chỉ huy để làm việc chứ?
Dialogue: 0,0:17:13.24,0:17:15.72,Lam Vũ,Trịnh,0,0,0,,Trịnh: Không, hôm nay tôi không có lịch trực.
Dialogue: 0,0:17:16.64,0:17:20.84,Lam Vũ,Trịnh,0,0,0,,Tôi chỉ quay về tìm trưởng ban báo cáo\N một chút về nội dung huấn luyện rồi đi ngay.
Dialogue: 0,0:17:22.60,0:17:23.76,Luân hồi,Chu,0,0,0,,Chu Trạch Khải: Chào đàn anh.
Dialogue: 0,0:17:23.88,0:17:26.52,VKH,Vương,0,0,0,,Vương: À, Tiểu Chu, vừa hạ cánh à?
Dialogue: 0,0:17:26.88,0:17:27.60,Luân hồi,Chu,0,0,0,,Vâng.
Dialogue: 0,0:17:27.80,0:17:28.84,VKH,Vương,0,0,0,,Vất vả rồi.
Dialogue: 0,0:17:29.92,0:17:32.80,VKH,Vương,0,0,0,,Hôm qua nhìn thấy biển quảng cáo \Ncủa cậu, được trưng khắp hành lang,
Dialogue: 0,0:17:33.32,0:17:34.28,VKH,Vương,0,0,0,,chụp rất đẹp.
Dialogue: 0,0:17:34.40,0:17:36.32,Luân hồi,Chu,0,0,0,,...Cảm ơn,
Dialogue: 0,0:17:36.40,0:17:38.52,VKH,Vương,0,0,0,,Vừa khéo gặp được nhau, muốn đi uống một ly không?
Dialogue: 0,0:17:39.15,0:17:39.72,Luân hồi,Chu,0,0,0,,Được thôi.
Dialogue: 0,0:17:44.28,0:17:46.44,Nữ,Tô,0,0,0,,Tô Mộc Tranh: Này, tiểu Chu, anh Kiệt Hi!
Dialogue: 0,0:17:46.92,0:17:48.32,Luân hồi,Chu,0,0,0,,Sao vậy?
Dialogue: 0,0:17:48.52,0:17:50.52,Nữ,Tô,0,0,0,,Không có gì, tôi đợi người thôi.
Dialogue: 0,0:17:51.84,0:17:53.68,VKH,Vương,0,0,0,,Giày hỏng rồi nên chờ người đưa tới?
Dialogue: 0,0:17:54.20,0:17:57.52,Nữ,Tô,0,0,0,,Không hổ danh là cơ trưởng Vương, quan sát nhạy bén thật.
Dialogue: 0,0:17:57.88,0:17:59.28,VKH,Vương,0,0,0,,Chân có bị bong gân không?
Dialogue: 0,0:17:59.92,0:18:04.08,VKH,Vương,0,0,0,,Mẫu mới trong bộ sưu tập xuân của Dior, \Nđau lòng chết đi được phải không?
Dialogue: 0,0:18:04.80,0:18:06.09,Nữ,Tô,0,0,0,,Tất nhiên rồi,
Dialogue: 0,0:18:06.24,0:18:09.96,Nữ,Tô,0,0,0,,Hoàng Thiếu Thiên nếu biết chưa được nửa tháng \Nem đã mang hư đôi giày cậu ấy tặng,
Dialogue: 0,0:18:10.04,0:18:12.04,Nữ,Tô,0,0,0,,sợ là sẽ càng đau lòng hơn.
Dialogue: 0,0:18:12.96,0:18:16.08,Nữ,Tô,0,0,0,,Mà này anh Kiệt Hi, anh am hiểu thật đó.
Dialogue: 0,0:18:16.56,0:18:19.72,VKH,Vương,0,0,0,,Suốt ngày mấy tiếp viên toàn nói về \Ncái này, anh muốn không biết cũng khó.
Dialogue: 0,0:18:20.40,0:18:22.80,Luân hồi,Chu,0,0,0,,Tôi... không biết.
Dialogue: 0,0:18:23.12,0:18:25.72,VKH,Vương,0,0,0,,Đây chính là sự khác biệt giữa thẳng nam và Gay đó.
Dialogue: 0,0:18:25.88,0:18:29.68,Nữ,Tô,0,0,0,,Chỉ là không cẩn thận ngã thôi, không \Ncó bị thương, chỉ là làm hư mất giày rồi.
Dialogue: 0,0:18:29.80,0:18:34.64,Nữ,Tô,0,0,0,,Trên đường gặp được bạn, cậu ấy giúp em đi mua giày rồi, hai người không cần quan tâm tới em đâu.
Dialogue: 0,0:18:34.92,0:18:37.36,VKH,Vương,0,0,0,,Thật sự không sao chứ? Anh có thể \Ncõng em đến phòng nghỉ ngơi.
Dialogue: 0,0:18:37.44,0:18:39.56,Nữ,Tô,0,0,0,,Đừng lo, không sao đâu.
Dialogue: 0,0:18:39.92,0:18:41.84,Nữ,Tô,0,0,0,,A, vị cứu tinh đã đến rồi.
Dialogue: 0,0:18:42.88,0:18:44.24,DVC,Dụ,0,0,0,,Dụ: Để cậu chờ lâu rồi Mộc Tranh.
Dialogue: 0,0:18:44.32,0:18:47.60,DVC,Dụ,0,0,0,,Cơ trưởng Vương? Tiểu Chu? Sao hai người lại ở đây?
Dialogue: 0,0:18:47.80,0:18:48.96,Luân hồi,Chu,0,0,0,,Chào đàn anh.
Dialogue: 0,0:18:49.60,0:18:51.72,Nữ,Tô,0,0,0,,Thật ngại quá, làm phiền cậu rồi Văn Châu.
Dialogue: 0,0:18:53.48,0:18:55.32,DVC,Dụ,0,0,0,,Cậu thử xem, tớ tùy tiện chọn vậy thôi.
Dialogue: 0,0:18:55.40,0:18:57.28,DVC,Dụ,0,0,0,,Tạm chấp nhận gu thẩm mỹ của thẳng nam nha，
Dialogue: 0,0:18:57.36,0:18:59.08,DVC,Dụ,0,0,0,,nếu cậu không thích có thể đi đổi lại.
Dialogue: 0,0:18:59.24,0:19:02.20,Nữ,Tô,0,0,0,,Không đổi đâu, đôi giày này trông rất đẹp.
Dialogue: 0,0:19:02.36,0:19:06.04,Nữ,Tô,0,0,0,,Màu sắc rất hợp với bộ quần áo tớ mặc\N hôm nay, còn nói là tùy tiện chọn nữa chứ.
Dialogue: 0,0:19:06.28,0:19:09.00,Nữ,Tô,0,0,0,,Biết là Dụ Văn Châu cậu việc gì \Ncũng chắc chắn sẽ làm được mà.
Dialogue: 0,0:19:09.32,0:19:11.68,Nữ,Tô,0,0,0,,Quả nhiên là có không ít kinh nghiệm nhỉ?
Dialogue: 0,0:19:12.40,0:19:17.00,Nữ,Tô,0,0,0,,Nếu là tiểu Chu chắc là sẽ mang \Nđôi dép lê lớn mang về ấy chứ.
Dialogue: 0,0:19:17.48,0:19:19.16,Luân hồi,Chu,0,0,0,,Dép lê, tiện lợi mà...
Dialogue: 0,0:19:19.92,0:19:22.36,DVC,Dụ,0,0,0,,Đừng nói vậy, nếu là tiểu Chu đi
Dialogue: 0,0:19:22.40,0:19:25.04,DVC,Dụ,0,0,0,,sẽ bị mắc kẹt ở cửa hàng miễn thuế không về sớm được đâu.
Dialogue: 0,0:19:25.20,0:19:26.80,DVC,Dụ,0,0,0,,Cậu thử xem, có vừa không?
Dialogue: 0,0:19:27.84,0:19:29.96,Nữ,Tô,0,0,0,,Vừa đẹp.
Dialogue: 0,0:19:30.12,0:19:34.48,Nữ,Tô,0,0,0,,Được cứu rồi, cảm ơn cậu nha Văn Châu,\N lần sau mời cậu ăn cơm.
Dialogue: 0,0:19:34.80,0:19:38.44,Nữ,Tô,0,0,0,,Đưa biên lai đây, tiền tớ sẽ bảo\N Hoàng Thiếu Thiên đưa cho cậu.
Dialogue: 0,0:19:38.92,0:19:41.12,Nữ,Tô,0,0,0,,Tớ đang vội lắm.
Dialogue: 0,0:19:41.84,0:19:43.72,DVC,Dụ,0,0,0,,Ừm, cậu đi nhanh đi, cẩn thận tí nha.
Dialogue: 0,0:19:43.84,0:19:46.68,Nữ,Tô,0,0,0,,Cũng cảm ơn hai vị cơ trưởng đây\N đã quan tâm, lần sau lại nói tiếp nha.
Dialogue: 0,0:19:51.56,0:19:56.08,VKH,Vương,0,0,0,,Đây, cái áo khoác cô ấy vừa phủ \Nlên chân là của cậu phải không?
Dialogue: 0,0:19:56.40,0:19:58.88,DVC,Dụ,0,0,0,,Đúng vậy, cảm ơn.
Dialogue: 0,0:20:01.12,0:20:02.28,DVC,Dụ,0,0,0,,Các anh vừa bay về hả?
Dialogue: 0,0:20:02.44,0:20:05.40,DVC,Dụ,0,0,0,,À đúng rồi, cơ trưởng Vương, thật là \Nngại quá sát giờ lại đổi danh sách cùng bay.
Dialogue: 0,0:20:05.48,0:20:07.60,DVC,Dụ,0,0,0,,Phiền anh trước đó phải chăm sóc \NTrịnh Hiên nhà chúng tôi rồi.
Dialogue: 0,0:20:08.56,0:20:10.76,VKH,Vương,0,0,0,,Đâu có, khách sáo quá rồi.
Dialogue: 0,0:20:11.88,0:20:14.60,Luân hồi,Chu,0,0,0,,Vừa hẹn uống rượu, đàn anh muốn đi cùng không?
Dialogue: 0,0:20:15.32,0:20:16.28,DVC,Dụ,0,0,0,,Được thôi.
Dialogue: 0,0:20:16.48,0:20:19.08,DVC,Dụ,0,0,0,,Mà này biển quảng cáo đó tôi \Nnhìn thấy rồi, chụp rất đẹp trai.
Dialogue: 0,0:20:19.20,0:20:21.44,Luân hồi,Chu,0,0,0,,Đâu có...
Dialogue: 0,0:20:21.56,0:20:23.64,VKH,Vương,0,0,0,,Phải là chụp rất đáng yêu.
Dialogue: 0,0:20:24.24,0:20:27.60,DVC,Dụ,0,0,0,,Nhưng mà vẫn là người thật \Nđáng yêu hơn, phải không.
Dialogue: 0,0:20:28.29,0:20:29.44,VKH,Vương,0,0,0,,Đương nhiên rồi.
Dialogue: 0,0:20:30.92,0:20:32.28,Luân hồi,Chu,0,0,0,,Nào có...
Dialogue: 0,0:20:39.32,0:20:41.12,VKH,Vương,0,0,0,,Trước đây các cậu có quen nhau hả?
Dialogue: 0,0:20:41.56,0:20:43.28,DVC,Dụ,0,0,0,,Tôi và Thiếu Thiên là bạn đại học,
Dialogue: 0,0:20:43.36,0:20:45.72,DVC,Dụ,0,0,0,,Có một số môn học cùng nhau, quan hệ rất tốt.
Dialogue: 0,0:20:45.88,0:20:47.52,DVC,Dụ,0,0,0,,Tiểu Chu là đàn em cùng ngành với Thiếu Thiên.
Dialogue: 0,0:20:47.64,0:20:48.64,VKH,Vương,0,0,0,,Ừm.
Dialogue: 0,0:20:49.80,0:20:51.80,DVC,Dụ,0,0,0,,Chúng tôi thường đùa với nhau,
Dialogue: 0,0:20:51.84,0:20:54.12,DVC,Dụ,0,0,0,,nói là nam thần của hàng không \NVinh Quang không dễ gì mà mở miệng,
Dialogue: 0,0:20:54.24,0:20:57.08,DVC,Dụ,0,0,0,,chỉ nói chuyện một lần khi hạ cánh với ATC\N là bằng số chữ nói trong cả ngày.
Dialogue: 0,0:20:57.12,0:20:59.85,DVC,Dụ,0,0,0,,Tháp chỉ huy cảm thấy rất vinh hạnh.
Dialogue: 0,0:21:00.98,0:21:02.05,VKH,Vương,0,0,0,,Cậu tha cho tiểu Chu đi.
Dialogue: 0,0:21:02.78,0:21:05.91,DVC,Dụ,0,0,0,,Được rồi, trong lần huấn luyện này Trịnh Hiên vẫn ổn chứ?
Dialogue: 0,0:21:05.91,0:21:09.08,VKH,Vương,0,0,0,,Cậu ấy rất xuất sắc, tuy là người có hơi thảnh thơi,
Dialogue: 0,0:21:09.08,0:21:13.55,VKH,Vương,0,0,0,,nhưng làm việc rất tốt, trưởng ban Dụ thật biết cách chỉ bảo.
Dialogue: 0,0:21:15.01,0:21:17.61,DVC,Dụ,0,0,0,,Là người trước kia dẫn dắt tốt, tôi chỉ vừa mới quay về mà thôi.
Dialogue: 0,0:21:19.56,0:21:21.51,VKH,Vương,0,0,0,,Sau khi quay lại, vẫn còn quen với mọi thứ chứ?
Dialogue: 0,0:21:23.11,0:21:24.65,DVC,Dụ,0,0,0,,Ừm... hệ thống không quá giống,
Dialogue: 0,0:21:24.65,0:21:27.75,DVC,Dụ,0,0,0,,cảng G vẫn giữ nguyên hệ thống cũ, \Nnhưng cảng B thì toàn là định vị GPS,
Dialogue: 0,0:21:27.75,0:21:30.68,DVC,Dụ,0,0,0,,như vậy còn giúp tiết kiệm thời gian và nâng cao hiệu suất bay.
Dialogue: 0,0:21:30.68,0:21:34.51,VKH,Vương,0,0,0,,Nhưng GPS cũng có khả năng mất hiệu lực mà?
Dialogue: 0,0:21:34.51,0:21:38.41,DVC,Dụ,0,0,0,,Đúng vậy, nên là khóa học của ATC vẫn bao gồm huấn luyện quản lí điều khiển mà không cần điều hướng.
Dialogue: 0,0:21:38.41,0:21:41.25,DVC,Dụ,0,0,0,,Tuy là thế hệ kiểm soát viên này của chúng tôi \Ngần như không có kinh nghiệm thực tế...
Dialogue: 0,0:21:41.25,0:21:44.21,DVC,Dụ,0,0,0,,nhưng mà tháp chỉ huy hiển nhiên \Nsẵn sàng ứng phó bất kỳ tình huống nào,
Dialogue: 0,0:21:44.21,0:21:45.51,DVC,Dụ,0,0,0,,xin hai vị cơ trưởng yên tâm,
Dialogue: 0,0:21:45.51,0:21:47.01,DVC,Dụ,0,0,0,,đừng làm ra vẻ nghiêm túc vậy.
Dialogue: 0,0:21:49.58,0:21:56.11,Nữ,,0,0,0,,Bạn nữ A: Văn Châu? Lâu rồi không gặp, \Nmuốn uống một ly không?
Dialogue: 0,0:21:57.28,0:21:59.68,DVC,Dụ,0,0,0,,À được... Xin phép thất lễ một chút.
Dialogue: 0,0:22:03.30,0:22:04.12,Luân hồi,Chu,0,0,0,,Ở đây thêm một phần thịt hun khói.
Dialogue: 0,0:22:05.06,0:22:07.18,VKH,Vương,0,0,0,,Uống nhiều như vậy? Ngày mai không bay sao?
Dialogue: 0,0:22:07.76,0:22:11.16,DVC,Dụ,0,0,0,,Xin lỗi, lịch trực vẫn chưa có nên tôi cũng không thể chắc chắn được.
Dialogue: 0,0:22:13.40,0:22:16.12,Nữ,,0,0,0,,Cậu đó, không muốn đi thì cứ nói không muốn.
Dialogue: 0,0:22:16.04,0:22:16.54,VKH,Vương,0,0,0,,Không sao cả,
Dialogue: 0,0:22:16.54,0:22:19.68,Nữ,A,0,0,0,,Nếu muốn đi cậu sẽ nói đợi rồi hẹn giờ gặp,
Dialogue: 0,0:22:19.72,0:22:20.56,VKH,Vương,0,0,0,,tôi cũng uống thêm một ly nữa.
Dialogue: 0,0:22:20.56,0:22:21.65,Nữ,A,0,0,0,,cậu luôn như vậy mà.
Dialogue: 0,0:22:22.10,0:22:24.28,DVC,Dụ,0,0,0,,Haha, tôi sợ là tôi sẽ bận cả tháng.
Dialogue: 0,0:22:29.00,0:22:29.98,DVC,Dụ,0,0,0,,Xin lỗi, tôi quay lại rồi...
Dialogue: 0,0:22:30.56,0:22:31.46,DVC,Dụ,0,0,0,,Tiểu Chu sao vậy?
Dialogue: 0,0:22:32.48,0:22:34.78,VKH,Vương,0,0,0,,Ừm, uống nhiều quá nên ngủ rồi.
Dialogue: 0,0:22:36.88,0:22:39.18,VKH,Vương,0,0,0,,Tiểu Chu... thật sự là rất đáng yêu.
Dialogue: 0,0:22:40.30,0:22:43.41,VKH,Vương,0,0,0,,Đúng vậy, vừa rồi là... bạn gái hả?
Dialogue: 0,0:22:45.02,0:22:46.85,DVC,Dụ,0,0,0,,Không phải, từng hẹn gặp hai lần mà thôi.
Dialogue: 0,0:22:47.56,0:22:49.48,DVC,Dụ,0,0,0,,Cơ trưởng Vương thì sao? Gần đây có người đồng hành chưa?
Dialogue: 0,0:22:51.10,0:22:51.48,VKH,Vương,0,0,0,,Không có.
Dialogue: 0,0:22:52.44,0:22:53.18,DVC,Dụ,0,0,0,,Thật không ngờ nha.
Dialogue: 0,0:22:58.46,0:23:00.65,VKH,Vương,0,0,0,,Uống thêm ly nữa không? Tôi mời cậu?
Dialogue: 0,0:23:01.66,0:23:04.35,DVC,Dụ,0,0,0,,Được thôi... Tiểu Chu cậu?
Dialogue: 0,0:23:04.35,0:23:06.86,Luân hồi,Chu,0,0,0,,Đánh răng, đi ngủ.
Dialogue: 0,0:23:08.60,0:23:10.00,VKH,Vương,0,0,0,,Đây là uống say rồi hả?
Dialogue: 0,0:23:11.68,0:23:12.94,DVC,Dụ,0,0,0,,Nhìn thì có vẻ là vậy.
Dialogue: 0,0:23:13.90,0:23:15.04,Luân hồi,Chu,0,0,0,,Thanh toán trước,
Dialogue: 0,0:23:15.88,0:23:16.88,Luân hồi,Chu,0,0,0,,về nhà đây.
Dialogue: 0,0:23:17.26,0:23:18.95,VKH,Vương,0,0,0,,Tiểu Chu cậu đừng đi....
Dialogue: 0,0:23:19.96,0:23:21.31,DVC,Dụ,0,0,0,,Như vậy chắc chắn là uống say rồi.
Dialogue: 0,0:23:21.84,0:23:24.21,VKH,Vương,0,0,0,,Tôi đi theo xem xem, không thì \Nsẽ ngã bên đường mất.
Dialogue: 0,0:23:34.96,0:23:36.10,VKH,Vương,0,0,0,,Đưa cậu ấy lên xe rồi.
Dialogue: 0,0:23:39.50,0:23:41.31,DVC,Dụ,0,0,0,,Sao thế? Anh cũng muốn đi hả?
Dialogue: 0,0:23:41.98,0:23:45.44,VKH,Vương,0,0,0,,Không... không có, còn sớm mà.
Dialogue: 0,0:23:46.58,0:23:49.55,DVC,Dụ,0,0,0,,Vậy được rồi, thật ra tôi vẫn muốn \Nở đây với anh một lúc nữa...
Dialogue: 0,0:23:49.92,0:23:51.35,DVC,Dụ,0,0,0,,Để tôi mời cho.
Dialogue: 0,0:23:51.34,0:23:52.21,DVC,Dụ,0,0,0,,Một Cola Bourbon.
Dialogue: 0,0:23:52.78,0:23:55.01,DVC,Dụ,0,0,0,,Tỉ lệ 4:1? Tôi thấy tối nay anh toàn uống cái này,
Dialogue: 0,0:23:55.48,0:23:57.01,DVC,Dụ,0,0,0,,hay là anh muốn gọi cái khác?
Dialogue: 0,0:23:57.88,0:24:00.11,VKH,Vương,0,0,0,,Không cần, uống cái đó là được rồi.
Dialogue: 0,0:24:04.94,0:24:07.21,DVC,Dụ,0,0,0,,Có thể hỏi là tại sao anh lại muốn làm phi công không?
Dialogue: 0,0:24:08.22,0:24:10.68,VKH,Vương,0,0,0,,Lái máy bay là ước mơ của không ít nam sinh mà,
Dialogue: 0,0:24:11.54,0:24:13.11,VKH,Vương,0,0,0,,nhất định là phải có lí do đặc biệt nào sao?
Dialogue: 0,0:24:13.88,0:24:14.68,DVC,Dụ,0,0,0,,Vậy sao?
Dialogue: 0,0:24:15.52,0:24:17.32,DVC,Dụ,0,0,0,,Có lẽ tôi không phải là nam sinh bình thường rồi.
Dialogue: 0,0:24:18.06,0:24:21.11,VKH,Vương,0,0,0,,Hửm? Chẳng lẽ... cậu sợ độ cao sao?
Dialogue: 0,0:24:22.34,0:24:24.92,DVC,Dụ,0,0,0,,Không đến mức sợ độ cao, nhưng \Ncũng không có đặc biệt thích.
Dialogue: 0,0:24:27.44,0:24:29.76,VKH,Vương,0,0,0,,Khi tôi còn nhỏ có đi trại hè ở Honolulu*,
Dialogue: 0,0:24:27.44,0:24:29.76,Chú thích,,0,0,0,,*Honolulu là thủ phủ của tiểu bang Hawaii của Hoa Kỳ.
Dialogue: 0,0:24:30.18,0:24:36.41,VKH,Vương,0,0,0,,được ngồi trực thăng ngắm cảnh \Nmột lần, có lẽ lúc đó khoảng 10 tuổi.
Dialogue: 0,0:24:37.48,0:24:40.66,VKH,Vương,0,0,0,,Từ độ cao đó nhìn xuống khác hoàn toàn với nhìn từ mặt đất.
Dialogue: 0,0:24:41.81,0:24:43.51,VKH,Vương,0,0,0,,Vốn dĩ tôi muốn lái trực thăng,
Dialogue: 0,0:24:44.26,0:24:45.94,VKH,Vương,0,0,0,,nhưng sau này nghe nói lái máy bay có thể bay cao hơn,
Dialogue: 0,0:24:46.46,0:24:48.00,VKH,Vương,0,0,0,,vậy nên mới giống như bây giờ nè.
Dialogue: 0,0:24:53.00,0:24:54.24,VKH,Vương,0,0,0,,Cậu có ý kiến gì à ?
Dialogue: 0,0:24:54.38,0:24:57.90,DVC,Dụ,0,0,0,,Chỉ là nghĩ đến anh học lái máy bay \Nở Hawaii giống như Conan vậy,
Dialogue: 0,0:24:57.90,0:25:00.46,DVC,Dụ,0,0,0,,nên có chút nhịn không được..., thật ngại quá.
Dialogue: 0,0:25:02.61,0:25:04.04,VKH,Vương,0,0,0,,Tôi thấy là cậu uống say rồi đó,
Dialogue: 0,0:25:04.36,0:25:06.15,VKH,Vương,0,0,0,,tôi cũng đâu phải là học lái máy bay ở Hawaii đâu.
Dialogue: 0,0:25:06.40,0:25:07.85,DVC,Dụ,0,0,0,,Vậy anh biết lái trực thăng không?
Dialogue: 0,0:25:08.06,0:25:12.14,VKH,Vương,0,0,0,,Không hẳn là biết, chỉ lái qua \Nmột lần ở một trại trải nghiệm thôi.
Dialogue: 0,0:25:12.46,0:25:13.24,DVC,Dụ,0,0,0,,Ở đâu?
Dialogue: 0,0:25:14.26,0:25:15.31,VKH,Vương,0,0,0,,Hawaii.
Dialogue: 0,0:25:23.54,0:25:26.18,VKH,Vương,0,0,0,,Còn cậu, tại sao lại làm kiểm soát viên?
Dialogue: 0,0:25:28.14,0:25:29.08,DVC,Dụ,0,0,0,,Cái này thì...
Dialogue: 0,0:25:35.54,0:25:37.58,VKH,Vương,0,0,0,,Cà phê mới xay ở cảng số 2...
Dialogue: 0,0:25:38.34,0:25:40.81,VKH,Vương,0,0,0,,Tôi nghi ngờ là họ đã đắc tội với nhà cung cấp...
Dialogue: 0,0:25:41.60,0:25:43.22,VKH,Vương,0,0,0,,giảm xuống mức trung bình luôn rồi...
Dialogue: 0,0:25:44.96,0:25:47.85,DVC,Dụ,0,0,0,,Vậy sao? Tôi nhất định phải đi thử mới được.
Dialogue: 0,0:25:48.66,0:25:50.45,DVC,Dụ,0,0,0,,Mỗi lần tôi qua đó đều sẽ uống cà phê cô đặc.
Dialogue: 0,0:25:53.50,0:25:57.55,VKH,Vương,0,0,0,,Đừng... không cần thiết...
Dialogue: 0,0:25:59.06,0:26:02.25,VKH,Vương,0,0,0,,Lần sau tôi bay đến \NNam Mỹ, sẽ mang cho cậu...
Dialogue: 0,0:26:03.80,0:26:06.15,VKH,Vương,0,0,0,,Thêm một ly nữa, cảm ơn.
Dialogue: 0,0:26:08.02,0:26:11.68,DVC,Dụ,0,0,0,,Thật sự muốn uống nữa? \NHình như anh hơi say rồi đó.
Dialogue: 0,0:26:12.82,0:26:13.76,VKH,Vương,0,0,0,,Tôi không có say...
Dialogue: 0,0:26:13.92,0:26:16.66,VKH,Vương,0,0,0,,Không sao hết, ngày mai không cần bay.
Dialogue: 0,0:26:33.80,0:26:35.24,VKH,Vương,0,0,0,,Vương: Dụ Văn Châu??
Dialogue: 0,0:26:36.88,0:26:37.76,DVC,Dụ,0,0,0,,Dụ: Anh tỉnh rồi à?
Dialogue: 0,0:26:38.92,0:26:40.14,VKH,Vương,0,0,0,,Tôi sao vậy?
Dialogue: 0,0:26:41.12,0:26:42.31,DVC,Dụ,0,0,0,,Anh cẩn thận chút!
Dialogue: 0,0:26:44.06,0:26:47.25,VKH,Vương,0,0,0,,Xin lỗi, có phải là tôi ngủ quên không?
Dialogue: 0,0:26:48.18,0:26:50.82,DVC,Dụ,0,0,0,,Phi công mấy anh có truyền thống \Nuống nhiều thì sẽ ngủ hả?
Dialogue: 0,0:26:51.66,0:26:53.05,DVC,Dụ,0,0,0,,Đến đây, uống một ly trà nóng đi.
Dialogue: 0,0:26:57.22,0:26:58.20,VKH,Vương,0,0,0,,Mấy giờ rồi?
Dialogue: 0,0:26:58.80,0:27:00.82,DVC,Dụ,0,0,0,,4 giờ, các quán rượu đều phải đóng cửa hết rồi.
Dialogue: 0,0:27:01.40,0:27:03.24,DVC,Dụ,0,0,0,,Vừa lúc anh tỉnh, chúng ta nên đi thôi.
Dialogue: 0,0:27:04.88,0:27:07.80,VKH,Vương,0,0,0,,Tôi xin lỗi, tôi thật là...
Dialogue: 0,0:27:08.30,0:27:11.28,VKH,Vương,0,0,0,,Tôi say rồi cậu cũng không cần đợi tôi đến giờ này đâu...
Dialogue: 0,0:27:12.74,0:27:16.16,DVC,Dụ,0,0,0,,Tôi thật sự không ngờ, cơ trưởng Vương thế mà...
Dialogue: 0,0:27:16.90,0:27:18.96,VKH,Vương,0,0,0,,Hả? Tôi đã nói gì rồi à?
Dialogue: 0,0:27:19.88,0:27:21.48,DVC,Dụ,0,0,0,,Haha.
Dialogue: 0,0:27:21.56,0:27:25.10,DVC,Dụ,0,0,0,,Sau khi anh uống say rồi thì \Nluôn giảng về Boeing 777 và 787,
Dialogue: 0,0:27:25.30,0:27:26.26,DVC,Dụ,0,0,0,,trịnh trọng lắm.
Dialogue: 0,0:27:26.38,0:27:28.76,DVC,Dụ,0,0,0,,Ban đầu tôi cũng không biết là anh nghiêm túc hay là say rồi...
Dialogue: 0,0:27:29.16,0:27:33.04,DVC,Dụ,0,0,0,,Anh nhất quyết giảng từ lịch sử phát triển của hàng không dân dụng đến so sánh cánh máy bay với lực bay lên,
Dialogue: 0,0:27:33.10,0:27:35.28,DVC,Dụ,0,0,0,,ngay cả việc tiêu thụ nhiên liệu với \Nlực đẩy ngược cũng không bỏ sót cái nào,
Dialogue: 0,0:27:35.41,0:27:37.06,DVC,Dụ,0,0,0,,Còn ép tôi phải ghi chép lại nữa...
Dialogue: 0,0:27:38.30,0:27:39.36,DVC,Dụ,0,0,0,,Anh xem.
Dialogue: 0,0:27:41.14,0:27:42.76,VKH,Vương,0,0,0,,...Không cần xem đâu...
Dialogue: 0,0:27:43.90,0:27:45.24,DVC,Dụ,0,0,0,,Anh cũng không cho tôi đi về,
Dialogue: 0,0:27:45.24,0:27:48.44,DVC,Dụ,0,0,0,,nói là muốn xác nhận xem \Ntôi có học không, muốn kiểm tra...
Dialogue: 0,0:27:49.10,0:27:52.18,VKH,Vương,0,0,0,,Tôi uống say rồi, cậu không cần \Nlằng nhằng với con ma men đâu...
Dialogue: 0,0:27:53.34,0:27:54.98,VKH,Vương,0,0,0,,Trực tiếp đuổi tôi đi là được rồi.
Dialogue: 0,0:27:56.20,0:27:57.38,DVC,Dụ,0,0,0,,Thật ra cũng rất thú vị,
Dialogue: 0,0:27:57.48,0:28:00.18,DVC,Dụ,0,0,0,,hơn nữa tôi không biết nhà của anh \Nở đâu, nhưng rồi anh lại nằm bất tỉnh luôn,
Dialogue: 0,0:28:00.18,0:28:01.58,DVC,Dụ,0,0,0,,tôi không yên tâm để anh một mình ở lại.
Dialogue: 0,0:28:02.10,0:28:03.72,DVC,Dụ,0,0,0,,Không sao, tôi hôm nay không có lịch trực.
Dialogue: 0,0:28:04.86,0:28:07.68,VKH,Vương,0,0,0,,Tôi... tôi có nói cái gì khác nữa không?
Dialogue: 0,0:28:08.48,0:28:10.08,DVC,Dụ,0,0,0,,Ngoài Boeing ra hả?
Dialogue: 0,0:28:12.00,0:28:14.90,DVC,Dụ,0,0,0,,Để tôi nghĩ xem... À đúng rồi.
Dialogue: 0,0:28:15.28,0:28:15.90,VKH,Vương,0,0,0,,Cái gì?
Dialogue: 0,0:28:16.60,0:28:17.74,DVC,Dụ,0,0,0,,Bạch nguyệt quang là ai?
Dialogue: 0,0:28:17.88,0:28:19.96,DVC,Dụ,0,0,0,,Anh có nhắc đến cái này nhưng tôi nghe không hiểu.
Dialogue: 0,0:28:20.54,0:28:24.20,VKH,Vương,0,0,0,,À... không có ai hết, tôi cũng không biết là ai.
Dialogue: 0,0:28:25.36,0:28:27.18,DVC,Dụ,0,0,0,,Vậy không có gì nữa rồi, về chứ?
Dialogue: 0,0:28:27.68,0:28:30.20,VKH,Vương,0,0,0,,À... hôm nay thật sự làm phiền cậu rồi,
Dialogue: 0,0:28:30.72,0:28:32.74,VKH,Vương,0,0,0,,để tôi mời khách, hơn nữa \Ntôi nhất định phải trả,
Dialogue: 0,0:28:33.50,0:28:35.16,VKH,Vương,0,0,0,,À mà nhà cậu ở đâu?
Dialogue: 0,0:28:35.84,0:28:38.30,VKH,Vương,0,0,0,,Gọi xe về đi, tôi trả tiền cho cậu.
Dialogue: 0,0:28:39.14,0:28:42.14,DVC,Dụ,0,0,0,,Tôi ở kí túc xá sân bay, không cần \Nphiền vậy đâu, tôi đi bộ về là được.
Dialogue: 0,0:28:43.00,0:28:44.88,DVC,Dụ,0,0,0,,Nhưng mà còn 36 phút nữa là mặt trời mọc,
Dialogue: 0,0:28:45.04,0:28:47.42,DVC,Dụ,0,0,0,,hay là chờ đến lúc đó rồi cùng đi ăn sáng?
Dialogue: 0,0:28:47.98,0:28:50.32,DVC,Dụ,0,0,0,,Trước đây Mộc Tranh có giới thiệu \Nmột quán ăn sáng gần đây,
Dialogue: 0,0:28:50.98,0:28:52.76,DVC,Dụ,0,0,0,,anh thích tào phớ hay là bánh bao chiên?
Dialogue: 0,0:28:53.22,0:28:55.80,VKH,Vương,0,0,0,,Tôi... cái nào cũng được.
Dialogue: 0,0:28:57.08,0:28:59.20,DVC,Dụ,0,0,0,,Nè, trước đó anh nói muốn kiểm tra tôi,
Dialogue: 0,0:28:59.20,0:29:00.84,DVC,Dụ,0,0,0,,còn nói đúng hết rồi muốn mời tôi ăn sáng,
Dialogue: 0,0:29:01.16,0:29:02.98,DVC,Dụ,0,0,0,,không thể nuốt lời đâu nhé cơ trưởng Vương.
Dialogue: 0,0:29:04.26,0:29:06.44,VKH,Vương,0,0,0,,Tha cho tôi đi trưởng ban Dụ...
Dialogue: 0,0:29:07.34,0:29:10.86,DVC,Dụ,0,0,0,,Được thôi, nhưng mà anh gọi tên tôi \Nlà được rồi, như này thì xa lạ quá.
Dialogue: 0,0:29:11.90,0:29:15.88,VKH,Vương,0,0,0,,Ừm, vậy thì... Dụ Văn Châu?
Dialogue: 0,0:29:16.82,0:29:18.42,VKH,Vương,0,0,0,,Cậu cũng không cần gọi tôi là cơ trưởng đâu.
Dialogue: 0,0:29:19.06,0:29:21.82,DVC,Dụ,0,0,0,,Vậy thì "Kiệt Hi"? \NGọi như vậy được không?
Dialogue: 0,0:29:22.18,0:29:25.68,VKH,Vương,0,0,0,,Được! Đi thôi. Mời cậu ăn sáng.
Dialogue: 0,0:29:43.22,0:29:44.78,Vi Thảo,Phương,0,0,0,,Phương: Đồ quỷ ma không đứng đắn!
Dialogue: 0,0:29:45.02,0:29:48.15,Vi Thảo,Phương,0,0,0,,Vương Kiệt Hi, cậu không được phép \Nkết giao với người ăn tào phớ ngọt.
Dialogue: 0,0:29:48.54,0:29:50.56,Vi Thảo,Phương,0,0,0,,Tôi chỉ không trông chừng cậu một đêm thôi,
Dialogue: 0,0:29:50.80,0:29:53.38,Vi Thảo,Phương,0,0,0,,thế mà lại cùng nam thần \Nuống rượu, còn uống say nữa chứ.
Dialogue: 0,0:29:53.58,0:29:55.48,Vi Thảo,Phương,0,0,0,,Tôi còn cho rằng cậu là chính nhân quân tử!
Dialogue: 0,0:29:56.20,0:29:57.40,VKH,Vương,0,0,0,,Vương: Tôi cũng có làm gì đâu.
Dialogue: 0,0:29:58.40,0:30:00.78,Vi Thảo,Phương,0,0,0,,Haha... Tôi đương nhiên biết là vậy,
Dialogue: 0,0:30:01.00,0:30:04.58,Vi Thảo,Phương,0,0,0,,đức hạnh khi say của cậu hoàn toàn \Nkhông phải kiểu say rượu loạn tính.
Dialogue: 0,0:30:05.16,0:30:08.80,Vi Thảo,Phương,0,0,0,,Mà này cậu có phải đã giảng cho cậu ấy...
Dialogue: 0,0:30:10.52,0:30:11.70,VKH,Vương,0,0,0,,Đúng vậy...
Dialogue: 0,0:30:12.22,0:30:17.22,Vi Thảo,Phương,0,0,0,,Hahahaha...
Dialogue: 0,0:30:17.44,0:30:20.68,Vi Thảo,Phương,0,0,0,,Cậu... cậu thật sự giảng cho cậu ấy sao?
Dialogue: 0,0:30:21.64,0:30:24.58,Vi Thảo,Phương,0,0,0,,Trời ơi! Xong rồi xong rồi.
Dialogue: 0,0:30:24.58,0:30:27.54,Vi Thảo,Phương,0,0,0,,Cậu ấy có phản ứng gì với \Nlớp học Boeing 777 của cậu không?
Dialogue: 0,0:30:27.78,0:30:29.60,Vi Thảo,Phương,0,0,0,,Chắc là cạn lời luôn nhỉ?
Dialogue: 0,0:30:30.78,0:30:34.30,VKH,Vương,0,0,0,,...Có cạn lời hay không thì không biết, \Nnhưng tôi còn khảo bài cậu ấy nữa.
Dialogue: 0,0:30:35.68,0:30:40.78,Vi Thảo,Phương,0,0,0,,Thế mà lại có người chịu được cái này \Nmà không đánh cậu hay là đuổi cậu đi hả?
Dialogue: 0,0:30:41.54,0:30:44.64,Vi Thảo,Phương,0,0,0,,Nam thần của cậu không phải \Nngười bình thường đâu...
Dialogue: 0,0:30:46.62,0:30:47.78,VKH,Vương,0,0,0,,Đúng là không bình thường,
Dialogue: 0,0:30:47.88,0:30:50.90,VKH,Vương,0,0,0,,hơn nữa cậu ấy còn trả lời \Nđúng hết luôn, thật sự thông minh.
Dialogue: 0,0:30:51.20,0:30:56.22,Vi Thảo,Phương,0,0,0,,Vương Kiệt Hi, cái nụ cười tự hào \Nđáng buồn nôn này của cậu là sao đây?
Dialogue: 0,0:30:56.42,0:30:58.16,Vi Thảo,Phương,0,0,0,,Đây không phải là Vương Kiệt Hi mà tôi biết.
Dialogue: 0,0:30:59.58,0:31:01.38,VKH,Vương,0,0,0,,Cậu ấy là người đầu tiên trả lời đúng hết đó.
Dialogue: 0,0:31:02.52,0:31:07.12,Vi Thảo,Phương,0,0,0,,Đó là bởi vì người khác không thể \Nchịu đựng được cậu đến cuối 
Dialogue: 0,0:31:07.18,0:31:08.62,Vi Thảo,Phương,0,0,0,,mà phải đuổi cậu đi giữa chừng!
Dialogue: 0,0:31:09.20,0:31:14.50,Vi Thảo,Phương,0,0,0,,Điều này có nghĩa là nam thần của cậu tính tình tốt lại không nỡ từ chối người khác thôi, hiểu không?
Dialogue: 0,0:31:15.16,0:31:17.02,VKH,Vương,0,0,0,,Sau đó chúng tôi còn đi ăn sáng nữa.
Dialogue: 0,0:31:17.42,0:31:21.54,Vi Thảo,Phương,0,0,0,,Tôi nói rồi, không được giao du \Nvới người ăn tào phớ ngọt.
Dialogue: 0,0:31:22.14,0:31:24.20,VKH,Vương,0,0,0,,Cậu ấy nói cậu ấy chưa từng ăn tào phớ mặn,
Dialogue: 0,0:31:24.26,0:31:28.08,VKH,Vương,0,0,0,,tôi bảo cậu ấy thử xem sao, \Ncậu ấy liền thử, còn rất thích nữa đó.
Dialogue: 0,0:31:28.68,0:31:32.94,VKH,Vương,0,0,0,,Anh nhìn người khác rồi nhìn lại mình đi, \Ncó hiểu thế nào gọi là bao dung không?
Dialogue: 0,0:31:34.86,0:31:37.86,Vi Thảo,Phương,0,0,0,,...Lập trường không vững, không có \Nnguyên tắc, vậy là chết rồi!
Dialogue: 0,0:31:39.36,0:31:43.44,VKH,Vương,0,0,0,,Tôi thấy cậu ấy là người sẵn sàng thử sức, \Nkhông có thành kiến với bất kì điều gì.
Dialogue: 0,0:31:43.76,0:31:45.14,VKH,Vương,0,0,0,,Như vậy không phải rất tốt sao?
Dialogue: 0,0:31:48.30,0:31:49.76,VKH,Vương,0,0,0,,Sao anh không nói nữa?
Dialogue: 0,0:31:52.94,0:31:55.30,Vi Thảo,Phương,0,0,0,,Nhưng cậu biết đấy, \Ntính hướng của một người,
Dialogue: 0,0:31:55.30,0:31:58.34,Vi Thảo,Phương,0,0,0,,không phải là tào phớ ngọt hay là \Ntào phớ mặn, nói thử là thử được,
Dialogue: 0,0:31:58.84,0:32:01.44,Vi Thảo,Phương,0,0,0,,Ngay cả khi cậu ấy không có \Nthành kiến với Gay các cậu đi nữa,
Dialogue: 0,0:32:01.54,0:32:04.60,Vi Thảo,Phương,0,0,0,,cũng không có nghĩa là cởi mở \Nvới xu hướng tính dục của bản thân.
Dialogue: 0,0:32:04.94,0:32:08.04,Vi Thảo,Phương,0,0,0,,Dù Dụ Văn Châu có tốt đến đâu thì \Ncuối cùng cậu ấy vẫn là trai thẳng.
Dialogue: 0,0:32:09.66,0:32:11.14,VKH,Vương,0,0,0,,Đương nhiên là tôi biết rồi.
Dialogue: 0,0:32:14.62,0:32:16.46,Vi Thảo,Phương,0,0,0,,Cậu chụp cái trực thăng để làm gì?
Dialogue: 0,0:32:16.70,0:32:20.14,Vi Thảo,Phương,0,0,0,,Đây là lần thứ ba bay đến Hawaii \Ntrong tháng này rồi, có gì đẹp mà chụp?
Dialogue: 0,0:32:20.96,0:32:21.98,VKH,Vương,0,0,0,,Không có gì.
Dialogue: 0,0:32:23.44,0:32:25.58,Vi Thảo,Phương,0,0,0,,Không có gì thì đừng có trưng ra cái nụ cười đó!
Dialogue: 0,0:32:26.96,0:32:29.92,Vi Thảo,Phương,0,0,0,,...Vậy nên tôi cảm thấy cậu \Nvẫn là từ bỏ đi thì hơn.
Dialogue: 0,0:32:30.36,0:32:31.64,VKH,Vương,0,0,0,,Từ bỏ cái gì?
Dialogue: 0,0:32:33.04,0:32:34.98,Vi Thảo,Phương,0,0,0,,Tôi biết là bây giờ cậu đang rất vui,
Dialogue: 0,0:32:35.18,0:32:38.06,Vi Thảo,Phương,0,0,0,,rốt cuộc thích người ta lâu như vậy \Ncuối cùng cũng làm quen được rồi.
Dialogue: 0,0:32:38.12,0:32:40.30,Vi Thảo,Phương,0,0,0,,Hơn nữa... người ta còn đối tốt với cậu.
Dialogue: 0,0:32:40.98,0:32:42.98,Vi Thảo,Phương,0,0,0,,Nhưng bản thân cậu cũng đã từng nói,
Dialogue: 0,0:32:43.04,0:32:46.00,Vi Thảo,Phương,0,0,0,,cậu đối với cậu ấy không phải \Ntình cảm bạn bè, không thể làm bạn được.
Dialogue: 0,0:32:46.32,0:32:49.30,Vi Thảo,Phương,0,0,0,,Cậu bây giờ không cảm thấy là \Ncậu là đang tát vào mặt mình hả?
Dialogue: 0,0:32:49.96,0:32:51.20,VKH,Vương,0,0,0,,Tôi biết chứ.
Dialogue: 0,0:32:53.14,0:32:55.80,Vi Thảo,Phương,0,0,0,,Cậu muốn tiếp tục như vậy \Nthì sẽ trở thành thế nào đây?
Dialogue: 0,0:32:56.20,0:32:59.30,Vi Thảo,Phương,0,0,0,,Cậu ấy cũng nói cậu ấy mến mộ \Nphong độ khi làm phi công của cậu,
Dialogue: 0,0:32:59.30,0:33:02.34,Vi Thảo,Phương,0,0,0,,hiển nhiên sẽ không từ chối tiếp tục \Nlàm thân và trở thành bạn với cậu.
Dialogue: 0,0:33:02.88,0:33:06.80,Vi Thảo,Phương,0,0,0,,Nhưng cậu phải biết là, cậu ấy \Ncũng chỉ xem cậu là bạn thôi,
Dialogue: 0,0:33:06.80,0:33:08.32,Vi Thảo,Phương,0,0,0,,đến lúc đó cậu phải làm sao?
Dialogue: 0,0:33:08.86,0:33:12.20,Vi Thảo,Phương,0,0,0,,Đây không phải là mức độ chỉ nghe \Ngiọng nói của cậu ấy trên radio là vui vẻ,
Dialogue: 0,0:33:12.34,0:33:15.00,Vi Thảo,Phương,0,0,0,,nói không chừng cậu sẽ lún sâu \Nđến mức không thoát ra được.
Dialogue: 0,0:33:16.26,0:33:21.02,Vi Thảo,Phương,0,0,0,,Tôi không muốn đến lúc đó lại nhìn thấy bộ dạng \Nbuồn bã không vui của cậu, rất là khó coi đó.
Dialogue: 0,0:33:21.56,0:33:22.72,VKH,Vương,0,0,0,,Ừm.
Dialogue: 0,0:33:25.86,0:33:28.50,Vi Thảo,Phương,0,0,0,,Cậu nên ngừng liên lạc với cậu ấy đi.
Dialogue: 0,0:33:28.88,0:33:32.74,Vi Thảo,Phương,0,0,0,,Tôi không mong muốn cậu vì một người \Nđàn ông ăn tào phớ ngọt mà đau lòng đâu!
Dialogue: 0,0:33:33.74,0:33:35.60,VKH,Vương,0,0,0,,Được rồi, tôi biết rồi.
Dialogue: 0,0:33:36.00,0:33:36.84,Vi Thảo,Phương,0,0,0,,Cái gì?
Dialogue: 0,0:33:37.46,0:33:38.78,VKH,Vương,0,0,0,,Tôi nói là tôi biết rồi.
Dialogue: 0,0:33:38.98,0:33:40.00,Vi Thảo,Phương,0,0,0,,Biết cái gì?
Dialogue: 0,0:33:40.26,0:33:42.54,VKH,Vương,0,0,0,,Những lời mà anh nói, rất có lý.
Dialogue: 0,0:33:42.96,0:33:45.34,VKH,Vương,0,0,0,,Đã tiếp thu, đảm bảo thực tiện.
Dialogue: 0,0:33:45.58,0:33:49.04,Vi Thảo,Phương,0,0,0,,Này, thật hả? Không đấu tranh \Nchống đối chút nào sao?
Dialogue: 0,0:33:49.26,0:33:53.02,VKH,Vương,0,0,0,,Thật, không đấu tranh, không chống đối.
Dialogue: 0,0:33:53.34,0:33:55.06,Default,,0,0,0,,[Hết kỳ 2]
Dialogue: 0,0:33:55.06,0:33:56.00,Default,,0,0,0,,ED
