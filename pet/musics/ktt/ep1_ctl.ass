Dialogue: 0,0:00:04.23,0:00:15.33,Mô tả,,0,0,0,,[Trong chuyến bay]
Dialogue: 0,0:00:15.42,0:00:17.36,Vi Thảo,Hứa,0,0,0,,Hứa Bân: Cơ trưởng! Máy móc bị đơ rồi!
Dialogue: 0,0:00:17.36,0:00:19.21,Vi Thảo,Hứa,0,0,0,,Có lẽ là do khi nãy bị sét đánh gây ra.
Dialogue: 0,0:00:19.21,0:00:22.12,VKH,Vương,0,0,0,,Vương Kiệt Hi: Không sao cả, liên lạc với trạm cuối,
Dialogue: 0,0:00:22.12,0:00:23.31,VKH,Vương,0,0,0,,yêu cầu được ưu tiên hạ cánh.
Dialogue: 0,0:00:23.31,0:00:26.08,Mô tả,,0,0,0,,[Âm thanh chạy thử thiết bị truyền tin]
Dialogue: 0,0:00:26.08,0:00:28.37,Vi Thảo,Hứa,0,0,0,,Tiếp cận cảng B, GAL104.
Dialogue: 0,0:00:28.37,0:00:30.75,Vi Thảo,Hứa,0,0,0,,Máy móc gặp sự cố, đề nghị ưu tiên hạ cánh.
Dialogue: 0,0:00:30.75,0:00:32.35,DVC,Dụ,0,0,0,,Dụ Văn Châu: GAL104, tiếp cận cảng B,
Dialogue: 0,0:00:32.35,0:00:34.00,DVC,Dụ,0,0,0,,đã nhận được tin báo về sự cố.
Dialogue: 0,0:00:34.08,0:00:36.31,DVC,Dụ,0,0,0,,Sau đây sẽ ưu tiên hướng dẫn các bạn hạ cánh.
Dialogue: 0,0:00:36.31,0:00:39.26,VKH,Vương,0,0,0,,Ửm?\N...GAL104, đã rõ.
Dialogue: 0,0:00:39.26,0:00:40.84,Vi Thảo,Hứa,0,0,0,,Sao thế?
Dialogue: 0,0:00:40.84,0:00:42.02,VKH,Vương,0,0,0,,Không, không sao cả.
Dialogue: 0,0:00:42.02,0:00:43.87,VKH,Vương,0,0,0,,Thời tiết không ổn, hay là để tôi cho.
Dialogue: 0,0:00:44.76,0:00:46.37,Vi Thảo,Hứa,0,0,0,,Được thôi.
Dialogue: 0,0:00:46.37,0:00:49.32,DVC,Dụ,0,0,0,,Hiện tại phía trên sân bay đang có  \Nmây tích tụ dày dặc, có muốn bay vòng không?
Dialogue: 0,0:00:49.36,0:00:53.68,VKH,Vương,0,0,0,,Đã thấy mây tích tụ rồi, giữa đám mây \Ncó khe hở, có thể trực tiếp xuyên qua không?
Dialogue: 0,0:00:53.68,0:00:56.16,DVC,Dụ,0,0,0,,GAL104, tôi nghĩ là không có vấn đề gì cả.
Dialogue: 0,0:00:56.28,0:01:00.88,VKH,Vương,0,0,0,,Đã rõ, chúng tôi sẽ xuyên qua đám mây, đề nghị chỉ dẫn ra-đa.
Dialogue: 0,0:01:01.04,0:01:05.80,DVC,Dụ,0,0,0,,Tiến cận cảng B, bắt đầu chỉ dẫn, GAL104, sang trái hướng 300.
Dialogue: 0,0:01:05.96,0:01:09.94,VKH,Vương,0,0,0,,GAL104, sang trái hướng 300.
Dialogue: 0,0:01:09.94,0:01:12.92,DVC,Dụ,0,0,0,,GAL104, sang phải hướng 180.
Dialogue: 0,0:01:13.04,0:01:16.80,VKH,Vương,0,0,0,,GAL104, sang phải hướng 180, xác nhận.
Dialogue: 0,0:01:17.80,0:01:20.44,DVC,Dụ,0,0,0,,GAL104, sang trái hướng 220.
Dialogue: 0,0:01:20.44,0:01:23.32,DVC,Dụ,0,0,0,,Cậu đã thoát khỏi đám mây tích tụ, có thể chuẩn bị hạ cánh.
Dialogue: 0,0:01:23.48,0:01:27.40,VKH,Vương,0,0,0,,GAL104, sang trái hướng 220, đã rõ.
Dialogue: 0,0:01:27.52,0:01:31.04,Vi Thảo,Hứa,0,0,0,,Chỉ thị này thật táo bạo, nhưng cũng rất ngầu.
Dialogue: 0,0:01:31.16,0:01:34.24,DVC,Dụ,0,0,0,,GAL104, giảm xuống 4000 feet, cho phép hạ cánh.
Dialogue: 0,0:01:34.36,0:01:39.00,DVC,Dụ,0,0,0,,Tiến vào đường băng 36R, tần số tháp chỉ huy chuyển giao 212.35.
Dialogue: 0,0:01:39.12,0:01:42.88,VKH,Vương,0,0,0,,Liên lạc với tháp chỉ huy, GAL104, hạ cánh tiến vào đường băng.
Dialogue: 0,0:01:43.00,0:01:44.64,VKH,Vương,0,0,0,,Cảm ơn sự trợ giúp của cậu.
Dialogue: 0,0:01:45.00,0:01:46.28,DVC,Dụ,0,0,0,,*Cười* Good luck.
Dialogue: 0,0:01:48.74,0:02:10.78,Mô tả,,0,0,0,,[Tiếng ồn khi máy bay hạ cánh]
Dialogue: 0,0:02:10.78,0:02:13.44,Vi Thảo,Hứa,0,0,0,,Anh nói xem tình huống hạ cánh nguy hiểm vừa nãy,
Dialogue: 0,0:02:13.60,0:02:16.08,Vi Thảo,Hứa,0,0,0,,công ty của các anh có bao nhiêu phi công có đủ tư cách vượt qua?
Dialogue: 0,0:02:16.16,0:02:18.00,VKH,Vương,0,0,0,,Không phải công ty "các anh" mà là công ty "chúng ta".
Dialogue: 0,0:02:18.84,0:02:20.28,Vi Thảo,Hứa,0,0,0,,À... xin lỗi.
Dialogue: 0,0:02:18.16,0:02:19.92,Mô tả,,0,0,0,,[Âm thanh bút viết trên giấy]
Dialogue: 0,0:02:20.40,0:02:22.44,VKH,Vương,0,0,0,,Vẫn có rất nhiều người có thể vượt qua được,
Dialogue: 0,0:02:22.56,0:02:25.52,VKH,Vương,0,0,0,,nhưng có thể đoán là không có quá nhiều \Nkiểm soát viên được cho phép làm vậy.
Dialogue: 0,0:02:25.52,0:02:27.68,Vi Thảo,Hứa,0,0,0,,Ngoài ra lưu lượng của cảng B gần như bão hòa,
Dialogue: 0,0:02:27.72,0:02:30.24,Vi Thảo,Hứa,0,0,0,,các kiểm soát viên đều bị áp lực \Ncố gắng không được để sai sót nhỉ.
Dialogue: 0,0:02:30.36,0:02:32.97,VKH,Vương,0,0,0,,Đúng vậy, phần còn lại làm phiền cậu nhé.
Dialogue: 0,0:02:33.24,0:02:34.48,Vi Thảo,Hứa,0,0,0,,Vâng, cơ trưởng.
Dialogue: 0,0:02:35.36,0:02:37.64,Mô tả,,0,0,0,,[Âm thanh 2 người đi trong khoang máy bay]
Dialogue: 0,0:02:37.64,0:02:40.04,Vi Thảo,Phương,0,0,0,,Cảm ơn ngài, rất mong lần sau được phục vụ cho ngài.
Dialogue: 0,0:02:40.04,0:02:42.01,VKH,Vương,0,0,0,,Chỗ cũ, có chuyện cần nói.
Dialogue: 0,0:02:42.01,0:02:43.64,Vi Thảo,Phương,0,0,0,,Cái tên này, sao thế?
Dialogue: 0,0:02:43.64,0:02:45.17,Vi Thảo,Hứa,0,0,0,,Hứa: Anh nói cơ trưởng?
Dialogue: 0,0:02:45.17,0:02:46.11,Vi Thảo,Phương,0,0,0,,Phương: Đúng rồi.
Dialogue: 0,0:02:46.11,0:02:47.88,Vi Thảo,Hứa,0,0,0,,Hứa: Anh ấy...rất ổn mà?
Dialogue: 0,0:02:48.04,0:02:51.43,Vi Thảo,Phương,0,0,0,,Phương: Quái lạ, vừa nãy trong khoang\N điều khiển có xảy ra chuyện gì không?
Dialogue: 0,0:02:51.43,0:02:53.20,Vi Thảo,Phương,0,0,0,,Trước khi hạ cánh chấn động rất lớn.
Dialogue: 0,0:02:53.32,0:02:54.40,Vi Thảo,Phương,0,0,0,,Nghe nói là có mây.
Dialogue: 0,0:02:54.60,0:02:56.12,Vi Thảo,Hứa,0,0,0,,Hứa: Trạng thái của anh ấy rất tuyệt.
Dialogue: 0,0:02:56.28,0:02:59.20,Vi Thảo,Hứa,0,0,0,,Máy móc không hiển thị vẫn có thể \Ntrực tiếp xuyên qua đám mây tích tụ để hạ cánh.
Dialogue: 0,0:02:59.32,0:03:01.52,Vi Thảo,Hứa,0,0,0,,Khá xuất sắc đó, đáng học hỏi.
Dialogue: 0,0:03:01.64,0:03:03.80,Vi Thảo,Hứa,0,0,0,,Lại gặp được tháp chỉ huy rất tốt, cho phép anh ấy làm.
Dialogue: 0,0:03:03.92,0:03:06.52,Vi Thảo,Phương,0,0,0,,Phương: Cậu nói kiểm soát viên? Như nào cơ?
Dialogue: 0,0:03:06.76,0:03:10.08,Vi Thảo,Hứa,0,0,0,,Hứa: Ừm… Chỉ dẫn rất ngầu, vô cùng táo bạo.
Dialogue: 0,0:03:10.20,0:03:14.00,Vi Thảo,Hứa,0,0,0,,Là nam, giọng nói khá chậm rãi, \Ncó cảm giác rất ung dung.
Dialogue: 0,0:03:14.27,0:03:16.31,Vi Thảo,Hứa,0,0,0,,Nhưng thành thật mà nói, cho dù bay mấy năm,
Dialogue: 0,0:03:16.31,0:03:17.79,Vi Thảo,Hứa,0,0,0,,tôi cũng không thể phân biệt được họ…
Dialogue: 0,0:03:17.79,0:03:21.48,Vi Thảo,Phương,0,0,0,,Phương: À, tôi biết rồi, tôi biết rồi…
Dialogue: 0,0:03:22.92,0:03:25.24,Vi Thảo,Phương,0,0,0,,Cái người bất thường như này, khẳng định là…
Dialogue: 0,0:03:25.24,0:03:26.49,Vi Thảo,Hứa,0,0,0,,Hứa: Làm sao vậy?
Dialogue: 0,0:03:26.96,0:03:28.04,Vi Thảo,Phương,0,0,0,,Phương: Không có gì hết.
Dialogue: 0,0:03:28.28,0:03:31.12,Vi Thảo,Phương,0,0,0,,Cảm ơn nha anh Hứa, chào mừng đến với GAL.
Dialogue: 0,0:03:31.84,0:03:36.92,Mô tả,,0,0,0,,[Quầy bar ở ga sân bay]
Dialogue: 0,0:03:37.08,0:03:39.24,Vi Thảo,Phương,0,0,0,,Phương: 1 ly Americano, cảm ơn.
Dialogue: 0,0:03:40.20,0:03:42.92,Vi Thảo,Phương,0,0,0,,Không phải chứ? Vương Kiệt Hi.
Dialogue: 0,0:03:44.92,0:03:45.96,VKH,Vương,0,0,0,,Tôi không nghe nhầm,
Dialogue: 0,0:03:46.16,0:03:47.76,VKH,Vương,0,0,0,,là Dụ Văn Châu.
Dialogue: 0,0:03:47.88,0:03:49.20,VKH,Vương,0,0,0,,Cậu ta trờ về rồi.
Dialogue: 0,0:03:50.44,0:03:51.95,Default,,0,0,0,,Nguyên tác: Thủy Lưu Hoa Khai
Dialogue: 0,0:03:51.95,0:03:56.46,Default,,0,0,0,,Kịch truyền thanh 《Clear to land》 \Nđồng nhân Dụ Vương, Toàn Chức Cao Thủ.
Dialogue: 0,0:03:56.84,0:04:04.00,Default,,0,0,0,,Kỳ 1
Dialogue: 0,0:04:04.16,0:04:06.34,Default,,0,0,0,,---------Nhớ lại---------
Dialogue: 0,0:04:06.34,0:04:09.59,Default,,0,0,0,,Tiếp cận cảng B: GAL124, duy trì bay xung quanh
Dialogue: 0,0:04:09.59,0:04:12.36,vai phụ,Phi công phó,0,0,0,,Phi công phó: Cơ trưởng, không đủ nhiên liệu rồi.
Dialogue: 0,0:04:12.36,0:04:15.74,vai phụ,Phi công phó,0,0,0,,Thật là, từ khi trở về từ Châu Âu thì toàn bay đường vòng.
Dialogue: 0,0:04:15.74,0:04:20.05,vai phụ,Phi công phó,0,0,0,,Quanh quẩn ở đây gần cả tiếng đồng hồ vẫn chưa chịu dừng.
Dialogue: 0,0:04:20.05,0:04:22.12,Vi Thảo,Phương,0,0,0,,Phương: Cơ trưởng! Có thai phụ sinh non trong khoang khách,
Dialogue: 0,0:04:22.12,0:04:24.00,Vi Thảo,Phương,0,0,0,,cần phải đưa vào bệnh viện cấp cứu ngay!
Dialogue: 0,0:04:24.36,0:04:28.94,VKH,Vương,0,0,0,,Anh truyền tin với khoang hành khách\N rằng hãy bình tĩnh, sẽ nhanh chóng hạ cánh.
Dialogue: 0,0:04:28.94,0:04:31.40,vai phụ,Phi công phó,0,0,0,,Thưa các vị hành khách, do kiểm soát lưu lượng sân bay
Dialogue: 0,0:04:29.78,0:04:31.88,VKH,Vương,0,0,0,,Tiếp cận cảng B, GAL124.
Dialogue: 0,0:04:32.04,0:04:34.00,VKH,Vương,0,0,0,,Trên máy bay có hành khách cần cấp cứu điều trị.
Dialogue: 0,0:04:31.92,0:04:34.04,vai phụ,Phi công phó,0,0,0,,Dưới mặt đất tốc độ gió lớn,\Nmáy bay phải tiếp tục bay xung quanh.
Dialogue: 0,0:04:34.12,0:04:36.20,vai phụ,Phi công phó,0,0,0,,Chúng tôi bày tỏ sự xin lỗi chân thành đến các vị.
Dialogue: 0,0:04:34.24,0:04:36.04,VKH,Vương,0,0,0,,Vui lòng cung cấp cho mặt đất thông tin hạ cánh.
Dialogue: 0,0:04:36.04,0:04:38.04,vai phụ,Phi công phó,0,0,0,,Vừa nhận được báo cáo của tiếp viên ở khoang hành khách.
Dialogue: 0,0:04:38.16,0:04:40.24,vai phụ,Phi công phó,0,0,0,,Tình huống bất ngờ của hành khách, chúng tôi đã rõ,
Dialogue: 0,0:04:40.36,0:04:42.80,VKH,Vương,0,0,0,,GAL124 liên lạc với tháp chỉ huy cảng B.
Dialogue: 0,0:04:36.20,0:04:39.20,Default,,0,0,0,,GAL124, đã rõ, vui lòng liên hệ với tháp chỉ huy cảng B.
Dialogue: 0,0:04:40.28,0:04:42.88,vai phụ,Phi công phó,0,0,0,,sẽ nhanh chóng liên lạc với sân bay để hạ cánh.
Dialogue: 0,0:04:44.16,0:04:46.64,VKH,Vương,0,0,0,,GAL124, đã thông qua tiếp cận quỹ đạo.
Dialogue: 0,0:04:43.00,0:04:44.12,vai phụ,Phi công phó,0,0,0,,Cảm ơn các vị đã hỗ trợ.
Dialogue: 0,0:04:46.88,0:04:48.80,VKH,Vương,0,0,0,,Trên máy bay có hành khách cần cấp cứu điều trị,
Dialogue: 0,0:04:48.80,0:04:51.00,VKH,Vương,0,0,0,,vui lòng cung cấp cho mặt đất thông tin hạ cánh.
Dialogue: 0,0:04:51.18,0:04:53.76,DVC,Dụ,0,0,0,,Tháp chỉ huy cảng B, GAL124, đã nhìn thấy ra-đa.
Dialogue: 0,0:04:53.84,0:04:56.04,DVC,Dụ,0,0,0,,Hiện tại ở mặt đất tốc độ gió lớn, vui lòng chờ chỉ thị.
Dialogue: 0,0:04:56.16,0:04:57.84,DVC,Dụ,0,0,0,,Hành khách đó còn bao nhiêu thời gian nữa?
Dialogue: 0,0:04:57.96,0:05:01.94,VKH,Vương,0,0,0,,GAL124, 30 phút, nhiên liệu cũng vậy.
Dialogue: 0,0:05:02.12,0:05:04.84,DVC,Dụ,0,0,0,,Tháp chỉ huy cảng B, cho tôi 20 phút, chuẩn bị hạ cánh.
Dialogue: 0,0:05:05.00,0:05:08.63,vai phụ,Phi công phó,0,0,0,,Còn có mây mưa nữa, gió thì vẫn rất lớn.
Dialogue: 0,0:05:08.80,0:05:12.80,vai phụ,Phi công phó,0,0,0,,Kiểm soát viên này gan cũng thật lớn, chắc là tên gà mờ thôi.
Dialogue: 0,0:05:12.96,0:05:16.20,vai phụ,Phi công phó,0,0,0,,Còn không thể hiểu rõ tình hình, đổi họ đến lãnh đạo được không đây?
Dialogue: 0,0:05:16.88,0:05:19.20,DVC,Dụ,0,0,0,,Mây mưa mùa này thường sẽ không ở lại quá lâu.
Dialogue: 0,0:05:19.32,0:05:23.25,DVC,Dụ,0,0,0,,Ước tính khoảng 10 phút nữa sẽ tản ra, \Nchờ sau khi vận tốc yếu đi chút nữa thì cho phép hạ cánh.
Dialogue: 0,0:05:23.80,0:05:26.28,DVC,Dụ,0,0,0,,Ngoài ra, nếu muốn khiếu nại mời \Ntrực tiếp phản ánh với kênh công ty.
Dialogue: 0,0:05:26.44,0:05:28.60,DVC,Dụ,0,0,0,,Đừng chiếm dụng kênh này, cảm ơn.
Dialogue: 0,0:05:28.93,0:05:34.72,VKH,Vương,0,0,0,,Vừa rồi thật xin lỗi, ở bên này PF* chuẩn bị\N hạ cánh, đề nghị cung cấp vận tóc gió ở mặt đất.
Dialogue: 0,0:05:28.93,0:05:34.72,Chú thích,,0,0,0,,*Pilot Flying: Phi công chính
Dialogue: 0,0:05:34.72,0:05:39.27,DVC,Dụ,0,0,0,,GAL124, đường bay 36L, hướng gió 330, vận tốc gió 16 knot.
Dialogue: 0,0:05:39.27,0:05:40.92,DVC,Dụ,0,0,0,,Clear to land──
Dialogue: 0,0:05:40.92,0:05:44.49,VKH,Vương,0,0,0,,GAL124, hướng gió 330, vận tốc gió 16 knot.
Dialogue: 0,0:05:44.96,0:05:47.36,VKH,Vương,0,0,0,,Clear to land──
Dialogue: 0,0:05:49.33,0:05:55.32,DVC,Dụ,0,0,0,,GAL124, hướng gió 300, vận tốc gió 15 knot.
Dialogue: 0,0:05:55.32,0:05:57.20,DVC,Dụ,0,0,0,,GAL124, ghi nhận 1000 feet...
Dialogue: 0,0:05:57.36,0:06:01.57,DVC,Dụ,0,0,0,,500 feet, ghi nhận, bắt đầu hạ cánh theo quán tính.
Dialogue: 0,0:06:01.57,0:06:06.96,DVC,Dụ,0,0,0,,GAL124, tiến vào A7, tần số liên hệ với mặt đất 119.35.
Dialogue: 0,0:06:07.12,0:06:12.64,VKH,Vương,0,0,0,,GAL124, tần số liên hệ với mặt đất 119.35, đã rõ.
Dialogue: 0,0:06:16.42,0:06:28.56,Mô tả,,0,0,0,,[Máy bay hạ cánh]
Dialogue: 0,0:06:28.68,0:06:29.95,DVC,Dụ,0,0,0,,Vất vả rồi, GAL124.
Dialogue: 0,0:06:29.95,0:06:31.03,DVC,Dụ,0,0,0,,Perfect landing.
Dialogue: 0,0:06:32.28,0:06:34.04,VKH,Vương,0,0,0,,... Cảm ơn đã hỗ trợ.
Dialogue: 0,0:06:42.68,0:06:47.36,Vi Thảo,Phương,0,0,0,,Phương: Thanh niên trẻ chưa vợ là tôi cùng \Nvới thai phụ sắp sinh hoảng loạn muốn chết.
Dialogue: 0,0:06:47.44,0:06:53.42,Vi Thảo,Phương,0,0,0,,Tôi còn phải thể hiện sự chuyên nghiệp mà an ủi rằng đừng lo lắng, nhất định cơ trưởng sẽ nhanh chóng hạ cánh.
Dialogue: 0,0:06:53.42,0:06:58.56,Vi Thảo,Phương,0,0,0,,Đến cuối cùng tay tôi toàn là máu,\Nám ảnh tâm lí rất rất lớn đấy.
Dialogue: 0,0:06:58.56,0:07:00.44,VKH,Vương,0,0,0,,Ờ, vất vả rồi.
Dialogue: 0,0:07:00.52,0:07:05.67,Vi Thảo,Phương,0,0,0,,Còn cái người phi công phó đó, tình huống gấp rút như vậy còn có thể ăn nói xằng bậy với kiểm soát viên,
Dialogue: 0,0:07:05.67,0:07:08.52,Vi Thảo,Phương,0,0,0,,đúng là không phù hợp với chuyến bay này.
Dialogue: 0,0:07:08.64,0:07:12.76,Vi Thảo,Phương,0,0,0,,May là hôm nay gặp được kiểm soát viên \Ntính tình tốt không có cãi nhau trên kênh đấy.
Dialogue: 0,0:07:13.40,0:07:16.00,Vi Thảo,Phương,0,0,0,,Tính tình như này chắc cậu ấy phải tiết chế lắm.
Dialogue: 0,0:07:16.06,0:07:16.96,VKH,Vương,0,0,0,,Ờ.
Dialogue: 0,0:07:17.08,0:07:20.56,Vi Thảo,Phương,0,0,0,,Vương Kiệt Hi, hôm nay cậu có bị dọa sợ không?
Dialogue: 0,0:07:20.56,0:07:22.78,Vi Thảo,Phương,0,0,0,,Sao nói gì cũng không có phản ứng vậy?
Dialogue: 0,0:07:22.78,0:07:25.64,VKH,Vương,0,0,0,,...Tôi cảm thấy giọng của cậu ấy rất hay.
Dialogue: 0,0:07:25.76,0:07:28.84,Vi Thảo,Phương,0,0,0,,Cậu ấy? Ai? Phi công phó?
Dialogue: 0,0:07:29.00,0:07:30.76,VKH,Vương,0,0,0,,Kiểm soát viên hôm nay ấy.
Dialogue: 0,0:07:31.56,0:07:34.32,Vi Thảo,Phương,0,0,0,,Chậc, cuộc gọi vô tuyến đó hả?
Dialogue: 0,0:07:34.48,0:07:37.76,Vi Thảo,Phương,0,0,0,,Giọng nói bị sai lệch thành như vậy, \Nsao cậu cảm thấy hay được vậy?
Dialogue: 0,0:07:44.04,0:07:48.16,Vi Thảo,Phương,0,0,0,,Tôi chính là nói cuộc họp trao đổi hôm\N nay vừa nhiều người vừa phiền nữa,
Dialogue: 0,0:07:48.36,0:07:50.40,Vi Thảo,Phương,0,0,0,,không hiểu tại sao cậu lại muốn đến.
Dialogue: 0,0:07:51.22,0:07:55.28,VKH,Vương,0,0,0,,Tôi cũng không muốn, bị cấp trên \Nchỉ định mà, cũng đâu còn cách nào khác.
Dialogue: 0,0:07:55.88,0:07:59.28,Vi Thảo,Phương,0,0,0,,Haizz, bị ép đi lính thật thê thảm...
Dialogue: 0,0:08:00.35,0:08:05.30,Vi Thảo,Phương,0,0,0,,Hahaha, cậu nhìn kìa bên kia còn thê thảm hơn chúng ta.
Dialogue: 0,0:08:05.30,0:08:09.28,Lam Vũ,Hoàng,0,0,0,,Hoàng Thiếu Thiên: ...Nếu như không mở cuộc họp này thì anh có thể có cơ hội đi xuống tháp chỉ huy trong lúc trực ban sao.
Dialogue: 0,0:08:09.28,0:08:11.52,Lam Vũ,Hoàng,0,0,0,,Có thể gặp anh ở đây xem \Nnhư là may mắn trong bất hạnh.
Dialogue: 0,0:08:11.72,0:08:13.80,Lam Vũ,Hoàng,0,0,0,,Cái cuộc họp trao đổi nhàm chán\N này có gì tốt mà phải mở chứ?
Dialogue: 0,0:08:13.92,0:08:16.56,Lam Vũ,Hoàng,0,0,0,,Nếu không phải bị cấp trên bắt đi\N thì vốn dĩ tôi chẳng muốn tới đây đâu.
Dialogue: 0,0:08:16.64,0:08:19.86,DVC,Dụ,0,0,0,,Vất vả rồi, nhưng hôm nay tôi \Ncũng cần phải quay về ngủ bù.
Dialogue: 0,0:08:19.86,0:08:21.92,Lam Vũ,Hoàng,0,0,0,,Hả? Tối qua trực ban à?
Dialogue: 0,0:08:22.04,0:08:24.80,Lam Vũ,Hoàng,0,0,0,,Trực ban xong rồi còn không cho anh về ngủ, \Nsếp đúng thật là ngày càng không có tình người.
Dialogue: 0,0:08:24.92,0:08:26.00,Lam Vũ,Hoàng,0,0,0,,Để tôi gọi điện thoại cho sếp.
Dialogue: 0,0:08:26.12,0:08:27.96,DVC,Dụ,0,0,0,,Được rồi, được rồi, không cần đâu.
Dialogue: 0,0:08:28.56,0:08:29.60,VKH,Vương,0,0,0,,...Là cậu ấy.
Dialogue: 0,0:08:29.76,0:08:33.12,Vi Thảo,Phương,0,0,0,,Vẻ mặt này của cậu là sao đây? Cười gì vậy?
Dialogue: 0,0:08:34.54,0:08:38.71,VKH,Vương,0,0,0,,Tôi nhìn thấy Dụ Văn Châu rồi, chính là \Nngười nói chuyện với Hoàng Thiếu Thiên đó.
Dialogue: 0,0:08:38.71,0:08:41.80,Vi Thảo,Phương,0,0,0,,Đó rõ ràng là bị Hoàng Thiếu Thiên ép nói chuyện mà?
Dialogue: 0,0:08:42.48,0:08:44.36,Vi Thảo,Phương,0,0,0,,Sao cậu không lại bắt chuyện đi?
Dialogue: 0,0:08:44.71,0:08:46.48,VKH,Vương,0,0,0,,Thôi khỏi đi.
Dialogue: 0,0:08:46.48,0:08:49.92,VKH,Vương,0,0,0,,Chỉ là đơn phương nghe ra giọng \Ncậu ấy thôi, cậu ấy còn không quen tôi.
Dialogue: 0,0:08:49.92,0:08:51.33,VKH,Vương,0,0,0,,Không cần thiết đâu.
Dialogue: 0,0:08:51.33,0:08:56.60,Vi Thảo,Phương,0,0,0,,Cậu nhát thì có! Có Hoàng Thiếu Thiên\N ở đó không thể nào nhạt nhẽo được, sợ cái gì?
Dialogue: 0,0:08:56.79,0:09:01.43,VKH,Vương,0,0,0,,Tỉnh đi, tôi đây không phải là nhát \Nmà là giữ khoảng cách an toàn.
Dialogue: 0,0:09:02.52,0:09:04.68,Vi Thảo,Phương,0,0,0,,Chậc, cậu đợi đó.
Dialogue: 0,0:09:16.08,0:09:20.56,Vi Thảo,Phương,0,0,0,,Vậy cái người gọi là kiểm soát viên \NDụ Văn Châu này, rốt cuộc là có ma lực gì?
Dialogue: 0,0:09:21.80,0:09:26.94,Vi Thảo,Phương,0,0,0,,Nghe nói là nhỏ hơn cậu 2 tuổi, \Nnăm ngoái mới được tháp chỉ huy nhận vào.
Dialogue: 0,0:09:26.94,0:09:32.96,Vi Thảo,Phương,0,0,0,,Tôi vừa nhìn lướt qua, trông cũng khá \Nlà nghiêm chỉnh, chỉ có nhiêu đó thôi.
Dialogue: 0,0:09:33.20,0:09:34.68,VKH,Vương,0,0,0,,Tôi không có nói kiểu thích đó.
Dialogue: 0,0:09:34.72,0:09:39.53,Vi Thảo,Phương,0,0,0,,Cậu còn nghe ra giọng lúc truyền tin của người ta, \Nđiều này rất kinh hoàng được chưa?
Dialogue: 0,0:09:39.53,0:09:41.00,VKH,Vương,0,0,0,,Khả năng nghe của tôi tốt thôi.
Dialogue: 0,0:09:41.16,0:09:47.36,Vi Thảo,Phương,0,0,0,,Nhưng kể từ hôm đó, hễ cất canh hay hạ cánh mà gặp cậu ấy, ngày hôm đó tâm trạng của cậu liền rất tốt.
Dialogue: 0,0:09:47.46,0:09:50.08,VKH,Vương,0,0,0,,Đúng vậy, tôi rất thích giọng nói của cậu ấy.
Dialogue: 0,0:09:50.18,0:09:52.40,Vi Thảo,Phương,0,0,0,,...Tôi thật sự không hiểu được cậu.
Dialogue: 0,0:09:54.04,0:09:59.42,VKH,Vương,0,0,0,,Dụ Văn Châu rất tốt, giọng nói hay, kiểm soát xuất sắc.
Dialogue: 0,0:09:59.80,0:10:03.40,VKH,Vương,0,0,0,,Cho dù có thế nào cậu ấy cũng có thể \Nduy trì tốc độ nói thoải mái một cách bình tĩnh.
Dialogue: 0,0:10:04.44,0:10:07.44,VKH,Vương,0,0,0,,Là một người khiến cho tháp chỉ huy yên tâm tín nhiệm.
Dialogue: 0,0:10:07.88,0:10:13.25,VKH,Vương,0,0,0,,Trong tình huống cho phép, cậu ấy đều sẽ thêm \Nmột câu "Good luck" rồi mới cúp điện thoại.
Dialogue: 0,0:10:13.25,0:10:16.72,VKH,Vương,0,0,0,,Đồng thời, chuyến bay đáng ghét \Ntrở về vào đêm khuya cũng vậy,
Dialogue: 0,0:10:16.72,0:10:19.51,VKH,Vương,0,0,0,,sau cùng cậu ấy sẽ nói câu "Nice landing" để chào đón.
Dialogue: 0,0:10:19.51,0:10:22.14,VKH,Vương,0,0,0,,Chỉ cần nghe được giọng của cậu ấy là được rồi.
Dialogue: 0,0:10:22.14,0:10:23.84,VKH,Vương,0,0,0,,Chỉ có điều...
Dialogue: 0,0:10:29.08,0:10:34.32,Default,Phát thanh,0,0,0,,Phát thanh: Hành khách chuyến bay 835 Hàng không Vinh Quang bay đến London, Dụ Văn Châu, Thượng Quan Cầm, xin lưu ý.
Dialogue: 0,0:10:34.40,0:10:35.76,VKH,Vương,0,0,0,,... Dụ Văn Châu?
Dialogue: 0,0:10:35.76,0:10:37.32,VKH,Vương,0,0,0,,Sao cậu ấy lại ở đây?
Dialogue: 0,0:10:38.24,0:10:44.76,Default,Phát thanh,0,0,0,,Vui lòng nhanh chóng đến cửa số 22 để lên máy bay,
Dialogue: 0,0:10:44.96,0:10:51.68,Default,Phát thanh,0,0,0,,chuyến bay của quý khách sắp khởi hành rồi.
Dialogue: 0,0:10:38.04,0:10:40.92,VKH,Vương,0,0,0,,Đây là... đang khóc à?
Dialogue: 0,0:10:44.16,0:10:48.08,VKH,Vương,0,0,0,,Cậu ấy... làm sao vậy?
Dialogue: 0,0:10:48.72,0:10:53.76,VKH,Vương,0,0,0,,Mình có nên qua đó không... nhưng mà...
Dialogue: 0,0:10:59.72,0:11:02.64,DVC,Dụ,0,0,0,,Mày có thể mà... đừng bỏ cuộc...
Dialogue: 0,0:11:05.73,0:11:11.40,VKH,Vương,0,0,0,,*thở dài* Vương Kiệt Hi, mày vậy \Nlà thừa nước đục thả câu đấy.
Dialogue: 0,0:11:13.84,0:11:16.08,VKH,Vương,0,0,0,,Sao lại ngủ rồi?
Dialogue: 0,0:11:20.00,0:11:23.60,VKH,Vương,0,0,0,,Lát nữa tỉnh lại, nên nói gì với cậu ấy đây.
Dialogue: 0,0:11:24.36,0:11:27.00,Mô tả,,0,0,0,,[Chuông điện thoại reo lên]
Dialogue: 0,0:11:27.40,0:11:30.60,VKH,Vương,0,0,0,,Alo, chào ngài, đợi tôi một lát.
Dialogue: 0,0:11:33.52,0:11:39.92,VKH,Vương,0,0,0,,Ừm... là tôi... lịch trình?
Dialogue: 0,0:11:43.04,0:11:45.24,DVC,Dụ,0,0,0,,Sao em lại ở đây?
Dialogue: 0,0:11:45.40,0:11:47.52,DVC,Dụ,0,0,0,,Không phải máy bay đã cất cánh rồi sao?
Dialogue: 0,0:11:47.52,0:11:50.84,Nữ,,0,0,0,,Thượng Quan Cầm: Em lo lắng cho anh, muốn ở đây với anh.
Dialogue: 0,0:11:50.92,0:11:52.60,VKH,Vương,0,0,0,,Tháng này vẫn ổn.
Dialogue: 0,0:11:53.27,0:11:54.91,DVC,Dụ,0,0,0,,Cha của em...
Dialogue: 0,0:11:54.91,0:12:00.04,Nữ,,0,0,0,,Không sao, em nói em muốn dành thời gian\Ncho bạn trai nhiều hơn, chẳng lẽ sai sao?
Dialogue: 0,0:11:55.68,0:11:56.80,VKH,Vương,0,0,0,,Sao thế?
Dialogue: 0,0:12:00.32,0:12:04.00,Nữ,,0,0,0,,Anh vẫn ổn chứ Văn Châu? Sắc mặt anh kém quá...
Dialogue: 0,0:12:04.16,0:12:08.92,DVC,Dụ,0,0,0,,Anh không sao hết, thật đó. \NÀ cái áo khoác này là của ai vậy?
Dialogue: 0,0:12:09.16,0:12:14.00,Nữ,,0,0,0,,Em tưởng là của anh chứ, khi em\N vừa đến là nó đã ở trên người anh rồi.
Dialogue: 0,0:12:09.52,0:12:10.92,VKH,Vương,0,0,0,,...bay giúp?
Dialogue: 0,0:12:14.08,0:12:21.40,DVC,Dụ,0,0,0,,Đây là... áo vest bốn gạch, \Ncủa Hàng không Vinh Quang, kì lạ...
Dialogue: 0,0:12:22.12,0:12:23.92,Nữ,,0,0,0,,Anh thật sự không sao chứ?
Dialogue: 0,0:12:22.48,0:12:25.52,VKH,Vương,0,0,0,,Được rồi... nhớ là sau đó phải bù đắp lại đấy.
Dialogue: 0,0:12:25.96,0:12:27.36,Nữ,,0,0,0,,Cười một cái cho em xem thử nào?
Dialogue: 0,0:12:27.36,0:12:28.20,DVC,Dụ,0,0,0,,Ừm...
Dialogue: 0,0:12:28.27,0:12:30.00,DVC,Dụ,0,0,0,,Haha... tuân lệnh.
Dialogue: 0,0:12:32.36,0:12:36.68,DVC,Dụ,0,0,0,,Không biết là áo vest của vị cơ trưởng nào \Nở Hàng không Vinh Quang, phải trả lại thế nào đây...
Dialogue: 0,0:12:36.76,0:12:38.60,VKH,Vương,0,0,0,,Ừm... như vậy đi, tạm biệt.
Dialogue: 0,0:12:41.56,0:12:43.48,VKH,Vương,0,0,0,,Haizzz
Dialogue: 0,0:13:01.00,0:13:03.32,VKH,Vương,0,0,0,,Hôm nay nhìn thấy Dụ Văn Châu ở sân bay.
Dialogue: 0,0:13:04.12,0:13:06.96,VKH,Vương,0,0,0,,Cậu ấy hẹn hò với thiên kim tiểu thư cấp cao,
Dialogue: 0,0:13:07.04,0:13:09.68,VKH,Vương,0,0,0,,chính là khách VIP trong chuyến bay lần trước...
Dialogue: 0,0:13:13.04,0:13:15.98,VKH,Vương,0,0,0,,Tôi cảm thấy, tôi thất tình rồi.
Dialogue: 0,0:13:15.98,0:13:19.84,Vi Thảo,Phương,0,0,0,,Khoan, đợi đã. Cậu thích cậu ấy lúc nào vậy?
Dialogue: 0,0:13:20.04,0:13:25.20,Vi Thảo,Phương,0,0,0,,Thiên kim tiểu thư tập đoàn BTO vừa ý \Ncậu ấy điểm nào? Thật không công bằng!
Dialogue: 0,0:13:25.60,0:13:27.72,VKH,Vương,0,0,0,,Thật ra rất môn đăng hộ đối.
Dialogue: 0,0:13:27.84,0:13:31.16,Vi Thảo,Phương,0,0,0,,Kết quả trước đây cậu chỉ mạnh mồm \Nnói bản thân chỉ đơn giản là thưởng thức thôi.
Dialogue: 0,0:13:31.32,0:13:34.92,Vi Thảo,Phương,0,0,0,,Tôi nói cậu thích người ta cậu còn \Nkhông chịu tin, giờ thì rõ chưa.
Dialogue: 0,0:13:35.96,0:13:37.07,VKH,Vương,0,0,0,,Anh nói đúng rồi.
Dialogue: 0,0:13:37.07,0:13:39.92,Vi Thảo,Phương,0,0,0,,Vậy bây giờ cậu tính làm cách nào?
Dialogue: 0,0:13:41.02,0:13:44.12,VKH,Vương,0,0,0,,Vốn dĩ tôi nghĩ thử làm bạn cũng được,
Dialogue: 0,0:13:44.28,0:13:47.36,VKH,Vương,0,0,0,,nhưng nếu đã như vậy rồi, \Ncũng không cần thiết phải thế nữa.
Dialogue: 0,0:13:47.52,0:13:51.24,Vi Thảo,Phương,0,0,0,,Tiếp tục trải qua ngày tháng xem việc nhìn nam\N thần từ xa là niềm vui bé nhỏ của cậu?
Dialogue: 0,0:13:52.40,0:13:54.44,VKH,Vương,0,0,0,,Có lẽ là vậy.
Dialogue: 0,0:13:55.60,0:13:59.52,VKH,Vương,0,0,0,,Không biết hôm nay sao cậu ấy\N lại khóc, bây giờ đã ổn hơn chưa.
Dialogue: 0,0:13:59.72,0:14:04.48,Vi Thảo,Phương,0,0,0,,Ha, đây là chuyện của vợ cậu ấy, \Ncậu đừng có lo lắng vớ vẩn.
Dialogue: 0,0:14:05.13,0:14:06.88,Vi Thảo,Phương,0,0,0,,Nếu như nam thần đã thoát ế rồi,
Dialogue: 0,0:14:06.94,0:14:08.96,Vi Thảo,Phương,0,0,0,,vậy thì không thể gọi là nam thần được nữa.
Dialogue: 0,0:14:09.08,0:14:10.96,Vi Thảo,Phương,0,0,0,,Nên đổi thành bạch nguyệt quang đi.
Dialogue: 0,0:14:11.68,0:14:13.44,VKH,Vương,0,0,0,,Ờ, là bạch nguyệt quang đó.
Dialogue: 0,0:14:13.88,0:14:17.00,Vi Thảo,Phương,0,0,0,,... Người như cậu thật nhàm chán.
Dialogue: 0,0:14:17.20,0:14:19.04,Default,,0,0,0,,------Dòng thời gian bình thường-----
Dialogue: 0,0:14:19.20,0:14:21.24,Mô tả,,0,0,0,,[Âm thanh nền ở quán bar]
Dialogue: 0,0:14:22.48,0:14:26.96,VKH,Vương,0,0,0,,Anh xem, bạch nguyệt quang đúng là bạch \Nnguyệt quang, ba năm rồi cũng không quên được.
Dialogue: 0,0:14:27.40,0:14:29.96,Vi Thảo,Phương,0,0,0,,Cậu cũng biết ba năm rồi à?
Dialogue: 0,0:14:30.32,0:14:36.04,Vi Thảo,Phương,0,0,0,,Sau cái lần cậu đưa cho cậu ấy cái áo vest ở sân bay, ba tháng sau cậu ấy liền được điều đến sân bay phía Nam.
Dialogue: 0,0:14:36.16,0:14:38.87,Vi Thảo,Phương,0,0,0,,Sau lần đó cậu không còn nghe thấy \Ngiọng của cậu ấy nữa phải không?
Dialogue: 0,0:14:38.87,0:14:41.03,VKH,Vương,0,0,0,,Đúng vậy, cho nên rất tự hào?
Dialogue: 0,0:14:41.20,0:14:43.24,Vi Thảo,Phương,0,0,0,,Cậu đừng có mà tự hào.
Dialogue: 0,0:14:43.40,0:14:45.36,Vi Thảo,Phương,0,0,0,,Đây cũng không phải là chuyện gì tốt!
Dialogue: 0,0:14:45.44,0:14:46.76,VKH,Vương,0,0,0,,Tại sao?
Dialogue: 0,0:14:46.84,0:14:49.48,Vi Thảo,Phương,0,0,0,,Thứ nhất, người ta vẫn là thẳng nam đó.
Dialogue: 0,0:14:49.48,0:14:52.24,Vi Thảo,Phương,0,0,0,,Thứ hai, nói không chừng là đã kết hôn rồi.
Dialogue: 0,0:14:52.40,0:14:54.72,Vi Thảo,Phương,0,0,0,,Lúc đó tôi đã nói với cậu rồi phải không?
Dialogue: 0,0:14:54.88,0:14:58.00,Vi Thảo,Phương,0,0,0,,Trước khi làm việc, vị thiên kim tiểu thư\Nvà cậu ấy đã quen nhau rồi.
Dialogue: 0,0:14:58.28,0:15:02.56,Vi Thảo,Phương,0,0,0,,Hẹn hò hơn 3 năm, cũng đã gặp mặt\N bố của ông chủ nhiều lần rồi.
Dialogue: 0,0:15:03.08,0:15:05.85,Vi Thảo,Phương,0,0,0,,Tuy không biết có hài lòng hay không,
Dialogue: 0,0:15:05.85,0:15:09.99,Vi Thảo,Phương,0,0,0,,nhưng khi đại tiểu thư ở trong nước\N thì luôn đến sân bay chờ Dụ Văn Châu tan làm,
Dialogue: 0,0:15:09.99,0:15:13.24,Vi Thảo,Phương,0,0,0,,hoặc là buổi trưa đến cùng ăn cơm,
Dialogue: 0,0:15:13.24,0:15:16.64,Vi Thảo,Phương,0,0,0,,hai người vô cùng ngọt ngào,\N thường xuyên thể hiện tình cảm.
Dialogue: 0,0:15:16.80,0:15:21.20,Vi Thảo,Phương,0,0,0,,Trai xinh gái đẹp, cảnh tượng vô cùng lãng mạn.
Dialogue: 0,0:15:22.02,0:15:26.82,Vi Thảo,Phương,0,0,0,,Lại trôi qua thêm 3 năm nữa, nói \Nkhông chừng là đã kết hôn xong hết rồi.
Dialogue: 0,0:15:26.82,0:15:27.80,VKH,Vương,0,0,0,,Ừm.
Dialogue: 0,0:15:27.96,0:15:30.68,Vi Thảo,Phương,0,0,0,,Còn có, quan trọng nhất là,
Dialogue: 0,0:15:30.84,0:15:35.57,Vi Thảo,Phương,0,0,0,,trước đây cậu không dám lại bắt chuyện \Nvới người ta, lần này cũng sẽ không có gì thay đổi.
Dialogue: 0,0:15:35.57,0:15:38.80,Vi Thảo,Phương,0,0,0,,Cậu vẫn nên tiếp tục bí mật quan sát là được rồi.
Dialogue: 0,0:15:39.73,0:15:44.29,Vi Thảo,Phương,0,0,0,,Mà này, sao tên Dụ Văn Châu này\N lại như âm hồn bất tán như vậy chứ.
Dialogue: 0,0:15:44.29,0:15:46.96,VKH,Vương,0,0,0,,À, anh nói cái này thì
Dialogue: 0,0:15:47.52,0:15:51.61,VKH,Vương,0,0,0,,chẳng qua là tôi cảm thấy mình tình cảm\Nsâu nặng, là phẩm chất tốt của con người mà.
Dialogue: 0,0:15:51.61,0:15:53.08,Vi Thảo,Phương,0,0,0,,...Được thôi.
Dialogue: 0,0:15:55.08,0:15:58.68,Vi Thảo,Phương,0,0,0,,Nhưng mà, cậu nói áo vest \Ncủa cậu vẫn ở chỗ của cậu ấy sao?
Dialogue: 0,0:15:59.59,0:16:00.84,VKH,Vương,0,0,0,,Ai mà biết được?
Dialogue: 0,0:16:01.00,0:16:03.68,VKH,Vương,0,0,0,,Dù sao thì từ lúc đó vẫn không\Nđược trả lại thì chính là như vậy.
Dialogue: 0,0:16:04.64,0:16:09.28,Default,,0,0,0,,[Hết kỳ 1]
Dialogue: 0,0:16:10.69,0:16:19.16,Default,,0,0,0,,ED
Comment: 0,0:16:34.32,0:16:39.74,Vietsub,,0,0,0,karaoke,Lại là một ngày sớm chiều trên đường chân trời.
Comment: 0,0:16:39.84,0:16:46.88,Vietsub,,0,0,0,karaoke,Đốm lửa nhỏ thắp sáng vạn nhà, ai sẽ giữ lại ánh đèn cho tôi.
Comment: 0,0:16:47.12,0:16:52.33,Vietsub,,0,0,0,karaoke,Phía cuối hàng tuyến là tòa thành nào
Comment: 0,0:16:53.00,0:16:59.36,Vietsub,,0,0,0,karaoke,Nút thắt trong lòng khó chữa lành, làm thế nào để bắt đầu lại lần nữa.
Comment: 0,0:16:59.56,0:17:06.32,Vietsub,,0,0,0,karaoke,Mọi người đều nghĩ tôi thận trọng quá mức, bỏ lại tôi cô độc.
Comment: 0,0:17:06.52,0:17:11.96,Vietsub,,0,0,0,karaoke,Quá để tâm đến những "khả năng" đó trong tương lai.
Comment: 0,0:17:15.56,0:17:20.63,Vietsub,,0,0,0,karaoke,Nếu như cùng nhau ngắm pháo hoa trên bầu trời
Comment: 0,0:17:21.44,0:17:24.92,Vietsub,,0,0,0,karaoke,và bóng người mờ ảo bên ngoài cửa kính xe
Comment: 0,0:17:25.08,0:17:27.80,Vietsub,,0,0,0,karaoke,có làm đáy lòng cậu rối loạn nhiều chứ.
Comment: 0,0:17:28.40,0:17:33.74,Vietsub,,0,0,0,karaoke,Nếu như tình yêu chỉ là một cơn giông tố
Comment: 0,0:17:34.24,0:17:37.88,Vietsub,,0,0,0,karaoke,xin đừng tự xem nhẹ bản thân
Comment: 0,0:17:37.96,0:17:40.76,Vietsub,,0,0,0,karaoke,Nếu như vì tôi không xứng đáng,
Comment: 0,0:17:41.28,0:17:45.92,Vietsub,,0,0,0,karaoke,chi bằng xem tôi như người qua đường
Comment: 0,0:17:46.20,0:17:49.28,Vietsub,,0,0,0,karaoke,tình cờ xen vào vô số đốm lửa nhỏ
Comment: 0,0:17:49.36,0:17:52.35,Vietsub,,0,0,0,karaoke,Cảm ơn vì cậu đã quý trọng tôi
Comment: 0,0:17:52.35,0:17:56.32,Vietsub,,0,0,0,karaoke,sẵn lòng vì tôi mà hạ cánh
Comment: 0,0:17:59.36,0:18:03.92,Vietsub,,0,0,0,karaoke,như vậy đã quá đủ rồi.
Comment: 0,0:18:07.08,0:18:12.04,Vietsub,,0,0,0,karaoke,Sự quan tâm và lời hỏi thăm sớm đã thay đổi giọng điệu
Comment: 0,0:18:12.76,0:18:19.18,Vietsub,,0,0,0,karaoke,Thói quen như thế có được xem là rước họa vào thân
Comment: 0,0:18:19.18,0:18:22.68,Vietsub,,0,0,0,karaoke,Nhưng cũng chỉ là một người bình thường mà thôi
Comment: 0,0:18:22.84,0:18:25.82,Vietsub,,0,0,0,karaoke,Khó tránh khỏi sa vào cảnh tự trầm mình
Comment: 0,0:18:26.32,0:18:31.88,Vietsub,,0,0,0,karaoke,Làm sao để buông bỏ "chúng ta" mà cậu đã nói ấy
Comment: 0,0:18:32.36,0:18:37.78,Vietsub,,0,0,0,karaoke,Nếu như cậu đã sớm tóm được tôi
Comment: 0,0:18:38.32,0:18:41.48,Vietsub,,0,0,0,karaoke,suýt chút nữa tôi đã tự mình giải thoát
Comment: 0,0:18:41.60,0:18:44.80,Vietsub,,0,0,0,karaoke,thì hãy xem như đã lỡ sai thì cứ tiếp tục sai
Comment: 0,0:18:44.92,0:18:50.59,Vietsub,,0,0,0,karaoke,Lần này vượt qua sự yếu đuối cuối cùng
Comment: 0,0:18:51.20,0:18:54.34,Vietsub,,0,0,0,karaoke,Hãy đổi thành tôi đến xông pha khói lửa
Comment: 0,0:18:54.76,0:18:57.46,Vietsub,,0,0,0,karaoke,Bằng lòng hẹn ước cả một đời
Comment: 0,0:18:57.46,0:19:02.89,Vietsub,,0,0,0,karaoke,Cậu nói những việc tốt thường có nhiều trắc trở
Comment: 0,0:19:02.89,0:19:05.72,Vietsub,,0,0,0,karaoke,Bầu trời to lớn biết bao
Comment: 0,0:19:05.84,0:19:09.60,Vietsub,,0,0,0,karaoke,nhưng chỉ chờ đợi thời khắc này thôi
Comment: 0,0:19:09.72,0:19:14.44,Vietsub,,0,0,0,karaoke,Có thể cùng tôi hạ cánh không?
Comment: 0,0:19:17.64,0:19:20.40,Vietsub,,0,0,0,karaoke,Ngọn lửa được thắp sáng từ sóng điện
Comment: 0,0:19:20.48,0:19:23.84,Vietsub,,0,0,0,karaoke,bùng cháy mãi không ngừng
Comment: 0,0:19:23.96,0:19:29.67,Vietsub,,0,0,0,karaoke,Cuối cùng mọi tâm tư đều sẽ bị nắm bắt
Comment: 0,0:19:30.44,0:19:33.14,Vietsub,,0,0,0,karaoke,Nắm chặt sợi dây thần trên cầu treo
Comment: 0,0:19:33.14,0:19:38.32,Vietsub,,0,0,0,karaoke,Cuối cùng lần này tình yêu không còn bị nỗi sợ nhấn chìm
Comment: 0,0:19:39.60,0:19:41.20,Vietsub,,0,0,0,karaoke,Nắm tay nhau rồi lại tách ra
Comment: 0,0:19:41.32,0:19:45.68,Vietsub,,0,0,0,karaoke,Từ bây giờ đừng phiêu bạt nữa
Comment: 0,0:19:46.40,0:19:51.31,Vietsub,,0,0,0,karaoke,Nếu như đã bay qua tất cả những thăng trầm
Comment: 0,0:19:51.84,0:19:55.12,Vietsub,,0,0,0,karaoke,Vượt qua những cố chấp trong nhiều năm
Comment: 0,0:19:55.24,0:19:58.40,Vietsub,,0,0,0,karaoke,Hai con tim cùng chung một nhịp đập,
Comment: 0,0:19:58.52,0:20:04.43,Vietsub,,0,0,0,karaoke,khiến tôi dùng lời ca viết nên ca khúc này
Comment: 0,0:20:05.00,0:20:08.27,Vietsub,,0,0,0,karaoke,Lời hẹn ước không cần phải nói rõ ràng
Comment: 0,0:20:08.27,0:20:11.21,Vietsub,,0,0,0,karaoke,Đem quãng đời còn lại trau chuốt thật kĩ càng
Comment: 0,0:20:11.21,0:20:16.48,Vietsub,,0,0,0,karaoke,Tôi nói mọi thứ đều có thể có kết quả tốt
